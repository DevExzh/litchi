<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    office:mimetype="application/vnd.oasis.opendocument.spreadsheet"
    office:version="1.3">
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Shapes">
        <table:shapes>
          <draw:frame draw:name="Photo" svg:x="9cm" svg:y="1cm" svg:width="2cm" svg:height="1cm" table:end-cell-address="Shapes.F2">
            <draw:image xlink:href="Pictures/logo.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/>
          </draw:frame>
          <draw:rect draw:name="Callout" draw:style-name="gr1" draw:z-index="2" svg:x="1cm" svg:y="1cm" svg:width="4cm" svg:height="2cm" table:end-cell-address="Shapes.C4" table:end-x="0.4cm" table:end-y="0.2cm" table:table-background="false" draw:corner-radius="0.15cm">
            <text:p>Quarterly totals</text:p>
          </draw:rect>
          <draw:line draw:name="Divider" svg:x1="0.5cm" svg:y1="4cm" svg:x2="8cm" svg:y2="4cm" table:end-cell-address="Shapes.E6"/>
          <draw:custom-shape draw:name="Star" svg:x="5cm" svg:y="1cm" svg:width="2cm" svg:height="2cm" table:end-cell-address="Shapes.D3">
            <text:p>Go</text:p>
            <draw:enhanced-geometry draw:type="star5" svg:viewBox="0 0 21600 21600" draw:enhanced-path="M 10800 0 L 21600 21600 0 21600 Z N" draw:text-areas="0 0 21600 21600">
              <draw:equation draw:name="f0" draw:formula="$0 *2"/>
              <draw:handle draw:handle-position="$0 10800" draw:handle-range-x-minimum="0" draw:handle-range-x-maximum="10800"/>
            </draw:enhanced-geometry>
          </draw:custom-shape>
          <draw:g draw:name="Cluster">
            <draw:polyline draw:name="Trend" svg:width="3cm" svg:height="2cm" svg:viewBox="0 0 3000 2000" draw:points="0,2000 1000,500 2000,1500 3000,0"/>
            <draw:polygon draw:name="Wedge" svg:width="2cm" svg:height="2cm" svg:viewBox="0 0 2000 2000" draw:points="0,2000 1000,0 2000,2000"/>
          </draw:g>
          <draw:connector draw:name="Link" draw:type="line" svg:x1="1cm" svg:y1="6cm" svg:x2="6cm" svg:y2="8cm"/>
          <draw:frame draw:name="Note" svg:x="2cm" svg:y="9cm" svg:width="5cm" svg:height="1.5cm" table:end-cell-address="Shapes.B12" table:end-x="1cm" table:end-y="0.5cm">
            <draw:text-box>
              <text:p>Review before publishing</text:p>
            </draw:text-box>
          </draw:frame>
        </table:shapes>
        <table:table-column/>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Region</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
