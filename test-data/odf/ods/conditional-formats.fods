<?xml version="1.0" encoding="UTF-8"?>
<!--
  LibreOffice `calcext` conditional formatting attached to a sheet, modeled on
  what LibreOffice Calc writes for Format > Conditional > Condition:

    * "Grades" carries two `calcext:conditional-format` elements. The first
      pairs two inert `calcext:condition` rules with a base cell address; the
      second targets two ranges and has one rule without a base address.
    * The referenced cell styles "Good"/"Bad" are ordinary common styles.
      Litchi stores the rules as typed inert data and never evaluates the
      conditions or resolves the style references.
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:calcext="urn:org:documentfoundation:names:experimental:calc:xmlns:calcext:1.0"
    office:mimetype="application/vnd.oasis.opendocument.spreadsheet"
    office:version="1.3">
  <office:styles>
    <style:style style:name="Good" style:family="table-cell">
      <style:text-properties fo:color="#008000"/>
    </style:style>
    <style:style style:name="Bad" style:family="table-cell">
      <style:text-properties fo:color="#ff0000"/>
    </style:style>
  </office:styles>
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Grades">
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>name</text:p></table:table-cell>
          <table:table-cell office:value-type="string"><text:p>score</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>alice</text:p></table:table-cell>
          <table:table-cell office:value-type="float" office:value="7"><text:p>7</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string"><text:p>bob</text:p></table:table-cell>
          <table:table-cell office:value-type="float" office:value="3"><text:p>3</text:p></table:table-cell>
        </table:table-row>
        <calcext:conditional-formats>
          <calcext:conditional-format calcext:target-range-address="Grades.B2:Grades.B3">
            <calcext:condition calcext:apply-style-name="Good" calcext:value="cell-content()&gt;5" calcext:base-cell-address="Grades.B2"/>
            <calcext:condition calcext:apply-style-name="Bad" calcext:value="cell-content()&lt;=5" calcext:base-cell-address="Grades.B2"/>
          </calcext:conditional-format>
          <calcext:conditional-format calcext:target-range-address="Grades.A2:Grades.A3 Grades.B1">
            <calcext:condition calcext:apply-style-name="Bad" calcext:value="cell-content()==&quot;&quot;"/>
          </calcext:conditional-format>
        </calcext:conditional-formats>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
