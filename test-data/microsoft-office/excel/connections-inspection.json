  "mismatches_and_boundaries": [
    {
      "scope": "XLSX Power Query queryTable ownership",
      "formats": [
        "xlsx",
        "xlsb"
      ],
      "raw_observation": "The native query sheet owns a table relationship; the table owns queryTable1 through xl/tables/_rels/table1.xml.rels. Sheet1 owns queryTable2 directly.",
      "reader_observation": "litchi-xlsx Worksheet::query_tables returns a successful empty vector for native-query-010 while Worksheet::tables returns the QueryTable table. The XLSB reader exposes the structured table but no public query_tables API.",
      "classification": "successful empty result caused by relationship traversal scope; preserve the indirect table-to-queryTable edge and do not treat it as absent source data"
    },
    {
      "scope": "XLSB text connection projection",
      "formats": [
        "xlsb"
      ],
      "raw_observation": "connections.bin contains BrtBeginTextPr and text-wizard field records with the absolute CSV path and import flags.",
      "reader_observation": "litchi_xlsb::host::connections::parse skips unhandled child record kinds; the typed Text connection reports files=None and properties=None, while the OleDb Power Query connection is fully projected.",
      "classification": "typed reader boundary; raw records are the evidence for the legacy source path and delimiter fields"
    },
    {
      "scope": "legacy XLS native query worksheet",
      "formats": [
        "xls"
      ],
      "raw_observation": "BIFF8 contains two BOUNDSHEET records and a native-query-010 worksheet substream with Qsi/DbQuery/OleDbConn/ExtString records.",
      "reader_observation": "Workbook metadata sees both sheets, but parse_workbook suppresses the native worksheet parse error; the public workbook publishes only Sheet1 and the direct APIs return WorksheetNotFound for the native sheet.",
      "classification": "errorsuppression; the original parse trigger is unknown, so the missing worksheet must not be recorded as a successful empty result"
    },
    {
      "scope": "legacy text encoding representation",
      "formats": [
        "xls",
        "xlsx"
      ],
      "raw_observation": "The native Text import dialog showed Macintosh encoding. XLSX stores codePage=10000, while the BIFF8 TxtQry flags are decoded by the current typed reader as WindowsAnsi/new_codepage=1.",
      "reader_observation": "The source is ASCII and all values match, so this representation mismatch does not alter the fixture values.",
      "classification": "UI-vs-wire/typed projection discrepancy; retain both observations and do not infer a data corruption issue"
    },
    {
      "scope": "Power Query DataMashup payload",
      "formats": [
        "xlsx",
        "xlsb",
        "xls"
      ],
      "raw_observation": "The same 11,106-byte DataMashup payload is retained in customXml/item1.xml for XLSX/XLSB and the MsoDataStore Item stream for XLS.",
      "reader_observation": "The XLS custom XML store is typed enough to report one DataMashup item; the query definition itself remains opaque to these direct probes.",
      "classification": "raw payload preservation; do not call an opaque DataMashup a successful empty query definition"
    },
    {
      "scope": "absolute source paths and UI feature scope",
      "formats": [
        "xlsx",
        "xlsb",
        "xls"
      ],
      "raw_observation": "The package and BIFF records contain the machine-specific absolute CSV source path; Developer and Tools menu checks were narrow UI probes.",
      "reader_observation": "Path portability and feature absence outside those menus were not established by this audit.",
      "classification": "corpus metadata lock and probe-scope limit; preserve the exact path/hash while avoiding global feature claims"
    }
  ],
