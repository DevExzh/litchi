  "conversion_comparison": {
    "docx_to_doc": {
      "source_chain": "Native Word DOCX Save As DOC; DOC was then closed and reopened in Word.",
      "native_visual_result": "Word reopened the legacy document without repair and displayed the two pictures, rounded rectangle, worksheet, and doughnut chart.",
      "representation_change": [
        "OPC relationships and DrawingML chart/picture parts become CFB WordDocument/Data streams and ObjectPool OLE/picture objects.",
        "The worksheet and chart are separate legacy ObjectPool storages with Excel.Sheet.12 and Excel.Chart.8 classes.",
        "The DOC binary does not contain the DOCX inline/floating alt-text strings as raw ASCII; this is a measured binary difference, but it is not by itself a proof that Word's legacy object metadata is semantically absent."
      ],
      "library_observation": "The DOC reader returns text/control projections and EMBED object classes; it does not expose the DOCX anchor, alt-text, chart-cache, or worksheet-package semantics."
    },
    "docx_to_rtf": {
      "source_chain": "Native Word DOCX Save As RTF from the reopened DOCX; no DOC-to-RTF conversion was used.",
      "native_visual_result": "Word reopened the RTF without repair and displayed the two pictures, rounded rectangle, worksheet, and doughnut chart with the same visible callouts.",
      "representation_change": [
        "Structured DrawingML/VML and OLE content becomes RTF picture controls plus two hex-encoded binary OLE objdata groups.",
        "The RTF retains the two supplied picture alt-text strings as raw metadata text and repeats the shape text in its shape/fallback groups.",
        "The RTF has no chart control or field control groups in the raw scan; chart and worksheet semantics are carried by the native OLE objects and picture fallbacks instead."
      ],
      "library_observation": "The RTF reader rejects the file before semantic projection with MalformedDocument(\"RTF data-store payload cannot be empty\"), while macOS textutil extracts only the page markers and object boundaries."
    }
  },
