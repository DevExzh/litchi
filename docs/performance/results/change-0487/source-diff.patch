+    impl OneByteReplayProvider {
+        fn new(bytes: Vec<u8>) -> (Self, Arc<AtomicUsize>) {
+            let reads = Arc::new(AtomicUsize::new(0));
+            (
+                Self {
+                    bytes,
+                    reads: Arc::clone(&reads),
+                },
+                reads,
+            )
