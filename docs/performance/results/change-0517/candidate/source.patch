+    fn topology_source_xml_addition_rechecks_source_version_after_initial_validation() {
+        const SOURCE_XML: &[u8] = b"<source><nested/></source>";
+        let source = Arc::new(ChangeOnHitVersionSource::new(archive_bytes(
