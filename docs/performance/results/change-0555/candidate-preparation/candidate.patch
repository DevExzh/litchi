+    #[test]
+    fn pending_accounting_matches_original_layout_oracle_for_prefix_claims() {
+        let cases = [
+            (
+                "all-free",
+                vec![PhysicalSectorRole::Unclaimed; 3],
+                vec![FREESECT, FREESECT, FREESECT],
+                &[][..],
+            ),
+            (
+                "marker-before-missing",
+                vec![PhysicalSectorRole::Unclaimed; 4],
+                vec![ENDOFCHAIN, FREESECT],
+                &[][..],
+            ),
+            (
+                "missing-without-marker",
+                vec![PhysicalSectorRole::Unclaimed; 4],
+                vec![FREESECT, FREESECT],
+                &[][..],
+            ),
+            (
+                "padding-is-ignored",
+                vec![PhysicalSectorRole::Fat, PhysicalSectorRole::Unclaimed],
+                vec![FATSECT, FREESECT, ENDOFCHAIN, MAXREGSECT],
+                &[][..],
+            ),
+            (
+                "preclaims-and-later-claim",
+                vec![
+                    PhysicalSectorRole::Fat,
+                    PhysicalSectorRole::Difat,
+                    PhysicalSectorRole::Unclaimed,
+                    PhysicalSectorRole::Unclaimed,
+                ],
+                vec![FATSECT, DIFSECT, 7, FREESECT],
+                &[(2, PhysicalSectorRole::RegularStream)][..],
+            ),
+            (
+                "all-markers-consumed-out-of-order",
+                vec![PhysicalSectorRole::Unclaimed; 3],
+                vec![FREESECT, 7, 9],
+                &[
+                    (2, PhysicalSectorRole::RegularStream),
+                    (1, PhysicalSectorRole::Directory),
+                ][..],
+            ),
+            (
+                "marker-remains-after-later-claim",
+                vec![PhysicalSectorRole::Unclaimed; 3],
+                vec![FREESECT, 7, 9],
+                &[(2, PhysicalSectorRole::RegularStream)][..],
+            ),
+        ];
+
+        for (case, initial_roles, markers, claims) in cases {
+            let mut file = synthetic_fat_file(markers.clone(), Vec::new());
+            file.sector_roles = initial_roles.clone();
+            let mut decoded_fat = Vec::with_capacity(markers.len());
+            for marker in markers.iter().copied() {
+                file.record_decoded_fat_entry(&mut decoded_fat, marker);
+            }
+            file.fat = decoded_fat;
+
+            let mut oracle_roles = initial_roles;
+            for &(sector, role) in claims {
+                file.claim_sector(sector as u32, role).unwrap();
+                assert_eq!(
+                    oracle_roles[sector],
+                    PhysicalSectorRole::Unclaimed,
+                    "{case}"
+                );
+                oracle_roles[sector] = role;
+            }
+
+            let expected = baseline_physical_layout_error(&oracle_roles, &markers);
+            let actual = file
+                .validate_physical_sector_layout()
+                .map_err(|error| match error {
+                    OleError::CorruptedFile(message) => message,
+                    other => panic!("{case}: unexpected error {other:?}"),
+                });
+            assert_eq!(actual.err(), expected, "{case}");
+        }
+    }
