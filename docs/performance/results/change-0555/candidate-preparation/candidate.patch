+    fn baseline_physical_layout_error(roles: &[PhysicalSectorRole], fat: &[u32]) -> Option<String> {
+        for (sector, role) in roles.iter().enumerate() {
+            let Some(entry) = fat.get(sector).copied() else {
+                return Some(format!(
+                    "FAT does not contain an entry for physical sector {sector}"
+                ));
+            };
+            if *role == PhysicalSectorRole::Unclaimed && entry != FREESECT {
+                return Some(format!(
+                    "unclaimed physical sector {sector} has FAT marker 0x{entry:08X}"
+                ));
+            }
+        }
+        None
+    }
