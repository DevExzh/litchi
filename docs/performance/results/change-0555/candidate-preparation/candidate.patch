+    #[test]
+    fn pending_claim_is_consumed_without_shifting_conflict_errors() {
+        let mut file = synthetic_fat_file(vec![ENDOFCHAIN, 7, 9, FREESECT], Vec::new());
+        file.sector_roles = vec![
+            PhysicalSectorRole::Pending,
+            PhysicalSectorRole::Pending,
+            PhysicalSectorRole::Pending,
+            PhysicalSectorRole::Unclaimed,
+        ];
+
+        assert!(matches!(
+            file.claim_sector(3, PhysicalSectorRole::Directory),
+            Ok(())
+        ));
+        assert!(matches!(
+            file.claim_sector(2, PhysicalSectorRole::RegularStream),
+            Ok(())
+        ));
+        let roles_before = file.sector_roles.clone();
+        assert!(matches!(
+            file.claim_sector(3, PhysicalSectorRole::Fat),
+            Err(OleError::CorruptedFile(message)) if message == "Sector 3 is claimed by both directory and FAT"
+        ));
+        assert_eq!(file.sector_roles, roles_before);
+
+        assert!(matches!(
+            file.claim_sector(0, PhysicalSectorRole::Directory),
+            Ok(())
+        ));
+        assert!(matches!(
+            file.claim_sector(1, PhysicalSectorRole::MiniFat),
+            Ok(())
+        ));
+        assert!(file.validate_physical_sector_layout().is_ok());
+
+        let mut still_pending = synthetic_fat_file(vec![ENDOFCHAIN], Vec::new());
+        still_pending.sector_roles = vec![PhysicalSectorRole::Pending];
+        assert!(matches!(
+            still_pending.claim_sector(0, PhysicalSectorRole::Unclaimed),
+            Ok(())
+        ));
+        assert_eq!(still_pending.sector_roles, [PhysicalSectorRole::Pending]);
+        assert!(matches!(
+            still_pending.validate_physical_sector_layout(),
+            Err(OleError::CorruptedFile(message))
+                if message == "unclaimed physical sector 0 has FAT marker 0xFFFFFFFE"
+        ));
+    }
