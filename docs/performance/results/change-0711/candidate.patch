+#[cfg(test)]
+mod borrowing_tests {
+    use super::{
+        STRICT_RELATIONSHIP_NAMESPACE, STRICT_WORD_NAMESPACE, TRANSITIONAL_RELATIONSHIP_NAMESPACE,
+        TRANSITIONAL_WORD_NAMESPACE, scan,
+    };
+
+    #[test]
+    fn restored_prefix_scope_and_owned_chunk_values_survive_later_events() {
+        for (word, relationships) in [
+            (
+                TRANSITIONAL_WORD_NAMESPACE,
+                TRANSITIONAL_RELATIONSHIP_NAMESPACE,
+            ),
+            (STRICT_WORD_NAMESPACE, STRICT_RELATIONSHIP_NAMESPACE),
+        ] {
+            let xml = format!(
+                r#"<w:document xmlns:w="{word}" xmlns:r="{relationships}" xmlns:f="urn:foreign"><w:body><f:item xmlns:w="urn:shadow"/><w:altChunk r:id="after-empty"/><f:item xmlns:w="urn:shadow"><w:altChunk r:id="ignored"/></f:item><w:altChunk r:id="after-end"><w:altChunkPr><w:matchSrc w:val="0"/></w:altChunkPr></w:altChunk></w:body></w:document>"#
+            );
+            let chunks = scan(xml.as_bytes()).expect("scan restored prefix scope");
+            let actual = chunks
+                .iter()
+                .map(|(offset, chunk)| {
+                    (*offset, chunk.relationship().as_str(), chunk.match_source())
+                })
+                .collect::<Vec<_>>();
+            let offset = |id: &str| {
+                u32::try_from(xml.find(&format!(r#"<w:altChunk r:id="{id}""#)).unwrap()).unwrap()
+            };
+            assert_eq!(
+                actual,
+                vec![
+                    (offset("after-empty"), "after-empty", None),
+                    (offset("after-end"), "after-end", Some(false)),
+                ]
+            );
+        }
+    }
+
+    #[test]
+    fn default_namespace_scope_is_restored_after_empty_and_end() {
+        for (word, relationships) in [
+            (
+                TRANSITIONAL_WORD_NAMESPACE,
+                TRANSITIONAL_RELATIONSHIP_NAMESPACE,
+            ),
+            (STRICT_WORD_NAMESPACE, STRICT_RELATIONSHIP_NAMESPACE),
+        ] {
+            let xml = format!(
+                r#"<document xmlns="{word}" xmlns:r="{relationships}"><body><foreign xmlns="urn:shadow"/><altChunk r:id="after-empty"/><foreign xmlns="urn:shadow"><altChunk r:id="ignored"/></foreign><altChunk r:id="after-end"/></body></document>"#
+            );
+            let chunks = scan(xml.as_bytes()).expect("scan restored default scope");
+            assert_eq!(
+                chunks
+                    .values()
+                    .map(|chunk| chunk.relationship().as_str())
+                    .collect::<Vec<_>>(),
+                vec!["after-empty", "after-end"]
+            );
+        }
+    }
+}
