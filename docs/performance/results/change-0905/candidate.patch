+/// A bounded result of the complete first pass over one tag's attributes.
+///
+/// The raw key comparison deliberately matches `inspect_attributes`; the
+/// summary is not an XML namespace or decoded-value classification.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum AttributeSummary {
+    Zero,
+    One { xml_space: bool },
+    Many,
+}
+
+impl AttributeSummary {
+    fn observe(&mut self, name: &[u8]) {
+        *self = match *self {
+            Self::Zero => Self::One {
+                xml_space: name == b"xml:space",
+            },
+            Self::One { .. } | Self::Many => Self::Many,
+        };
+    }
+}
