+pub(crate) fn parse_source_with_observer<'a, F, O>(
+    content: &[u8],
+    strings: F,
+    observer: O,
+) -> SourceParseAttempt
+where
+    F: FnOnce() -> Result<Option<&'a [Text]>>,
+    O: for<'event> FnMut(&ResolveResult<'event>, &Event<'event>) -> bool,
