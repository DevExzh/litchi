+#[derive(Debug, Eq, PartialEq)]
+enum DirectEventCount {
+    Complete(usize),
+    ReaderError(usize),
+}
+
+impl DirectEventCount {
+    fn emitted(&self) -> usize {
+        match self {
+            Self::Complete(count) | Self::ReaderError(count) => *count,
+        }
+    }
