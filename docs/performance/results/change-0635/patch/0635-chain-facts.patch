+/// Publish rewritten worksheet bytes together with the facts captured while
+/// the same bytes were validated.
+///
+/// Change 0622 cleared the facts on every rebinding constructor, so only the
+/// first commit of a snapshot chain could use them. The facts index into the
+/// `Vec`'s heap buffer, and moving that `Vec` into an `Arc` does not move the
+/// buffer, so the retained spans still describe the published slice. That is
+/// checked rather than assumed: `describes` compares the address and length
+/// the builder recorded against the slice actually published, and any
+/// disagreement drops the facts, which costs the next commit nothing but its
+/// established complete scan.
+fn rebound_worksheet(
+    bytes: Vec<u8>,
+    facts: Option<raw::worksheet::SourceFacts>,
+) -> (SourcePayload, Option<Arc<raw::worksheet::SourceFacts>>) {
+    let bytes = Arc::new(bytes);
+    let facts = facts
+        .filter(|facts| facts.describes(bytes.as_slice()))
+        .map(Arc::new);
+    (SourcePayload::Owned(bytes), facts)
+}
