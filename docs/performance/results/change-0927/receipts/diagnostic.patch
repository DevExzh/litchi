+        output_verified: bool,
+    }
+
+    fn docx_read_diagnostic_snapshot(
+        range_source: &super::PptxRangeSource,
+        provider_counter: &super::DocxProviderReadCounter,
+    ) -> Result<DocxReadDiagnosticSnapshot, Box<dyn Error>> {
+        let logical = super::DocxProviderReadObservation::from_range(range_source.snapshot()?);
+        let underlying = provider_counter.snapshot();
+        Ok(DocxReadDiagnosticSnapshot {
+            logical: DocxReadDiagnosticTotals::from_observation(&logical),
+            underlying: DocxReadDiagnosticTotals::from_observation(&underlying),
+        })
+    }
+
+    fn docx_read_diagnostic_phase(
+        phase: &'static str,
+        before: DocxReadDiagnosticSnapshot,
+        after: DocxReadDiagnosticSnapshot,
+    ) -> Result<DocxReadDiagnosticPhase, Box<dyn Error>> {
+        Ok(DocxReadDiagnosticPhase {
+            phase,
+            logical_cumulative: after.logical,
+            logical_delta: after.logical.delta(before.logical)?,
+            underlying_cumulative: after.underlying,
+            underlying_delta: after.underlying.delta(before.underlying)?,
+        })
+    }
