+    fn run_docx_section_layout_read_diagnostic_route(
+        corpus: &super::Corpus,
+        route: (&'static str, usize),
+        expected_output: &[u8],
+    ) -> Result<DocxReadDiagnosticRoute, Box<dyn Error>> {
+        let source_bytes = u64::try_from(corpus.archive.len())?;
+        let source_sha256 = sha256_hex(&corpus.archive);
+        if source_sha256 != corpus.manifest.archive_sha256 {
+            return Err("DOCX section-layout diagnostic source hash differs from manifest".into());
+        }
+        let provider_counter = Arc::new(super::DocxProviderReadCounter::new(Arc::new(
+            OwnedSource::new(corpus.archive.clone()),
+        )));
+        let range_source = Arc::new(super::PptxRangeSource::new(
+            provider_counter.clone(),
+            super::PptxRangeSourceConfig::new(Some(route.1), None),
+        ));
+        let provider_version_before = range_source.version()?;
+        let package = litchi_docx::source_backed::Package::from_read_at(range_source.clone())?;
+
+        let mut snapshots = Vec::with_capacity(5);
+        snapshots.push(("open", {
+            std::hint::black_box(&package);
+            docx_read_diagnostic_snapshot(&range_source, &provider_counter)?
+        }));
+
+        let snapshot = package.section_layout_snapshot()?;
+        snapshots.push((
+            "query",
+            docx_read_diagnostic_snapshot(&range_source, &provider_counter)?,
+        ));
+
+        let mut edit = snapshot.edit(litchi_docx::section::Selector::paragraph(Position::new(
+            super::DOCX_SECTION_LAYOUT_SECTION_POSITIONS[0],
+        )))?;
+        edit.set_columns(Some(litchi_docx::section::Columns {
+            equal_width: true,
+            count: 3,
+            space: Some(litchi_docx::section::Emu::from_twips(240)),
+            separator: true,
+            columns: Vec::new(),
+        }))?;
+        snapshots.push((
+            "edit",
+            docx_read_diagnostic_snapshot(&range_source, &provider_counter)?,
+        ));
+
+        let commit = edit.commit()?;
+        snapshots.push((
+            "commit",
+            docx_read_diagnostic_snapshot(&range_source, &provider_counter)?,
+        ));
+
+        let maximum = u64::try_from(expected_output.len())?
+            .checked_mul(2)
+            .and_then(|value| value.checked_add(64 * 1024))
+            .ok_or("DOCX section-layout diagnostic output ceiling overflows u64")?;
+        let mut sink = super::CountingSink::bounded(maximum, 64 * 1024);
+        sink.reserve_budget()?;
+        let publication = package.publish_section_layout_commit_to_stream(&mut sink, &commit)?;
+        let publication_snapshot = docx_read_diagnostic_snapshot(&range_source, &provider_counter)?;
+        snapshots.push(("publication", publication_snapshot));
+        let provider_version_at_publication = range_source.version()?;
+
+        if sink.bytes != expected_output {
+            return Err("DOCX section-layout diagnostic output differs from oracle".into());
+        }
+        super::verify_docx_section_layout_output(corpus, &sink.bytes, [3, 2, 2])?;
+        let reopened = litchi_docx::source_backed::Package::from_read_at(Arc::new(
+            OwnedSource::new(sink.bytes.clone()),
+        ))?;
+        let mut restored_output = Vec::new();
+        reopened.publish_section_layout_inverse_to_stream(&mut restored_output, &publication)?;
+        let inverse_source_restored = restored_output == corpus.archive;
+        if !inverse_source_restored {
+            return Err("DOCX section-layout diagnostic inverse did not restore source".into());
+        }
+        let provider_version_after_check = range_source.version()?;
+        let source_version_stable = provider_version_before == provider_version_at_publication
+            && provider_version_at_publication == provider_version_after_check;
+        if !source_version_stable {
+            return Err("DOCX section-layout diagnostic source version changed".into());
+        }
+
+        let mut phases = Vec::with_capacity(snapshots.len());
+        let mut previous = DocxReadDiagnosticSnapshot {
+            logical: DocxReadDiagnosticTotals::default(),
+            underlying: DocxReadDiagnosticTotals::default(),
+        };
+        for (phase, current) in snapshots {
+            phases.push(docx_read_diagnostic_phase(phase, previous, current)?);
+            previous = current;
+        }
+        let logical_operation = publication_snapshot.logical;
+        let underlying_operation = publication_snapshot.underlying;
+        let mut logical_sum = DocxReadDiagnosticTotals::default();
+        let mut underlying_sum = DocxReadDiagnosticTotals::default();
+        for phase in &phases {
+            logical_sum = logical_sum.checked_add(phase.logical_delta)?;
+            underlying_sum = underlying_sum.checked_add(phase.underlying_delta)?;
+        }
+        let logical_operation_conservation_verified = logical_sum == logical_operation;
+        let underlying_operation_conservation_verified = underlying_sum == underlying_operation;
+        if !logical_operation_conservation_verified || !underlying_operation_conservation_verified {
+            return Err(
+                "DOCX section-layout diagnostic phase reads do not conserve operation totals"
+                    .into(),
+            );
+        }
+        let two_fingerprint_lower_bound_bytes = source_bytes
+            .checked_mul(2)
+            .ok_or("DOCX section-layout fingerprint lower bound overflowed")?;
+        let logical_bytes_after_two_fingerprint_lower_bound = logical_operation
+            .returned_bytes
+            .checked_sub(two_fingerprint_lower_bound_bytes)
+            .ok_or("logical provider bytes are below two-fingerprint lower bound")?;
+        let underlying_bytes_after_two_fingerprint_lower_bound = underlying_operation
+            .returned_bytes
+            .checked_sub(two_fingerprint_lower_bound_bytes)
+            .ok_or("underlying provider bytes are below two-fingerprint lower bound")?;
+        let sink_summary = sink.summary();
+        Ok(DocxReadDiagnosticRoute {
+            route: route.0,
+            max_returned_bytes: route.1,
+            source_bytes,
+            phases,
+            logical_operation,
+            underlying_operation,
+            two_fingerprint_lower_bound_bytes,
+            logical_bytes_after_two_fingerprint_lower_bound,
+            underlying_bytes_after_two_fingerprint_lower_bound,
+            logical_operation_conservation_verified,
+            underlying_operation_conservation_verified,
+            source_sha256,
+            output_sha256: sha256_hex(&sink.bytes),
+            source_version_stable,
+            inverse_source_restored,
+            sink_accepted_bytes: sink_summary.accepted_bytes,
+            sink_largest_write: sink_summary.largest_write,
+            output_verified: true,
+        })
+    }
