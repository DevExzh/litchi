+    #[test]
+    fn docx_section_layout_read_diagnostic_conserves_full_and_short_phases() {
+        let corpus = build_docx_section_layout_corpus().unwrap();
+        let expected_output = expected_docx_section_layout_diagnostic_output(&corpus).unwrap();
+        let full = run_docx_section_layout_read_diagnostic_route(
+            &corpus,
+            ("full_64k_unpaced", 64 * 1024),
+            &expected_output,
+        )
+        .unwrap();
+        let short = run_docx_section_layout_read_diagnostic_route(
+            &corpus,
+            ("short_4k_unpaced", 4 * 1024),
+            &expected_output,
+        )
+        .unwrap();
+
+        let expected_source_bytes = u64::try_from(corpus.archive.len()).unwrap();
+        let expected_operation_bytes = 6_308_061;
+        let expected_two_fingerprint_bytes = 4_202_854;
+        let expected_source_sha256 =
+            "183204a832a3518bf1d4474e9b7ff347ad7d0dc95ad2e9b1dbdde405837a29e8";
+        let expected_output_sha256 =
+            "5e87e9ca9fd6b9a98933c36d9aee1e848bc97eb7693229f7949514830121c4ec";
+        assert_eq!(expected_source_bytes, 2_101_427);
+        assert_eq!(full.source_bytes, expected_source_bytes);
+        assert_eq!(short.source_bytes, expected_source_bytes);
+        assert_eq!(full.logical_operation.read_calls, 165);
+        assert_eq!(
+            full.logical_operation.requested_bytes,
+            expected_operation_bytes
+        );
+        assert_eq!(
+            full.logical_operation.returned_bytes,
+            expected_operation_bytes
+        );
+        assert_eq!(full.underlying_operation, full.logical_operation);
+        assert_eq!(short.logical_operation.read_calls, 1_607);
+        assert_eq!(short.logical_operation.requested_bytes, 84_096_471);
+        assert_eq!(
+            short.logical_operation.returned_bytes,
+            expected_operation_bytes
+        );
+        assert_eq!(short.underlying_operation.read_calls, 1_607);
+        assert_eq!(
+            short.underlying_operation.requested_bytes,
+            expected_operation_bytes
+        );
+        assert_eq!(
+            short.underlying_operation.returned_bytes,
+            expected_operation_bytes
+        );
+        for report in [&full, &short] {
+            assert_eq!(
+                report.two_fingerprint_lower_bound_bytes,
+                expected_two_fingerprint_bytes
+            );
+            assert_eq!(
+                report.logical_bytes_after_two_fingerprint_lower_bound,
+                expected_operation_bytes - expected_two_fingerprint_bytes
+            );
+            assert_eq!(
+                report.underlying_bytes_after_two_fingerprint_lower_bound,
+                expected_operation_bytes - expected_two_fingerprint_bytes
+            );
+            assert!(report.logical_operation_conservation_verified);
+            assert!(report.underlying_operation_conservation_verified);
+            assert_eq!(report.source_sha256, expected_source_sha256);
+            assert_eq!(report.output_sha256, expected_output_sha256);
+            assert!(report.source_version_stable);
+            assert!(report.inverse_source_restored);
+            assert_eq!(report.sink_accepted_bytes, expected_output.len() as u64);
+            assert!(report.sink_largest_write <= 64 * 1024);
+            assert!(report.output_verified);
+            assert_eq!(report.output_sha256, sha256_hex(&expected_output));
+            assert_eq!(report.phases.len(), 5);
+            assert_eq!(report.phases[0].phase, "open");
+            assert_eq!(report.phases[1].phase, "query");
+            assert_eq!(report.phases[2].phase, "edit");
+            assert_eq!(report.phases[3].phase, "commit");
+            assert_eq!(report.phases[4].phase, "publication");
+        }
+
+        println!(
+            "DOCX_SECTION_LAYOUT_READ_DIAGNOSTIC_JSON={}",
+            serde_json::to_string(&[full, short]).unwrap()
+        );
+    }
