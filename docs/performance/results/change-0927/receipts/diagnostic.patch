+    #[derive(Clone, Copy, Debug, Default, Eq, PartialEq, serde::Serialize)]
+    struct DocxReadDiagnosticTotals {
+        read_calls: u64,
+        requested_bytes: u64,
+        returned_bytes: u64,
+        short_reads: u64,
+    }
+
+    impl DocxReadDiagnosticTotals {
+        fn from_observation(observation: &DocxProviderReadObservation) -> Self {
+            Self {
+                read_calls: observation.read_calls,
+                requested_bytes: observation.requested_bytes,
+                returned_bytes: observation.returned_bytes,
+                short_reads: observation.short_reads,
+            }
+        }
+
+        fn delta(self, before: Self) -> Result<Self, Box<dyn Error>> {
+            Ok(Self {
+                read_calls: self
+                    .read_calls
+                    .checked_sub(before.read_calls)
+                    .ok_or("diagnostic provider read-call counter regressed")?,
+                requested_bytes: self
+                    .requested_bytes
+                    .checked_sub(before.requested_bytes)
+                    .ok_or("diagnostic provider requested-byte counter regressed")?,
+                returned_bytes: self
+                    .returned_bytes
+                    .checked_sub(before.returned_bytes)
+                    .ok_or("diagnostic provider returned-byte counter regressed")?,
+                short_reads: self
+                    .short_reads
+                    .checked_sub(before.short_reads)
+                    .ok_or("diagnostic provider short-read counter regressed")?,
+            })
+        }
+
+        fn checked_add(self, other: Self) -> Result<Self, Box<dyn Error>> {
+            Ok(Self {
+                read_calls: self
+                    .read_calls
+                    .checked_add(other.read_calls)
+                    .ok_or("diagnostic provider read-call sum overflowed")?,
+                requested_bytes: self
+                    .requested_bytes
+                    .checked_add(other.requested_bytes)
+                    .ok_or("diagnostic provider requested-byte sum overflowed")?,
+                returned_bytes: self
+                    .returned_bytes
+                    .checked_add(other.returned_bytes)
+                    .ok_or("diagnostic provider returned-byte sum overflowed")?,
+                short_reads: self
+                    .short_reads
+                    .checked_add(other.short_reads)
+                    .ok_or("diagnostic provider short-read sum overflowed")?,
+            })
+        }
+    }
+
+    #[derive(Clone, Copy, Debug, serde::Serialize)]
+    struct DocxReadDiagnosticSnapshot {
+        logical: DocxReadDiagnosticTotals,
+        underlying: DocxReadDiagnosticTotals,
+    }
+
+    #[derive(Clone, Debug, serde::Serialize)]
+    struct DocxReadDiagnosticPhase {
+        phase: &'static str,
+        logical_cumulative: DocxReadDiagnosticTotals,
+        logical_delta: DocxReadDiagnosticTotals,
+        underlying_cumulative: DocxReadDiagnosticTotals,
+        underlying_delta: DocxReadDiagnosticTotals,
+    }
+
+    #[derive(Clone, Debug, serde::Serialize)]
+    struct DocxReadDiagnosticRoute {
+        route: &'static str,
+        max_returned_bytes: usize,
+        source_bytes: u64,
+        phases: Vec<DocxReadDiagnosticPhase>,
+        logical_operation: DocxReadDiagnosticTotals,
+        underlying_operation: DocxReadDiagnosticTotals,
+        two_fingerprint_lower_bound_bytes: u64,
+        logical_bytes_after_two_fingerprint_lower_bound: u64,
+        underlying_bytes_after_two_fingerprint_lower_bound: u64,
+        logical_operation_conservation_verified: bool,
