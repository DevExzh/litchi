+/// PROBE BUILD ONLY (change 0655): per-fingerprint memo accounting. This
+/// instrumentation is reverted before any timed binary is built; the timed
+/// binaries' sha256s are recorded in the evidence packet.
+pub mod memo_stats {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static HITS: AtomicU64 = AtomicU64::new(0);
+    pub static MISSES: AtomicU64 = AtomicU64::new(0);
+    pub static HIT_BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static MISS_BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static FED_BYTES: AtomicU64 = AtomicU64::new(0);
+
+    /// Whether the probe build should report per-fingerprint statistics.
+    pub fn enabled() -> bool {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("LITCHI_0655_MEMO").is_some())
+    }
+
+    pub fn reset() {
+        for counter in [&HITS, &MISSES, &HIT_BYTES, &MISS_BYTES, &FED_BYTES] {
+            counter.store(0, Ordering::Relaxed);
+        }
+    }
+
+    pub fn read() -> (u64, u64, u64, u64) {
+        (
+            HITS.load(Ordering::Relaxed),
+            MISSES.load(Ordering::Relaxed),
+            HIT_BYTES.load(Ordering::Relaxed),
+            MISS_BYTES.load(Ordering::Relaxed),
+        )
+    }
+
+    pub fn record(hit: bool, bytes: usize) {
+        if hit {
+            HITS.fetch_add(1, Ordering::Relaxed);
+            HIT_BYTES.fetch_add(bytes as u64, Ordering::Relaxed);
+        } else {
+            MISSES.fetch_add(1, Ordering::Relaxed);
+            MISS_BYTES.fetch_add(bytes as u64, Ordering::Relaxed);
+        }
+    }
+}
