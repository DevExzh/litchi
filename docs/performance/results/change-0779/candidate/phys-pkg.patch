+fn bounded_reservation_target(current_capacity: usize, required: usize, maximum: usize) -> usize {
+    debug_assert!(current_capacity < required);
+    debug_assert!(required <= maximum);
+    let growth = (current_capacity / 8).max(READ_CHUNK_BYTES);
+    current_capacity
+        .checked_add(growth)
+        .unwrap_or(maximum)
+        .max(required)
+        .min(maximum)
