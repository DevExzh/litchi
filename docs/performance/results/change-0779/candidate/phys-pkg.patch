+    fn bounded_growth_target_caps_requested_capacity_and_retained_slack() {
+        let cases = [
+            (READ_CHUNK_BYTES, READ_CHUNK_BYTES + 1, 64 * 1024, 2 * READ_CHUNK_BYTES),
+            (8 * READ_CHUNK_BYTES, 8 * READ_CHUNK_BYTES + 1, 256 * 1024, 9 * READ_CHUNK_BYTES),
+            (16 * READ_CHUNK_BYTES, 16 * READ_CHUNK_BYTES + 1, 512 * 1024, 18 * READ_CHUNK_BYTES),
+            (200_000, 200_001, 200_500, 200_500),
+        ];
+        for (capacity, required, maximum, expected) in cases {
+            let target = bounded_reservation_target(capacity, required, maximum);
+            assert_eq!(target, expected);
+            assert!(target >= required);
+            assert!(target <= maximum);
+            assert!(target - required <= READ_CHUNK_BYTES.max(capacity / 8));
+        }
+
+        let maximum = usize::MAX - 1;
+        assert_eq!(
+            bounded_reservation_target(maximum - 1, maximum, maximum),
+            maximum
+        );
+    }
