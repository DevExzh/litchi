+    struct RecordingReader {
+        bytes: Vec<u8>,
+        offset: usize,
+        calls: Vec<usize>,
+        max_return: usize,
+        interrupted: usize,
+        fail_on_call: Option<usize>,
+        overreport: bool,
+    }
+
+    impl RecordingReader {
+        fn new(bytes: Vec<u8>) -> Self {
+            Self {
+                bytes,
+                offset: 0,
+                calls: Vec::new(),
+                max_return: usize::MAX,
+                interrupted: 0,
+                fail_on_call: None,
+                overreport: false,
+            }
+        }
+
+        fn limits(maximum: usize) -> ReadLimits {
+            ReadLimits::builder()
+                .max_input_bytes(maximum as u64)
+                .unwrap()
+                .build()
+                .unwrap()
+        }
+    }
+
+    impl Read for RecordingReader {
+        fn read(&mut self, output: &mut [u8]) -> std::io::Result<usize> {
+            self.calls.push(output.len());
+            if self.interrupted != 0 {
+                self.interrupted -= 1;
+                return Err(std::io::Error::from(std::io::ErrorKind::Interrupted));
+            }
+            if self.fail_on_call == Some(self.calls.len()) {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::Other,
+                    "late input failure",
+                ));
+            }
+            if self.overreport {
+                return Ok(output.len().saturating_add(1));
+            }
+            let available = self.bytes.len().saturating_sub(self.offset);
+            let amount = available.min(output.len()).min(self.max_return);
+            output[..amount].copy_from_slice(&self.bytes[self.offset..self.offset + amount]);
+            self.offset += amount;
+            Ok(amount)
+        }
+    }
+
