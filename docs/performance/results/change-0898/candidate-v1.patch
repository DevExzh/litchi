+
+    #[test]
+    fn an_emitted_name_span_survives_output_reallocation() {
+        // Numeric character references are normalized before the rebuilt
+        // child tags are written. Each `&#34;` therefore becomes the longer
+        // `&quot;`, forcing the append-only output past its input-sized hint
+        // while the root's closing name is still pending.
+        let mut xml = format!(r#"<r xmlns:mc="{MC}">"#);
+        let mut expected = format!(r#"<r xmlns:mc="{MC}">"#);
+        for _ in 0..64 {
+            xml.push_str(r#"<cell value="&#34;"/>"#);
+            expected.push_str(r#"<cell value="&quot;"></cell>"#);
+        }
+        xml.push_str("</r>");
+        expected.push_str("</r>");
+
+        let output = run(&xml);
+        assert_eq!(output, expected);
+        assert!(output.len() > xml.len());
+
+        let exact = Limits {
+            max_output_bytes: expected.len(),
+            ..Limits::default()
+        };
+        assert_eq!(
+            run_with(&xml, &Capabilities::new(), &exact).unwrap(),
+            expected
+        );
+        let under = Limits {
+            max_output_bytes: expected.len() - 1,
+            ..Limits::default()
+        };
+        assert!(matches!(
+            run_with(&xml, &Capabilities::new(), &under),
+            Err(Error::LimitExceeded(message)) if message == "output bytes"
+        ));
+    }
+
+    #[test]
+    fn inactive_and_opaque_modes_keep_their_exact_byte_branches() {
+        let xml = format!(
+            r#"<r xmlns:mc="{MC}" xmlns:x="urn:x" xmlns:e="urn:e" xmlns:s="urn:s" mc:Ignorable="x" mc:PreserveElements="x:keep" mc:ProcessContent="x:unwrap"><x:keep><known/></x:keep><x:unwrap><known2/></x:unwrap><x:drop><e:opaque><raw/></e:opaque></x:drop><e:opaque><raw/></e:opaque><mc:AlternateContent><mc:Choice Requires="s"><choice/></mc:Choice><mc:Fallback><fallback/></mc:Fallback></mc:AlternateContent><tail/></r>"#
+        );
+        let mut capabilities = Capabilities::new();
+        capabilities.preserve_extension_element(Name {
+            namespace: "urn:e".to_owned(),
+            local_name: "opaque".to_owned(),
+        });
+        let expected = format!(
+            r#"<r xmlns:mc="{MC}" xmlns:x="urn:x" xmlns:e="urn:e" xmlns:s="urn:s"><x:keep><known></known></x:keep><known2></known2><e:opaque><raw></raw></e:opaque><fallback></fallback><tail></tail></r>"#
+        );
+        assert_eq!(
+            run_with(&xml, &capabilities, &Limits::default()).unwrap(),
+            expected
+        );
+    }
