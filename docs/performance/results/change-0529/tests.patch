+    let zero = b"<root><child/></root>";
+    let one = br#"<root a="1"/>"#;
+    let many = br#"<root a="1" b="2" c="3"/>"#;
+    let namespaced = br#"<p:root xmlns:p="urn:test" p:value="v"/>"#;
+
