+            let text = core::str::from_utf8(xml).expect("focused XML is UTF-8");
+            let mut reader = Reader::from_str(text);
+            reader.config_mut().trim_text(false);
+            let event = reader.read_event().expect("attribute fixture event");
+            let tag = match event {
+                Event::Start(tag) | Event::Empty(tag) => tag,
+                other => panic!("expected a tag event, got {other:?}"),
+            };
+            let decoder = reader.decoder();
+            let mut probed = State::new();
+            let mut checked = State::new();
+            let result = inspect_attributes(&tag, decoder, inherited, &mut probed, limits, 0);
+            let oracle =
