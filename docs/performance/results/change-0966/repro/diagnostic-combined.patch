+/// Fixed-size counters used only by the external 0966 diagnostic build.
+///
+/// This module intentionally records aggregate shape, never source bytes,
+/// offsets, opcodes, or parsed vectors. It is enabled by the existing
+/// `performance-diagnostics` harness feature and is not part of the ordinary
+/// production build.
+#[cfg(feature = "performance-diagnostics")]
+pub mod census {
+    use super::{Error, Result, Sprm};
+    use std::cell::{Cell, RefCell};
+    use std::mem::size_of;
+
+    /// Number of fixed logarithmic input/output histogram buckets.
+    pub const HISTOGRAM_BUCKETS: usize = 10;
+
+    /// Lifecycle bucket selected by the harness before each public operation.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum Phase {
+        /// Snapshot opening and its validation.
+        SnapshotOpen,
+        /// Opening the mutable edit view from the immutable snapshot.
+        EditOpen,
+        /// One or more paragraph replacement stages.
+        StagedReplacement,
+        /// Commit and candidate reopen/validation.
+        FinalCommit,
+        /// Copying the committed output bytes.
+        OutputCopy,
+        /// Work that does not have a lifecycle phase marker.
+        Other,
+    }
+
+    /// Aggregate counters for one phase or for the complete measured scope.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Bucket {
+        pub calls: u64,
+        pub successes: u64,
+        pub errors: u64,
+        pub input_empty: u64,
+        pub input_nonempty: u64,
+        pub input_bytes_total: u64,
+        pub input_bytes_min: u64,
+        pub input_bytes_max: u64,
+        pub input_length_histogram: [u64; HISTOGRAM_BUCKETS],
+        pub output_count_total: u64,
+        pub output_count_histogram: [u64; HISTOGRAM_BUCKETS],
+        pub output_capacity_total: u64,
+        pub output_capacity_min: u64,
+        pub output_capacity_max: u64,
+        pub logical_vec_capacity_bytes: u64,
+        pub errors_by_kind: [u64; 5],
+    }
+
+    impl Bucket {
+        const fn empty() -> Self {
+            Self {
+                calls: 0,
+                successes: 0,
+                errors: 0,
+                input_empty: 0,
+                input_nonempty: 0,
+                input_bytes_total: 0,
+                input_bytes_min: 0,
+                input_bytes_max: 0,
+                input_length_histogram: [0; HISTOGRAM_BUCKETS],
+                output_count_total: 0,
+                output_count_histogram: [0; HISTOGRAM_BUCKETS],
+                output_capacity_total: 0,
+                output_capacity_min: 0,
+                output_capacity_max: 0,
+                logical_vec_capacity_bytes: 0,
+                errors_by_kind: [0; 5],
+            }
+        }
+
+        fn record(&mut self, input_len: usize, result: &Result<Vec<Sprm>>, saturated: &mut bool) {
+            add(&mut self.calls, 1, saturated);
+            let input_len = input_len as u64;
+            if input_len == 0 {
+                add(&mut self.input_empty, 1, saturated);
+            } else {
+                add(&mut self.input_nonempty, 1, saturated);
+            }
+            add(&mut self.input_bytes_total, input_len, saturated);
+            if self.calls == 1 {
+                self.input_bytes_min = input_len;
+                self.input_bytes_max = input_len;
+            } else {
+                self.input_bytes_min = self.input_bytes_min.min(input_len);
+                self.input_bytes_max = self.input_bytes_max.max(input_len);
+            }
+            add(
+                &mut self.input_length_histogram[input_bucket(input_len)],
+                1,
+                saturated,
+            );
+
+            match result {
+                Ok(output) => {
+                    add(&mut self.successes, 1, saturated);
+                    let output_count = output.len() as u64;
+                    add(&mut self.output_count_total, output_count, saturated);
+                    add(
+                        &mut self.output_count_histogram[output_bucket(output_count)],
+                        1,
+                        saturated,
+                    );
+                    let capacity = output.capacity() as u64;
+                    add(&mut self.output_capacity_total, capacity, saturated);
+                    add(
+                        &mut self.logical_vec_capacity_bytes,
+                        capacity.saturating_mul(size_of::<Sprm>() as u64),
+                        saturated,
+                    );
+                    if self.successes == 1 {
+                        self.output_capacity_min = capacity;
+                        self.output_capacity_max = capacity;
+                    } else {
+                        self.output_capacity_min = self.output_capacity_min.min(capacity);
+                        self.output_capacity_max = self.output_capacity_max.max(capacity);
+                    }
+                }
+                Err(error) => {
+                    add(&mut self.errors, 1, saturated);
+                    add(&mut self.errors_by_kind[error_bucket(error)], 1, saturated);
+                }
+            }
+        }
+    }
+
+    /// Completed counters returned by one measured wrapper invocation.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Census {
+        pub sprm_size_bytes: usize,
+        pub saturated: bool,
+        pub total: Bucket,
+        pub snapshot_open: Bucket,
+        pub edit_open: Bucket,
+        pub staged_replacement: Bucket,
+        pub final_commit: Bucket,
+        pub output_copy: Bucket,
+        pub other: Bucket,
+    }
+
+    #[derive(Clone, Copy)]
+    struct State {
+        total: Bucket,
+        snapshot_open: Bucket,
+        edit_open: Bucket,
+        staged_replacement: Bucket,
+        final_commit: Bucket,
+        output_copy: Bucket,
+        other: Bucket,
+        phase: Phase,
+        saturated: bool,
+    }
+
+    impl State {
+        const fn empty() -> Self {
+            Self {
+                total: Bucket::empty(),
+                snapshot_open: Bucket::empty(),
+                edit_open: Bucket::empty(),
+                staged_replacement: Bucket::empty(),
+                final_commit: Bucket::empty(),
+                output_copy: Bucket::empty(),
+                other: Bucket::empty(),
+                phase: Phase::Other,
+                saturated: false,
+            }
+        }
+
+        fn census(self) -> Census {
+            Census {
+                sprm_size_bytes: size_of::<Sprm>(),
+                saturated: self.saturated,
+                total: self.total,
+                snapshot_open: self.snapshot_open,
+                edit_open: self.edit_open,
+                staged_replacement: self.staged_replacement,
+                final_commit: self.final_commit,
+                output_copy: self.output_copy,
+                other: self.other,
+            }
+        }
+    }
+
+    thread_local! {
+        static ACTIVE: Cell<bool> = const { Cell::new(false) };
+        static STATE: RefCell<State> = const { RefCell::new(State::empty()) };
+    }
+
+    /// Scope that enables counters for exactly one measured lifecycle.
+    pub struct Guard {
+        previous_active: bool,
+        finished: bool,
+    }
+
+    /// Enable and clear the current thread's counters.
+    pub fn begin() -> Guard {
+        let previous_active = ACTIVE.with(|active| active.replace(true));
+        STATE.with(|state| *state.borrow_mut() = State::empty());
+        Guard {
+            previous_active,
+            finished: false,
+        }
+    }
+
+    impl Guard {
+        /// Return the fixed counters and restore the previous active state.
+        pub fn finish(mut self) -> Census {
+            self.finished = true;
+            let census = STATE.with(|state| state.borrow().census());
+            ACTIVE.with(|active| active.set(self.previous_active));
+            census
+        }
+    }
+
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            if !self.finished {
+                ACTIVE.with(|active| active.set(self.previous_active));
+            }
+        }
+    }
+
+    /// Change the fixed phase bucket used by subsequent calls.
+    pub fn set_phase(phase: Phase) {
+        ACTIVE.with(|active| {
+            if active.get() {
+                STATE.with(|state| state.borrow_mut().phase = phase);
+            }
+        });
+    }
+
+    pub(super) fn record(input_len: usize, result: &Result<Vec<Sprm>>) {
+        ACTIVE.with(|active| {
+            if !active.get() {
+                return;
+            }
+            STATE.with(|state| {
+                let mut state = state.borrow_mut();
+                let phase = state.phase;
+                let mut saturated = state.saturated;
+                state.total.record(input_len, result, &mut saturated);
+                match phase {
+                    Phase::SnapshotOpen => {
+                        state.snapshot_open.record(input_len, result, &mut saturated);
+                    }
+                    Phase::EditOpen => state.edit_open.record(input_len, result, &mut saturated),
+                    Phase::StagedReplacement => {
+                        state.staged_replacement.record(input_len, result, &mut saturated);
+                    }
+                    Phase::FinalCommit => {
+                        state.final_commit.record(input_len, result, &mut saturated);
+                    }
+                    Phase::OutputCopy => {
+                        state.output_copy.record(input_len, result, &mut saturated);
+                    }
+                    Phase::Other => state.other.record(input_len, result, &mut saturated),
+                }
+                state.saturated = saturated;
+            });
+        });
+    }
+
+    fn add(value: &mut u64, amount: u64, saturated: &mut bool) {
+        let next = value.saturating_add(amount);
+        *saturated |= next == u64::MAX && *value != u64::MAX;
+        *value = next;
+    }
+
+    fn input_bucket(value: u64) -> usize {
+        match value {
+            0 => 0,
+            1 => 1,
+            2..=3 => 2,
+            4..=7 => 3,
+            8..=15 => 4,
+            16..=31 => 5,
+            32..=63 => 6,
+            64..=127 => 7,
+            128..=255 => 8,
+            _ => 9,
+        }
+    }
+
+    fn output_bucket(value: u64) -> usize {
+        input_bucket(value)
+    }
+
+    fn error_bucket(error: &Error) -> usize {
+        match error {
+            Error::Opcode { .. } => 0,
+            Error::Length { .. } => 1,
+            Error::ZeroLength { .. } => 2,
+            Error::Overflow { .. } => 3,
+            Error::Operand { .. } => 4,
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn guard_scopes_phase_counters_and_resets_between_lifecycles() {
+            let first = {
+                let guard = begin();
+                set_phase(Phase::StagedReplacement);
+                assert!(super::super::parse_sprms(&[]).is_ok());
+                set_phase(Phase::OutputCopy);
+                assert!(super::super::parse_sprms(&[0x35, 0x08, 0x01]).is_ok());
+                guard.finish()
+            };
+            assert_eq!(first.total.calls, 2);
+            assert_eq!(first.total.successes, 2);
+            assert_eq!(first.staged_replacement.calls, 1);
+            assert_eq!(first.output_copy.calls, 1);
+            assert_eq!(first.other.calls, 0);
+
+            let second = {
+                let guard = begin();
+                guard.finish()
+            };
+            assert_eq!(second.total.calls, 0);
+            assert_eq!(second.total.successes, 0);
+            assert_eq!(second.total.errors, 0);
+
+            // Recording is disabled after finish, so this call cannot leak
+            // into the next lifecycle's reset state.
+            assert!(super::super::parse_sprms(&[]).is_ok());
+            let third = {
+                let guard = begin();
+                guard.finish()
+            };
+            assert_eq!(third.total.calls, 0);
+        }
+
+        #[test]
+        fn guard_counts_reachable_parser_error_kinds_without_input_retention() {
+            let census = {
+                let guard = begin();
+                set_phase(Phase::FinalCommit);
+                assert!(super::super::parse_sprms(&[0x43]).is_err());
+                assert!(super::super::parse_sprms(&[0x08, 0xD6, 0x00]).is_err());
+                assert!(super::super::parse_sprms(&[0x08, 0xD6, 0x00, 0x00]).is_err());
+                assert!(super::super::parse_sprms(&[0x43, 0x4A, 0x18]).is_err());
+                guard.finish()
+            };
+            assert_eq!(census.total.calls, 4);
+            assert_eq!(census.total.successes, 0);
+            assert_eq!(census.total.errors, 4);
+            assert_eq!(census.total.errors_by_kind, [1, 1, 1, 0, 1]);
+            assert_eq!(census.final_commit.errors_by_kind, [1, 1, 1, 0, 1]);
+            assert_eq!(census.other.calls, 0);
+        }
+    }
+}
