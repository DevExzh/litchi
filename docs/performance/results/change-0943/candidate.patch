+    #[test]
+    fn picture_stream_limit_refusal_is_typed_and_atomic_after_data_append() {
+        let (admitted, graph) = floating_graph_and_receiver();
+        assert_eq!(admitted.data.len(), 4_096);
+        let max_stream_size = u64::try_from(admitted.data.len())
+            .unwrap()
+            .checked_add(u64::try_from(graph.picture_block.len()).unwrap())
+            .and_then(|size| size.checked_sub(1))
+            .unwrap();
+        assert!(u64::try_from(admitted.word.len()).unwrap() < max_stream_size);
+        assert!(u64::try_from(admitted.table.len()).unwrap() < max_stream_size);
+
+        let mut limits = Limits::default();
+        limits.max_stream_size = max_stream_size;
+        let source = RevisionEditor::open(admitted.source.as_ref().clone(), limits).unwrap();
+        let source_data = Arc::clone(&source.data);
+        let source_data_bytes = source.data.as_ref().clone();
+        let source_word = source.word.clone();
+        let source_table = source.table.clone();
+        let source_bytes = source.source.as_ref().clone();
+        let mut candidate = source.clone();
+
+        let error = candidate
+            .replace_with_picture_graph(0, 1, &graph)
+            .unwrap_err();
+        let error_text = error.to_string();
+        assert!(
+            matches!(
+                error,
+                PackageError::Ole(litchi_cfb::OleError::InvalidFormat(message))
+                    if message.contains("stream exceeds size limit")
+            ),
+            "unexpected late limit refusal: {error_text}"
+        );
+        assert!(Arc::ptr_eq(&source_data, &candidate.data));
+        assert_eq!(candidate.data.as_slice(), source_data_bytes.as_slice());
+        assert_eq!(candidate.word, source_word);
+        assert_eq!(candidate.table, source_table);
+        assert_eq!(candidate.source.as_ref(), source_bytes.as_slice());
+        assert_eq!(source.data.as_slice(), source_data_bytes.as_slice());
+    }
