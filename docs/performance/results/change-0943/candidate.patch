+    fn picture_install_and_restore_detach_only_the_mutated_data_snapshot() {
+        let (receiver, graph) = floating_graph_and_receiver();
+        let source_text = receiver.main_story_text().unwrap();
+        assert_eq!(source_text, "placeholder\r");
+        assert_eq!(receiver.data.len(), 4_096);
+        let source_bytes = receiver.data.as_slice().to_vec();
+        let source_data = Arc::clone(&receiver.data);
+        let mut candidate = receiver.clone();
+
+        let installed = candidate
+            .replace_with_picture_graph(0, 11, &graph)
+            .unwrap()
+            .expect("picture graph should install");
+        assert!(!Arc::ptr_eq(&source_data, &candidate.data));
+        assert_eq!(receiver.data.as_slice(), source_bytes.as_slice());
+        assert_eq!(
+            &candidate.data[..source_bytes.len()],
+            source_bytes.as_slice()
+        );
+        assert_eq!(
+            &candidate.data[source_bytes.len()..],
+            installed.picture_block.as_slice()
+        );
+        let installed_data = Arc::clone(&candidate.data);
+        let installed_bytes = installed_data.as_ref().clone();
+
+        candidate
+            .replace_picture_graph_with_text(0, 1, &installed, "placeholder")
+            .unwrap();
+        assert!(!Arc::ptr_eq(&installed_data, &candidate.data));
