diff --git a/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata.rs b/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata.rs
new file mode 100644
index 0000000000..2cdc093f91
--- /dev/null
+++ b/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata.rs
@@ -0,0 +1,345 @@
+//! Validators for the small worksheet-metadata subset admitted by the
+//! selected-cell stream.
+//!
+//! The selected route does not materialize layout, view, or print metadata.
+//! It may therefore admit only fields whose lexical form is independently
+//! checked and whose presence cannot change the selected cell values.  An
+//! unknown or repairable field is reported to the caller as an ineligible
+//! worksheet, which leaves the authoritative worksheet parser in charge.
+
+use litchi_ooxml_common::mce::SemanticElement;
+use litchi_sheet::{COLUMNS, ROWS, Rect};
+
+const RELATIONSHIP_NAMESPACE: &[u8] =
+    b"http://schemas.openxmlformats.org/officeDocument/2006/relationships";
+const STRICT_RELATIONSHIP_NAMESPACE: &[u8] =
+    b"http://purl.oclc.org/ooxml/officeDocument/relationships";
+const MAX_SQREF_TOKENS: usize = 64;
+const MAX_RELATIONSHIP_ID_BYTES: usize = 4096;
+
+/// Validate a direct worksheet `sheetViews` container.
+pub(super) fn sheet_views(element: &SemanticElement<'_>) -> bool {
+    attributes(element, &[])
+}
+
+/// Validate the bounded `sheetView` subset used by the selected route.
+pub(super) fn sheet_view(element: &SemanticElement<'_>) -> bool {
+    attributes(element, &["workbookViewId"])
+        && required(element, "workbookViewId").is_some_and(|value| parse_u32(value).is_some())
+}
+
+/// Validate one inert selection projection.
+pub(super) fn selection(element: &SemanticElement<'_>) -> bool {
+    if !attributes(element, &["activeCell", "sqref"]) {
+        return false;
+    }
+    let active = element_attribute(element, "activeCell");
+    let sqref = element_attribute(element, "sqref");
+    if active.is_none() && sqref.is_none() {
+        return false;
+    }
+    if let Some(active) = active {
+        if parse_a1(active).is_err() {
+            return false;
+        }
+    }
+    if let Some(sqref) = sqref {
+        let mut count = 0usize;
+        for token in sqref.split_ascii_whitespace() {
+            count = count.saturating_add(1);
+            if count > MAX_SQREF_TOKENS || Rect::from_a1(token).is_err() {
+                return false;
+            }
+        }
+        if count == 0 {
+            return false;
+        }
+    }
+    true
+}
+
+/// Validate the modeled, finite `sheetFormatPr` values.  The x14ac descent
+/// attribute is checked by the raw extension observer and is admitted here
+/// only at its recognized namespace and local name.
+pub(super) fn sheet_format(element: &SemanticElement<'_>) -> bool {
+    const ALLOWED: &[&str] = &[
+        "baseColWidth",
+        "defaultColWidth",
+        "defaultRowHeight",
+        "customHeight",
+        "zeroHeight",
+        "thickTop",
+        "thickBottom",
+        "outlineLevelRow",
+        "outlineLevelCol",
+    ];
+    if !attributes_with_x14ac(element, ALLOWED) {
+        return false;
+    }
+    let Some(default_row_height) = required(element, "defaultRowHeight") else {
+        return false;
+    };
+    if !parse_f64(default_row_height, |value| {
+        crate::layout::Height::new(value).is_ok()
+    }) {
+        return false;
+    }
+    if let Some(value) = element_attribute(element, "defaultColWidth")
+        && !parse_f64(value, |value| crate::layout::Width::new(value).is_ok())
+    {
+        return false;
+    }
+    if let Some(value) = element_attribute(element, "baseColWidth")
+        && !parse_u32(value).is_some_and(|value| value <= 255)
+    {
+        return false;
+    }
+    for name in ["outlineLevelRow", "outlineLevelCol"] {
+        if let Some(value) = element_attribute(element, name)
+            && !parse_u32(value).is_some_and(|value| value <= 7)
+        {
+            return false;
+        }
+    }
+    for name in ["customHeight", "zeroHeight", "thickTop", "thickBottom"] {
+        if let Some(value) = element_attribute(element, name)
+            && !parse_bool(value)
+        {
+            return false;
+        }
+    }
+    true
+}
+
+/// Validate the direct `cols` container.  Its records are checked separately
+/// because non-overlap and source order are scanner state, not tag-local facts.
+pub(super) fn cols(element: &SemanticElement<'_>) -> bool {
+    attributes(element, &[])
+}
+
+/// Validate a style-free column record and return its inclusive maximum.
+pub(super) fn col(element: &SemanticElement<'_>, previous_max: u32) -> Option<u32> {
+    const ALLOWED: &[&str] = &[
+        "min",
+        "max",
+        "width",
+        "hidden",
+        "bestFit",
+        "customWidth",
+        "phonetic",
+        "outlineLevel",
+        "collapsed",
+    ];
+    if !attributes(element, ALLOWED) {
+        return None;
+    }
+    // A style-bearing column changes the effective cell presentation and is
+    // deliberately outside this value-only selected route.
+    if element_attribute(element, "style").is_some() {
+        return None;
+    }
+    let min = required(element, "min").and_then(parse_u32)?;
+    let max = required(element, "max").and_then(parse_u32)?;
+    if min == 0 || max > COLUMNS || min > max || min <= previous_max {
+        return None;
+    }
+    if let Some(value) = element_attribute(element, "width")
+        && !parse_f64(value, |value| crate::column::Width::new(value).is_ok())
+    {
+        return None;
+    }
+    if let Some(value) = element_attribute(element, "outlineLevel")
+        && !parse_u32(value).is_some_and(|value| value <= 7)
+    {
+        return None;
+    }
+    for name in ["hidden", "bestFit", "customWidth", "phonetic", "collapsed"] {
+        if let Some(value) = element_attribute(element, name)
+            && !parse_bool(value)
+        {
+            return None;
+        }
+    }
+    Some(max)
+}
+
+/// Validate a complete, direct page-margin record.
+pub(super) fn page_margins(element: &SemanticElement<'_>) -> bool {
+    const NAMES: &[&str] = &["left", "right", "top", "bottom", "header", "footer"];
+    if !attributes(element, NAMES) {
+        return false;
+    }
+    NAMES.iter().all(|name| {
+        required(element, name).is_some_and(|value| {
+            parse_f64(value, |value| {
+                value.is_finite() && (0.0..49.0).contains(&value)
+            })
+        })
+    })
+}
+
+/// Validate a bounded, value-safe page-setup subset.  Other valid print
+/// settings remain authoritative-parser territory because the selected route
+/// does not materialize their semantics.
+pub(super) fn page_setup(element: &SemanticElement<'_>) -> bool {
+    const ALLOWED: &[&str] = &["paperSize", "orientation"];
+    if !attributes_with_relationship_id(element, ALLOWED) {
+        return false;
+    }
+    if let Some(value) = element_attribute(element, "paperSize")
+        && !parse_u32(value).is_some_and(|value| crate::page_setup::Paper::try_from(value).is_ok())
+    {
+        return false;
+    }
+    if let Some(value) = element_attribute(element, "orientation")
+        && !matches!(value, "default" | "portrait" | "landscape")
+    {
+        return false;
+    }
+    if let Some(value) = relationship_id(element) {
+        if value.is_empty()
+            || value.len() > MAX_RELATIONSHIP_ID_BYTES
+            || !litchi_ooxml_common::xml::is_ncname(value)
+        {
+            return false;
+        }
+    }
+    true
+}
+
+/// Validate a row's optional, advisory `spans` range.
+pub(super) fn row_spans(value: &str) -> bool {
+    let Some((first, last)) = value.split_once(':') else {
+        return false;
+    };
+    let Some(first) = parse_u32(first) else {
+        return false;
+    };
+    let Some(last) = parse_u32(last) else {
+        return false;
+    };
+    (1..=COLUMNS).contains(&first) && (first..=COLUMNS).contains(&last)
+}
+
+fn attributes(element: &SemanticElement<'_>, allowed: &[&str]) -> bool {
+    attributes_inner(element, allowed, false, false)
+}
+
+fn attributes_with_x14ac(element: &SemanticElement<'_>, allowed: &[&str]) -> bool {
+    attributes_inner(element, allowed, true, false)
+}
+
+fn attributes_with_relationship_id(element: &SemanticElement<'_>, allowed: &[&str]) -> bool {
+    attributes_inner(element, allowed, false, true)
+}
+
+fn attributes_inner(
+    element: &SemanticElement<'_>,
+    allowed: &[&str],
+    allow_x14ac: bool,
+    allow_relationship_id: bool,
+) -> bool {
+    let mut seen = 0u128;
+    let mut relationship_seen = false;
+    for attribute in &element.attributes {
+        let namespace = attribute.expanded_name.namespace.as_bytes();
+        let local = attribute.expanded_name.local_name.as_str();
+        if namespace.is_empty() {
+            let Some(index) = allowed.iter().position(|name| *name == local) else {
+                return false;
+            };
+            let Some(bit) = 1u128.checked_shl(index as u32) else {
+                return false;
+            };
+            if seen & bit != 0 {
+                return false;
+            }
+            seen |= bit;
+        } else if allow_x14ac
+            && namespace == b"http://schemas.microsoft.com/office/spreadsheetml/2009/9/ac"
+            && local == "dyDescent"
+        {
+            // The raw x14ac observer owns the lexical/value check.
+        } else if allow_relationship_id
+            && local == "id"
+            && (namespace == RELATIONSHIP_NAMESPACE || namespace == STRICT_RELATIONSHIP_NAMESPACE)
+        {
+            if relationship_seen {
+                return false;
+            }
+            relationship_seen = true;
+            // The relationship identifier is validated below.
+        } else {
+            return false;
+        }
+    }
+    true
+}
+
+fn relationship_id<'a>(element: &'a SemanticElement<'_>) -> Option<&'a str> {
+    element.attributes.iter().find_map(|attribute| {
+        let namespace = attribute.expanded_name.namespace.as_bytes();
+        (attribute.expanded_name.local_name == "id"
+            && (namespace == RELATIONSHIP_NAMESPACE || namespace == STRICT_RELATIONSHIP_NAMESPACE))
+            .then_some(attribute.decoded_value.as_ref())
+    })
+}
+
+fn element_attribute<'a>(element: &'a SemanticElement<'_>, name: &str) -> Option<&'a str> {
+    element
+        .attributes
+        .iter()
+        .find(|attribute| {
+            attribute.expanded_name.namespace.is_empty()
+                && attribute.expanded_name.local_name == name
+        })
+        .map(|attribute| attribute.decoded_value.as_ref())
+}
+
+fn required<'a>(element: &'a SemanticElement<'_>, name: &str) -> Option<&'a str> {
+    element_attribute(element, name)
+}
+
+fn parse_u32(value: &str) -> Option<u32> {
+    (!value.is_empty()).then(|| value.parse().ok()).flatten()
+}
+
+fn parse_f64(value: &str, valid: impl FnOnce(f64) -> bool) -> bool {
+    value.parse::<f64>().ok().is_some_and(valid)
+}
+
+fn parse_bool(value: &str) -> bool {
+    matches!(value, "0" | "1" | "true" | "false")
+}
+
+fn parse_a1(value: &str) -> Result<(u32, u32), ()> {
+    let split = value
+        .as_bytes()
+        .iter()
+        .position(u8::is_ascii_digit)
+        .ok_or(())?;
+    if split == 0 || split == value.len() {
+        return Err(());
+    }
+    let column = value[..split]
+        .bytes()
+        .try_fold(0u32, |column, byte| {
+            byte.is_ascii_alphabetic()
+                .then(|| {
+                    column
+                        .checked_mul(26)?
+                        .checked_add(u32::from(byte.to_ascii_uppercase() - b'A' + 1))
+                })
+                .flatten()
+        })
+        .ok_or(())?;
+    if !(1..=COLUMNS).contains(&column) {
+        return Err(());
+    }
+    let row = value[split..].parse::<u32>().map_err(|_| ())?;
+    if (1..=ROWS).contains(&row) {
+        Ok((row, column))
+    } else {
+        Err(())
+    }
+}
diff --git a/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata_tests.rs b/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata_tests.rs
new file mode 100644
index 0000000000..4a6aa860e6
--- /dev/null
+++ b/crates/litchi-xlsx/src/raw/worksheet/selected/producer_metadata_tests.rs
@@ -0,0 +1,595 @@
+//! Differential qualification for the producer metadata admission profile.
+//!
+//! These tests exercise the selected scanner directly.  The materialized
+//! worksheet parser remains the semantic oracle: an eligible selected result
+//! must contain the same stored addresses and cells, in source order, and a
+//! clean parser tolerance report must remain possible.  Metadata that the
+//! parser can repair or ignore is deliberately tested as a scanner refusal;
+//! accepting it would make a future selected route hide the authoritative
+//! fallback's tolerance report.
+
+#![allow(clippy::unwrap_used, reason = "focused parser differential assertions")]
+
+use std::io::{BufReader, Cursor};
+
+use litchi_ooxml_common::mce::{Capabilities, StreamError, StreamLimits};
+use litchi_sheet::{Cell as Address, Rect};
+
+use super::super::{parse, parse_refusing_repairs};
+use super::{NotEligibleReason, RangeScanOutcome, SelectedPayload, scan_range};
+use crate::cell::{Cell, Text, Value};
+
+const TRANSITIONAL: &str = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+const STRICT: &str = "http://purl.oclc.org/ooxml/spreadsheetml/main";
+const MC: &str = "http://schemas.openxmlformats.org/markup-compatibility/2006";
+const X14AC: &str = "http://schemas.microsoft.com/office/spreadsheetml/2009/9/ac";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum NamespaceStyle {
+    Transitional,
+    TransitionalWithAliases,
+    StrictWithAliases,
+}
+
+impl NamespaceStyle {
+    fn root(self) -> &'static str {
+        match self {
+            Self::Transitional | Self::TransitionalWithAliases => "worksheet",
+            Self::StrictWithAliases => "s:worksheet",
+        }
+    }
+
+    fn element(self, local: &str) -> String {
+        match self {
+            Self::Transitional | Self::TransitionalWithAliases => local.to_owned(),
+            Self::StrictWithAliases => format!("s:{local}"),
+        }
+    }
+
+    fn aliases(self) -> &'static str {
+        match self {
+            Self::Transitional => {
+                r#"xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships""#
+            },
+            Self::TransitionalWithAliases => concat!(
+                r#"xmlns:m="http://schemas.openxmlformats.org/markup-compatibility/2006" "#,
+                r#"xmlns:xa="http://schemas.microsoft.com/office/spreadsheetml/2009/9/ac" "#,
+                r#"xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" "#,
+                r#"m:Ignorable="xa""#,
+            ),
+            Self::StrictWithAliases => concat!(
+                r#"xmlns:m="http://schemas.openxmlformats.org/markup-compatibility/2006" "#,
+                r#"xmlns:xa="http://schemas.microsoft.com/office/spreadsheetml/2009/9/ac" "#,
+                r#"xmlns:r="http://purl.oclc.org/ooxml/officeDocument/relationships" "#,
+                r#"m:Ignorable="xa""#,
+            ),
+        }
+    }
+
+    fn namespace(self) -> &'static str {
+        match self {
+            Self::Transitional | Self::TransitionalWithAliases => TRANSITIONAL,
+            Self::StrictWithAliases => STRICT,
+        }
+    }
+
+    fn x14ac(self) -> &'static str {
+        match self {
+            Self::Transitional => "",
+            Self::TransitionalWithAliases | Self::StrictWithAliases => r#" xa:dyDescent="0.25""#,
+        }
+    }
+
+    fn row_x14ac(self) -> &'static str {
+        self.x14ac()
+    }
+}
+
+fn metadata_body(style: NamespaceStyle, cells: &str) -> String {
+    let dimension = style.element("dimension");
+    let sheet_views = style.element("sheetViews");
+    let sheet_view = style.element("sheetView");
+    let selection = style.element("selection");
+    let sheet_format = style.element("sheetFormatPr");
+    let cols = style.element("cols");
+    let col = style.element("col");
+    let sheet_data = style.element("sheetData");
+    let page_margins = style.element("pageMargins");
+    let page_setup = style.element("pageSetup");
+    let x14ac = style.x14ac();
+    format!(
+        r#"<{dimension} ref="F7:I8"/>
+<{sheet_views}><{sheet_view} workbookViewId="3"><{selection} activeCell="G8" sqref="G8:H8"/></{sheet_view}></{sheet_views}>
+<{sheet_format} defaultRowHeight="15"{x14ac}/>
+<{cols}><{col} min="6" max="7" width="11.5703125" bestFit="1" customWidth="1"/><{col} min="8" max="9" width="12" customWidth="1"/></{cols}>
+<{sheet_data}>{cells}</{sheet_data}>
+<{page_margins} left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3" footer="0.3"/>
+<{page_setup} paperSize="9" orientation="portrait" r:id="rIdPrinter"/>"#,
+    )
+}
+
+fn metadata_xml(style: NamespaceStyle, cells: &str) -> String {
+    let root = style.root();
+    let aliases = style.aliases();
+    format!(
+        r#"<{root} xmlns="{namespace}" xmlns:s="{STRICT}" {aliases}>{body}</{root}>"#,
+        namespace = style.namespace(),
+        body = metadata_body(style, cells),
+    )
+}
+
+fn alternate_metadata_xml(choice: &str, fallback: &str) -> String {
+    format!(
+        r#"<worksheet xmlns="{TRANSITIONAL}" xmlns:m="{MC}" xmlns:xa="{X14AC}" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" m:Ignorable="xa"><m:AlternateContent><m:Choice Requires="xa">{choice}</m:Choice><m:Fallback>{fallback}</m:Fallback></m:AlternateContent></worksheet>"#,
+        choice = choice,
+        fallback = fallback,
+    )
+}
+
+fn process_content_metadata_xml(active: bool, body: &str) -> String {
+    let process_target = if active {
+        "future:payload"
+    } else {
+        "future:other"
+    };
+    let tail = if active {
+        String::new()
+    } else {
+        r#"<sheetData><row r="1"><c r="A1"><v>17</v></c></row></sheetData>"#.to_owned()
+    };
+    format!(
+        r#"<worksheet xmlns="{TRANSITIONAL}" xmlns:m="{MC}" xmlns:xa="{X14AC}" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:future="urn:litchi:future" m:Ignorable="xa future" m:ProcessContent="{process_target}"><future:payload>{body}</future:payload>{tail}</worksheet>"#,
+        process_target = process_target,
+        body = body,
+        tail = tail,
+    )
+}
+
+fn scalar_cells(style: NamespaceStyle) -> String {
+    let c = style.element("c");
+    let v = style.element("v");
+    let is = style.element("is");
+    let t = style.element("t");
+    let first = format!(
+        r#"<{c} r="F7"><{v}>-0.000</{v}></{c}>
+<{c} r="G7" t="b"><{v}>true</{v}></{c}>
+<{c} r="H7" t="str"><{v}>plain&amp;text</{v}></{c}>
+<{c} r="I7"/>"#,
+    );
+    let second = format!(
+        r#"<{c} r="F8" t="e"><{v}>#DIV/0!</{v}></{c}>
+<{c} r="G8" t="inlineStr"><{is}><{t}>inline text</{t}></{is}></{c}>"#,
+    );
+    rows(style, &first, &second)
+}
+
+fn shared_cells(style: NamespaceStyle) -> String {
+    let c = style.element("c");
+    let v = style.element("v");
+    let first = format!(
+        r#"<{c} r="F7" t="s"><{v}>0</{v}></{c}>
+<{c} r="G7" t="s"><{v}>3</{v}></{c}>"#,
+    );
+    rows(style, &first, "")
+}
+
+fn rows(style: NamespaceStyle, first: &str, second: &str) -> String {
+    let row = style.element("row");
+    let row_x14ac = style.row_x14ac();
+    if second.is_empty() {
+        format!(r#"<{row} r="7" spans="6:9"{row_x14ac}>{first}</{row}>"#,)
+    } else {
+        format!(
+            r#"<{row} r="7" spans="6:9"{row_x14ac}>{first}</{row}>
+<{row} r="8" spans="6:9"{row_x14ac}>{second}</{row}>"#,
+        )
+    }
+}
+
+fn scan_xml(xml: &str) -> Result<RangeScanOutcome, StreamError<crate::Error, crate::Error>> {
+    scan_xml_with(xml, &Capabilities::default())
+}
+
+fn scan_xml_with(
+    xml: &str,
+    capabilities: &Capabilities,
+) -> Result<RangeScanOutcome, StreamError<crate::Error, crate::Error>> {
+    let mut input = BufReader::new(Cursor::new(xml.as_bytes()));
+    scan_range(
+        &mut input,
+        capabilities,
+        &StreamLimits::default(),
+        Rect::ALL,
+    )
+}
+
+fn parse_cells(xml: &str, strings: &[Text]) -> Vec<(Address, Cell)> {
+    let store = parse(xml.as_bytes(), || Ok(Some(strings))).expect("authoritative worksheet parse");
+    assert!(
+        store.tolerance_report().is_clean(),
+        "positive metadata fixture unexpectedly required repairs: {:?}",
+        store.tolerance_report()
+    );
+    assert!(
+        parse_refusing_repairs(xml.as_bytes(), || Ok(Some(strings))).is_ok(),
+        "write-path admission rejected clean metadata fixture"
+    );
+    store
+        .entries()
+        .iter()
+        .map(|entry| (entry.address, entry.cell.clone()))
+        .collect()
+}
+
+fn assert_differential(xml: &str, strings: &[Text]) {
+    assert_differential_against(xml, xml, strings, &Capabilities::default());
+}
+
+fn assert_differential_against(
+    selected_xml: &str,
+    authoritative_xml: &str,
+    strings: &[Text],
+    capabilities: &Capabilities,
+) {
+    let expected = parse_cells(authoritative_xml, strings);
+    let outcome = scan_xml_with(selected_xml, capabilities).expect("selected metadata scan");
+    let RangeScanOutcome::Eligible(selected) = outcome else {
+        panic!("clean producer metadata should be eligible: {outcome:?}");
+    };
+
+    let mut actual = Vec::with_capacity(selected.cells.len());
+    let mut max_shared = None;
+    for record in &selected.cells {
+        let cell = match &record.payload {
+            SelectedPayload::Cell(cell) => cell.clone(),
+            SelectedPayload::SharedString(index) => {
+                max_shared = Some(max_shared.map_or(*index, |current: u32| current.max(*index)));
+                Cell::Value(Value::Text(
+                    strings
+                        .get(*index as usize)
+                        .unwrap_or_else(|| panic!("selected shared-string index {index} missing"))
+                        .clone(),
+                ))
+            },
+        };
+        actual.push((record.address, cell));
+    }
+    assert_eq!(
+        actual, expected,
+        "selected records diverged from materialized store"
+    );
+    assert_eq!(selected.dependencies.max_shared_string_index, max_shared);
+    assert_eq!(selected.dependencies.max_direct_style_index, None);
+    assert_eq!(selected.dependencies.target_shared_string_index, None);
+}
+
+fn assert_not_eligible(xml: &str, label: &str) -> NotEligibleReason {
+    match scan_xml(xml) {
+        Ok(RangeScanOutcome::NotEligible(reason)) => reason,
+        Ok(RangeScanOutcome::Eligible(_)) => panic!("{label} was silently admitted"),
+        Err(error) => panic!("{label} produced a stream error instead of fallback: {error}"),
+    }
+}
+
+fn replace_once(xml: &str, old: &str, new: &str) -> String {
+    assert_eq!(
+        xml.matches(old).count(),
+        1,
+        "fixture mutation anchor is unique"
+    );
+    xml.replacen(old, new, 1)
+}
