+#[derive(Clone, Copy)]
+pub(super) enum ShapeAttributeKey {
+    PresentationClass,
+    PresentationStyleName,
+    PresentationPlaceholder,
+    PresentationUserTransformed,
+    DrawingName,
+    DrawingStyleName,
+    DrawingLayer,
+    DrawingZIndex,
+    DrawingTransform,
+    SvgX,
+    SvgY,
+    SvgWidth,
+    SvgHeight,
+    SvgX1,
+    SvgY1,
+    SvgX2,
+    SvgY2,
+}
+
+impl ShapeAttributeKey {
+    const COUNT: usize = 17;
+
+    fn index(self) -> usize {
+        self as usize
+    }
+
+    fn target(self) -> (&'static [u8], &'static [u8]) {
+        match self {
+            Self::PresentationClass => (PRESENTATION_NAMESPACE, b"class"),
+            Self::PresentationStyleName => (PRESENTATION_NAMESPACE, b"style-name"),
+            Self::PresentationPlaceholder => (PRESENTATION_NAMESPACE, b"placeholder"),
+            Self::PresentationUserTransformed => (PRESENTATION_NAMESPACE, b"user-transformed"),
+            Self::DrawingName => (DRAW_NAMESPACE, b"name"),
+            Self::DrawingStyleName => (DRAW_NAMESPACE, b"style-name"),
+            Self::DrawingLayer => (DRAW_NAMESPACE, b"layer"),
+            Self::DrawingZIndex => (DRAW_NAMESPACE, b"z-index"),
+            Self::DrawingTransform => (DRAW_NAMESPACE, b"transform"),
+            Self::SvgX => (SVG_NAMESPACE, b"x"),
+            Self::SvgY => (SVG_NAMESPACE, b"y"),
+            Self::SvgWidth => (SVG_NAMESPACE, b"width"),
+            Self::SvgHeight => (SVG_NAMESPACE, b"height"),
+            Self::SvgX1 => (SVG_NAMESPACE, b"x1"),
+            Self::SvgY1 => (SVG_NAMESPACE, b"y1"),
+            Self::SvgX2 => (SVG_NAMESPACE, b"x2"),
+            Self::SvgY2 => (SVG_NAMESPACE, b"y2"),
+        }
+    }
+
+    fn from_target(namespace_uri: &[u8], local_name: &[u8]) -> Option<Self> {
+        if namespace_uri == PRESENTATION_NAMESPACE {
+            match local_name {
+                b"class" => Some(Self::PresentationClass),
+                b"style-name" => Some(Self::PresentationStyleName),
+                b"placeholder" => Some(Self::PresentationPlaceholder),
+                b"user-transformed" => Some(Self::PresentationUserTransformed),
+                _ => None,
+            }
+        } else if namespace_uri == DRAW_NAMESPACE {
+            match local_name {
+                b"name" => Some(Self::DrawingName),
+                b"style-name" => Some(Self::DrawingStyleName),
+                b"layer" => Some(Self::DrawingLayer),
+                b"z-index" => Some(Self::DrawingZIndex),
+                b"transform" => Some(Self::DrawingTransform),
+                _ => None,
+            }
+        } else if namespace_uri == SVG_NAMESPACE {
+            match local_name {
+                b"x" => Some(Self::SvgX),
+                b"y" => Some(Self::SvgY),
+                b"width" => Some(Self::SvgWidth),
+                b"height" => Some(Self::SvgHeight),
+                b"x1" => Some(Self::SvgX1),
+                b"y1" => Some(Self::SvgY1),
+                b"x2" => Some(Self::SvgX2),
+                b"y2" => Some(Self::SvgY2),
+                _ => None,
+            }
+        } else {
+            None
+        }
+    }
+
+    fn from_cached(cached: &ResolvedAttribute<'_, '_>) -> Option<Self> {
+        let local_name = cached.local_name.as_ref();
+        if cached.namespace.matches(PRESENTATION_NAMESPACE) {
+            match local_name {
+                b"class" => Some(Self::PresentationClass),
+                b"style-name" => Some(Self::PresentationStyleName),
+                b"placeholder" => Some(Self::PresentationPlaceholder),
+                b"user-transformed" => Some(Self::PresentationUserTransformed),
+                _ => None,
+            }
+        } else if cached.namespace.matches(DRAW_NAMESPACE) {
+            match local_name {
+                b"name" => Some(Self::DrawingName),
+                b"style-name" => Some(Self::DrawingStyleName),
+                b"layer" => Some(Self::DrawingLayer),
+                b"z-index" => Some(Self::DrawingZIndex),
+                b"transform" => Some(Self::DrawingTransform),
+                _ => None,
+            }
+        } else if cached.namespace.matches(SVG_NAMESPACE) {
+            match local_name {
+                b"x" => Some(Self::SvgX),
+                b"y" => Some(Self::SvgY),
+                b"width" => Some(Self::SvgWidth),
+                b"height" => Some(Self::SvgHeight),
+                b"x1" => Some(Self::SvgX1),
+                b"y1" => Some(Self::SvgY1),
+                b"x2" => Some(Self::SvgX2),
+                b"y2" => Some(Self::SvgY2),
+                _ => None,
+            }
+        } else {
+            None
+        }
+    }
+}
+
+struct ShapeAttributeIndex {
+    first: [Option<usize>; ShapeAttributeKey::COUNT],
+    exhausted: bool,
+}
+
+impl ShapeAttributeIndex {
+    fn new() -> Self {
+        Self {
+            first: [None; ShapeAttributeKey::COUNT],
+            exhausted: false,
+        }
+    }
+}
+
+impl AttributeIndex for ShapeAttributeIndex {
+    fn lookup(&self, namespace_uri: &[u8], local_name: &[u8]) -> IndexedLookup {
+        match ShapeAttributeKey::from_target(namespace_uri, local_name) {
+            Some(key) => IndexedLookup::Known(self.first[key.index()]),
+            None => IndexedLookup::Generic,
+        }
+    }
+
+    fn lookup_key(&self, key: ShapeAttributeKey) -> IndexedLookup {
+        IndexedLookup::Known(self.first[key.index()])
+    }
+
+    fn record<'event, 'resolver>(
+        &mut self,
+        parsed_index: usize,
+        cached: &ResolvedAttribute<'event, 'resolver>,
+    ) {
+        let Some(key) = ShapeAttributeKey::from_cached(cached) else {
+            return;
+        };
+        let first = &mut self.first[key.index()];
+        if first.is_none() {
+            *first = Some(parsed_index);
+        }
+    }
+
+    fn finish_scan(&mut self) {
+        self.exhausted = true;
+    }
+
+    fn exhausted(&self) -> bool {
+        self.exhausted
+    }
+}
+
+pub(super) struct ShapeAttrs<'event, 'resolver> {
+    attributes: ElementAttrs<'event, 'resolver>,
+    index: ShapeAttributeIndex,
+}
+
+impl<'event, 'resolver> ShapeAttrs<'event, 'resolver> {
+    pub(super) fn new(element: &'event BytesStart<'_>) -> Self {
+        Self {
+            attributes: ElementAttrs::new(element),
+            index: ShapeAttributeIndex::new(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn get(
+        &mut self,
+        reader: &'resolver NsReader<&[u8]>,
+        namespace_uri: &[u8],
+        local_name: &[u8],
+    ) -> Result<Option<String>> {
+        self.attributes
+            .get_with_index(reader, namespace_uri, local_name, None, &mut self.index)
+    }
+
+    pub(super) fn get_known(
+        &mut self,
+        reader: &'resolver NsReader<&[u8]>,
+        key: ShapeAttributeKey,
+    ) -> Result<Option<String>> {
+        let (namespace_uri, local_name) = key.target();
+        self.attributes.get_with_index(
+            reader,
+            namespace_uri,
+            local_name,
+            Some(key),
+            &mut self.index,
+        )
+    }
+
+    pub(super) fn drawing_attributes(
+        &mut self,
+        reader: &'resolver NsReader<&[u8]>,
+    ) -> Result<Vec<DrawingAttribute>> {
+        self.attributes
+            .drawing_attributes_with_index(reader, &mut self.index)
+    }
+}
