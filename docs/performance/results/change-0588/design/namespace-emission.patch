+/// Reserve with the standard amortized growth policy.
+///
+/// The per-element buffers below grow one entry at a time; an exact reservation
+/// would reallocate on every push, so they take the geometric policy while the
+/// fixed-size reservations above keep their exact one.
+fn reserve_amortized<T>(values: &mut Vec<T>, additional: usize, resource: &'static str) -> R<()> {
+    values
+        .try_reserve(additional)
+        .map_err(|source| Error::Allocation { resource, source })
+}
