+    let mut removed = Counters::default();
+    let mut added = Counters::default();
+    let original_bytes = windows.iter().try_fold(0usize, |total, window| {
+        total.checked_add(window.original.len())
+    })?;
+    let replacement_bytes = windows.iter().try_fold(0usize, |total, window| {
+        total.checked_add(window.replacement.len())
+    })?;
