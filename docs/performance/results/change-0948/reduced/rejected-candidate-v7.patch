+        verify_source_replacement_with_spans(
+            original.as_bytes(),
+            replacement.as_bytes(),
+            Limits::default(),
+            &spans,
+        ),
+        Ok(ReplacementProof::Windows { count: 2, .. })
+    ));
+}
