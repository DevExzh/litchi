+//! Fixed-size diagnostics for the staged CFB commit path.
+//!
+//! The observer is intentionally feature gated.  It records only scalar
+//! route and capture counters while an operation-local commit is active; it
+//! never retains input bytes, stream names, or event records.
+
+use std::cell::RefCell;
+
+/// One bounded operation-local CFB commit census.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Census {
+    pub commit_attempts: u64,
+    pub commit_successes: u64,
+    pub commit_errors: u64,
+    pub overlay_attempted: u64,
+    pub overlay_success: u64,
+    pub overlay_declined: u64,
+    pub overlay_error: u64,
+    pub overlay_not_attempted: u64,
+    pub layout_attempted: u64,
+    pub layout_reuse_success: u64,
+    pub layout_non_reuse: u64,
+    pub layout_error: u64,
+    pub capture_attempted: u64,
+    pub capture_success: u64,
+    pub capture_error: u64,
+    pub capture_streams: u64,
+    pub capture_payload_bytes: u64,
+    pub saturated: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct State {
+    census: Census,
+    session_active: bool,
+    commit_active: bool,
+    render_active: bool,
+    capture_active: bool,
+}
+
+impl State {
+    const fn new() -> Self {
+        Self {
+            census: Census {
+                commit_attempts: 0,
+                commit_successes: 0,
+                commit_errors: 0,
+                overlay_attempted: 0,
+                overlay_success: 0,
+                overlay_declined: 0,
+                overlay_error: 0,
+                overlay_not_attempted: 0,
+                layout_attempted: 0,
+                layout_reuse_success: 0,
+                layout_non_reuse: 0,
+                layout_error: 0,
+                capture_attempted: 0,
+                capture_success: 0,
+                capture_error: 0,
+                capture_streams: 0,
+                capture_payload_bytes: 0,
+                saturated: false,
+            },
+            session_active: false,
+            commit_active: false,
+            render_active: false,
+            capture_active: false,
+        }
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::new());
+}
+
+fn with_state(function: impl FnOnce(&mut State)) {
+    STATE.with(|state| function(&mut state.borrow_mut()));
+}
+
+fn add(value: &mut u64, amount: u64) -> bool {
+    match value.checked_add(amount) {
+        Some(next) => {
+            *value = next;
+            false
+        },
+        None => {
+            *value = u64::MAX;
+            true
+        },
+    }
+}
+
+/// Starts a fresh operation-local census on the current thread.
+#[must_use]
+pub fn begin() -> Session {
+    with_state(|state| {
+        state.census = Census::default();
+        state.session_active = true;
+        state.commit_active = false;
+        state.render_active = false;
+        state.capture_active = false;
+    });
+    Session { finished: false }
+}
+
+/// Owns one operation-local census.
+#[derive(Debug)]
+pub struct Session {
+    finished: bool,
+}
+
+impl Session {
+    /// Finishes and returns the bounded counters.
+    #[must_use]
+    pub fn finish(mut self) -> Census {
+        self.finished = true;
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            state.session_active = false;
+            state.commit_active = false;
+            state.render_active = false;
+            state.capture_active = false;
+            state.census
+        })
+    }
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        if !self.finished {
+            with_state(|state| {
+                state.session_active = false;
+                state.commit_active = false;
+                state.render_active = false;
+                state.capture_active = false;
+            });
+        }
+    }
+}
+
+/// Scope for one staged object commit.  An uncompleted scope is an error,
+/// including every early-return path in the renderer, parser, or discovery.
+pub(crate) struct CommitScope {
+    active: bool,
+    finished: bool,
+}
+
+pub(crate) fn begin_commit() -> CommitScope {
+    let active = STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        if !state.session_active || state.commit_active {
+            return false;
+        }
+        state.commit_active = true;
+        state.render_active = false;
+        if add(&mut state.census.commit_attempts, 1) {
+            state.census.saturated = true;
+        }
+        true
+    });
+    CommitScope {
+        active,
+        finished: false,
+    }
+}
+
+impl CommitScope {
+    pub(crate) fn overlay_not_attempted(&self) {
+        if self.active {
+            with_state(|state| {
+                if add(&mut state.census.overlay_not_attempted, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+
+    pub(crate) fn overlay_attempted(&self) {
+        if self.active {
+            with_state(|state| {
+                if add(&mut state.census.overlay_attempted, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+
+    pub(crate) fn overlay_success(&self) {
+        if self.active {
+            with_state(|state| {
+                if add(&mut state.census.overlay_success, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+
+    pub(crate) fn overlay_declined(&self) {
+        if self.active {
+            with_state(|state| {
+                if add(&mut state.census.overlay_declined, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+
+    pub(crate) fn overlay_error(&self) {
+        if self.active {
+            with_state(|state| {
+                if add(&mut state.census.overlay_error, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+
+    pub(crate) fn finish_success(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.commit_successes, 1) {
+                    state.census.saturated = true;
+                }
+                state.commit_active = false;
+                state.render_active = false;
+            });
+            self.finished = true;
+        }
+    }
+}
+
+impl Drop for CommitScope {
+    fn drop(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.commit_errors, 1) {
+                    state.census.saturated = true;
+                }
+                state.commit_active = false;
+                state.render_active = false;
+            });
+        }
+    }
+}
+
+/// Scope for one post-render package capture.
+pub(crate) struct CaptureScope {
+    active: bool,
+    finished: bool,
+}
+
+pub(crate) fn begin_capture() -> CaptureScope {
+    let active = STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        if !state.session_active || !state.commit_active {
+            return false;
+        }
+        state.capture_active = true;
+        if add(&mut state.census.capture_attempted, 1) {
+            state.census.saturated = true;
+        }
+        true
+    });
+    CaptureScope {
+        active,
+        finished: false,
+    }
+}
+
+/// Scope for the main candidate renderer. Discovery can serialize selected
+/// objects later in the commit, so layout observations require this narrower
+/// phase in addition to the whole commit scope.
+pub(crate) struct RenderScope {
+    active: bool,
+}
+
+pub(crate) fn begin_render() -> RenderScope {
+    let active = STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        if !state.session_active || !state.commit_active || state.render_active {
+            return false;
+        }
+        state.render_active = true;
+        true
+    });
+    RenderScope { active }
+}
+
+impl Drop for RenderScope {
+    fn drop(&mut self) {
+        if self.active {
+            with_state(|state| {
+                state.render_active = false;
+            });
+        }
+    }
+}
+
+pub(crate) fn record_capture_stream(bytes: usize) {
+    STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        if !state.session_active || !state.commit_active || !state.capture_active {
+            return;
+        }
+        if add(&mut state.census.capture_streams, 1) {
+            state.census.saturated = true;
+        }
+        if add(&mut state.census.capture_payload_bytes, bytes as u64) {
+            state.census.saturated = true;
+        }
+    });
+}
+
+impl CaptureScope {
+    pub(crate) fn finish_success(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.capture_success, 1) {
+                    state.census.saturated = true;
+                }
+                state.capture_active = false;
+            });
+            self.finished = true;
+        }
+    }
+}
+
+impl Drop for CaptureScope {
+    fn drop(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.capture_error, 1) {
+                    state.census.saturated = true;
+                }
+                state.capture_active = false;
+            });
+        }
+    }
+}
+
+/// One serialization route observation.  An uncompleted scope records an
+/// error, including writer setup and write failures.
+pub(crate) struct LayoutScope {
+    active: bool,
+    finished: bool,
+}
+
+pub(crate) fn begin_layout() -> LayoutScope {
+    let active = STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        if !state.session_active || !state.commit_active || !state.render_active {
+            return false;
+        }
+        if add(&mut state.census.layout_attempted, 1) {
+            state.census.saturated = true;
+        }
+        true
+    });
+    LayoutScope {
+        active,
+        finished: false,
+    }
+}
+
+impl LayoutScope {
+    pub(crate) fn reused(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.layout_reuse_success, 1) {
+                    state.census.saturated = true;
+                }
+            });
+            self.finished = true;
+        }
+    }
+
+    pub(crate) fn non_reused(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.layout_non_reuse, 1) {
+                    state.census.saturated = true;
+                }
+            });
+            self.finished = true;
+        }
+    }
+
+    pub(crate) fn error(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.layout_error, 1) {
+                    state.census.saturated = true;
+                }
+            });
+            self.finished = true;
+        }
+    }
+}
+
+impl Drop for LayoutScope {
+    fn drop(&mut self) {
+        if self.active && !self.finished {
+            with_state(|state| {
+                if add(&mut state.census.layout_error, 1) {
+                    state.census.saturated = true;
+                }
+            });
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{begin, begin_commit, begin_layout, begin_render};
+
+    #[test]
+    fn census_resets_and_balances_success() {
+        let session = begin();
+        let mut commit = begin_commit();
+        commit.overlay_not_attempted();
+        commit.finish_success();
+        let census = session.finish();
+        assert_eq!(census.commit_attempts, 1);
+        assert_eq!(census.commit_successes, 1);
+        assert_eq!(census.commit_errors, 0);
+        assert_eq!(census.overlay_not_attempted, 1);
+
+        let session = begin();
+        let census = session.finish();
+        assert_eq!(census, super::Census::default());
+    }
+
+    #[test]
+    fn abandoned_commit_is_an_error() {
+        let session = begin();
+        {
+            let _commit = begin_commit();
+        }
+        let census = session.finish();
+        assert_eq!(census.commit_attempts, 1);
+        assert_eq!(census.commit_errors, 1);
+    }
+
+    #[test]
+    fn layout_requires_the_narrow_render_phase() {
+        let session = begin();
+        let mut commit = begin_commit();
+        let _render = begin_render();
+        let mut layout = begin_layout();
+        layout.non_reused();
+        commit.finish_success();
+        let census = session.finish();
+        assert_eq!(census.layout_attempted, 1);
+        assert_eq!(census.layout_non_reuse, 1);
+
+        let session = begin();
+        let mut commit = begin_commit();
+        let mut layout = begin_layout();
+        layout.error();
+        commit.finish_success();
+        let census = session.finish();
+        assert_eq!(census.layout_attempted, 0);
+        assert_eq!(census.layout_error, 0);
+    }
+}
