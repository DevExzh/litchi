+    #[test]
+    fn lazy_attribute_decode_matches_fresh_lookup_for_cached_and_scanned_hits() {
+        let presentation_uri =
+            std::str::from_utf8(PRESENTATION_NAMESPACE).expect("presentation namespace is UTF-8");
+        let xml = format!(
+            "<e xmlns:d=\"{}\" xmlns:p=\"{presentation_uri}\" \
+             p:bad=\"&bogus;\" d:good=\"ok\" d:bad=\"&bogus;\"/>",
+            draw_uri()
+        );
+        let mut reader = NsReader::from_str(&xml);
+        let mut buf = Vec::new();
+        let element = first_element(&mut reader, &mut buf);
+        let mut attributes = ElementAttrs::new(&element);
+
+        // The invalid foreign-namespace value is scanned but must not be
+        // decoded while looking up the valid drawing attribute.
+        assert_eq!(
+            attributes.get(&reader, DRAW_NAMESPACE, b"good").unwrap(),
+            Some("ok".to_string())
+        );
+
+        // The first invalid value is now cached; the second is reached by the
+        // shared iterator. Both errors must match independent one-shot scans.
+        let cached_error =
+            invalid_format_message(attributes.get(&reader, PRESENTATION_NAMESPACE, b"bad"));
+        let scanned_error = invalid_format_message(attributes.get(&reader, DRAW_NAMESPACE, b"bad"));
+        let fresh_cached_error = invalid_format_message(direct_lookup(
+            &reader,
+            &element,
+            PRESENTATION_NAMESPACE,
+            b"bad",
+        ));
+        let fresh_scanned_error =
+            invalid_format_message(direct_lookup(&reader, &element, DRAW_NAMESPACE, b"bad"));
+        assert_eq!(cached_error, fresh_cached_error);
+        assert_eq!(scanned_error, fresh_scanned_error);
+        assert!(cached_error.starts_with("invalid XML attribute value:"));
+        // A cached decode failure remains replayable, while a failure reached
+        // by the shared iterator retains the historical advance-without-cache
+        // behavior. This is part of the lazy lookup state machine.
+        assert_eq!(
+            invalid_format_message(attributes.get(&reader, PRESENTATION_NAMESPACE, b"bad",)),
+            cached_error
+        );
+        assert_eq!(
+            attributes.get(&reader, DRAW_NAMESPACE, b"bad").unwrap(),
+            None
         );
     }
 
