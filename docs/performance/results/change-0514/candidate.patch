+    /// Parse a cold worksheet while retaining a transaction-local snapshot
+    /// layout for an ordinary grid rewrite.
+    ///
+    /// The semantic store remains the only published cache value. A populated
+    /// cache takes the same fast path as [`Self::store`] and does not start a
+    /// second parser or scanner. The returned layout is valid only for the
+    /// exact source allocation that the transaction later supplies to its
+    /// rewrite boundary.
+    pub(super) fn store_with_layout(
+        &self,
+    ) -> Result<(&Store, Option<raw::worksheet::DeferredLayout>)> {
+        if self.data.kind != WorksheetKind::Worksheet {
+            return Err(Error::NotWorksheet {
+                sheet: self.data.name.clone(),
+            });
+        }
+        if let Some(store) = self.data.cells.get() {
+            return Ok((store, None));
