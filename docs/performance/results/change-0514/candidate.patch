+        panic!("expected expanded shared formula")
+    };
+    assert_eq!(formula.text(), "C1+$C$1");
+
+    let layout = deferred.layout.as_ref().expect("ordinary source layout");
+    assert_eq!(
+        layout.sheet_data.rows[0]
