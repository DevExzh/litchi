+/// Ephemeral source layout observation for one semantic parse.
+///
+/// The layout is retained only for the transaction that parsed this exact
+/// source blob. It is never placed in the worksheet's persistent semantic
+/// cache; a scanner failure is carried until an effective ordinary rewrite
+/// reaches the same boundary at which the old separate scan would fail.
+pub(crate) struct DeferredLayout {
+    source: Arc<Vec<u8>>,
+    layout: Option<edit::Layout>,
+    snapshot_error: Option<Error>,
+}
+
+impl DeferredLayout {
+    pub(crate) fn rewrite(
+        &mut self,
+        content: &[u8],
+        sheet: &str,
+        plan: edit::Plan,
+    ) -> Result<Vec<u8>> {
+        if plan.is_empty() {
+            self.layout = None;
+            self.snapshot_error = None;
+            return Ok(content.to_vec());
+        }
+        if !same_source(&self.source, content) {
+            self.layout = None;
+            self.snapshot_error = None;
+            return edit::rewrite(content, sheet, plan);
+        }
+        if let Some(error) = self.snapshot_error.take() {
+            self.layout = None;
+            return Err(error);
+        }
+        match self.layout.take() {
+            Some(layout) => edit::rewrite_with_layout(content, sheet, plan, layout),
+            None => edit::rewrite(content, sheet, plan),
+        }
+    }
+}
+
+fn same_source(source: &Arc<Vec<u8>>, content: &[u8]) -> bool {
+    let source = source.as_slice();
+    source.as_ptr() == content.as_ptr() && source.len() == content.len()
+}
+
+/// Parse an immutable worksheet source while conditionally collecting its
+/// lossless rewrite layout in the same namespace-aware reader pass.
+pub(crate) fn parse_with_layout<'a, F>(
+    source: Arc<Vec<u8>>,
+    strings: F,
+) -> Result<(Store, DeferredLayout)>
+where
+    F: FnOnce() -> Result<Option<&'a [Text]>>,
+{
+    let needs_extension_capture = x14ac::may_contain_descent(source.as_slice());
+    let extensions = if needs_extension_capture {
+        x14ac::capture(source.as_slice())?
+    } else {
+        x14ac::Values::default()
+    };
+    let parsed = (|| {
+        let parse_source = Arc::clone(&source);
+        let processed = process_ooxml(parse_source.as_slice())?;
+        let borrowed = matches!(
+            &processed,
+            Cow::Borrowed(bytes)
+                if bytes.as_ptr() == parse_source.as_slice().as_ptr()
+                    && bytes.len() == parse_source.len()
+        );
+        let content = std::str::from_utf8(processed.as_ref())
+            .map_err(|error| invalid(format!("worksheet XML is not UTF-8: {error}")))?;
+        if borrowed {
+            let (store, layout, snapshot_error) =
+                model::Parser::parse_with_layout(content, strings, extensions)?;
+            Ok((
+                store,
+                DeferredLayout {
+                    source: parse_source,
+                    layout,
+                    snapshot_error,
+                },
+            ))
+        } else {
+            let store = model::Parser::parse(content, strings, extensions)?;
+            Ok((
+                store,
+                DeferredLayout {
+                    source: parse_source,
+                    layout: None,
+                    snapshot_error: None,
+                },
+            ))
+        }
+    })();
+
+    if parsed.is_err() && !needs_extension_capture {
+        // Keep the normal parser's extension-fallback precedence for semantic,
+        // preprocessing, and UTF-8 errors. A deferred snapshot error only
+        // exists on a successful semantic parse and therefore never reaches
+        // this fallback.
+        x14ac::capture(source.as_slice())?;
+    }
+    parsed
+}
