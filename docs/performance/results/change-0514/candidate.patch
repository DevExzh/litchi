+#[test]
+fn deferred_layout_falls_back_for_a_different_source_allocation() {
+    let source = source_fixture();
+    let (_, mut deferred) =
+        parse_with_layout(Arc::clone(&source), || Ok(None)).expect("fused worksheet parse");
+    let other = source.as_slice().to_vec();
