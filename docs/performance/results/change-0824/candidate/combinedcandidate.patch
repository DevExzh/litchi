+
+    fn assert_compacted(source: &[u8], expected: &[u8], root_unchanged: bool) -> Result<()> {
+        let compacted = compact_changed_slide_xml(source)?;
+        assert_eq!(compacted.xml, expected);
+        assert_eq!(compacted.root_unchanged, root_unchanged);
