+        let source_proof = audit_test_proof(malformed_source, malformed_source.len(), &[]);
+        let source_error = audit_splice(
+            &mut Cursor::new(malformed_source.as_slice()),
+            &mut io::sink(),
+            source_proof,
+            SplicePayloadRef::Fixed(&[]),
+            SpliceAuditMemoryLimits::unbounded(),
+            source_proof.source_len,
+            SourcePartSpliceLimits::default(),
+            "word/document.xml",
+            false,
+            SpliceAuditMode::for_target(true),
+            None,
+            None,
+        )
+        .expect_err("the initial source XML audit must reject malformed XML");
+        assert!(matches!(source_error, OpcError::XmlPublication { .. }));
+
+        let source = b"<root></root>";
