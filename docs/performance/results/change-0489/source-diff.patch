+    fn audit_test_proof(
+        source: &[u8],
+        insertion_offset: usize,
+        fragment: &[u8],
+    ) -> SourcePartSpliceProof {
+        let mut candidate = Vec::with_capacity(source.len() + fragment.len());
+        candidate.extend_from_slice(&source[..insertion_offset]);
+        candidate.extend_from_slice(fragment);
+        candidate.extend_from_slice(&source[insertion_offset..]);
+        SourcePartSpliceProof {
+            source_version: SourceVersion::new(0x00A1_1D17, 1),
+            source_len: source.len() as u64,
+            source_sha256: digest_bytes(source),
+            insertion_offset: insertion_offset as u64,
+            fragment_len: fragment.len() as u64,
+            fragment_sha256: digest_bytes(fragment),
+            candidate_len: candidate.len() as u64,
+            candidate_sha256: digest_bytes(&candidate),
+        }
+    }
+
+    #[test]
