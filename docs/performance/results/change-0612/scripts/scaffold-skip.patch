+    /// MEASUREMENT SCAFFOLD (change 0612): makes `[0, end)` addressable
+    /// without fetching `[filled, end)`.
+    ///
+    /// The allocation and the zero-fill are exactly what `ensure` would have
+    /// done; only the `read_stream_range_hinted` call is skipped, and the
+    /// fill target resets so the next window does not read straight back over
+    /// the payload that follows.
+    fn advance_without_reading(&mut self, end: u64) -> Result<()> {
+        if end <= self.filled {
+            return Ok(());
+        }
+        let finish = usize::try_from(end).map_err(|_error| SourceBackedError::ResourceLimit {
+            resource: "global address space",
+            observed: end,
+            maximum: usize::MAX as u64,
+        })?;
+        let resident = self.bytes.len();
+        self.bytes
+            .try_reserve_exact(finish - resident)
+            .map_err(|_error| SourceBackedError::Allocation {
+                resource: "workbook globals buffer",
+                requested: finish as u64,
+            })?;
+        self.bytes.resize(finish, 0);
+        self.filled = end;
+        self.window = GLOBALS_FIRST_WINDOW_BYTES;
+        Ok(())
+    }
