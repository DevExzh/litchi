+// ---------------------------------------------------------------------------
+// MEASUREMENT SCAFFOLD for change 0612. NOT A CANDIDATE. Applied, built,
+// measured and reverted; see docs/performance/results/change-0612/.
+//
+// It changes only *which stream bytes are read* by the globals scan. The
+// buffer keeps today's shape -- one contiguous `[0, global_end)` allocation,
+// zero-filled in full -- so the allocation, the zero-fill, the framing and
+// every semantic output are byte-identical to the base. A payload the
+// semantic pass never interprets, at or above the gate, is simply not
+// fetched; the buffer keeps zeros there and nothing ever reads them.
+//
+// So this prices the read term exactly (fewer bytes copied out of the CFB,
+// more read requests) and prices *none* of the three further savings a real
+// candidate would take: the zero-fill of the skipped bytes, the retained
+// allocation, and the second framing of the skipped records. It is a lower
+// bound on the benefit and an exact price of the cost.
+/// Smallest uninterpreted payload the scaffold passes without reading.
+const GLOBALS_SKIP_MIN_PAYLOAD: u64 = 1024;
+
+/// Whether the semantic globals pass reads this record's payload.
+///
+/// `parse_globals` consumes `BOF`, `EOF`, `FilePass`, `CodePage`,
+/// `BoundSheet8`, `SST` and the `Continue` run that follows an `SST`;
+/// `Formatting::parse_globals` consumes `Date1904`, `Format`, `XF`, `XFCRC`,
+/// `XFExt` and `DXF`.
+const fn globals_payload_is_consumed(kind: u16, in_sst_run: bool) -> bool {
+    matches!(
+        kind,
+        BOF | EOF
+            | FILEPASS
+            | CODEPAGE
+            | BOUND_SHEET
+            | SST
+            | 0x0022
+            | 0x041E
+            | 0x00E0
+            | 0x087C
+            | 0x087D
+            | 0x088D
+    ) || (kind == CONTINUE && in_sst_run)
+}
