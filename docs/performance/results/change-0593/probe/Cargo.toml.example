# Manifest template for the scratch publication probe retained in `src/`.
#
# Build one copy per leg, each with its own `CARGO_TARGET_DIR`, pointing the
# path dependency at that leg's checkout:
#
#   litchi-opc = { path = "<checkout>/crates/litchi-opc" }
#
# `--locked` is not used: the probe is a fresh crate with no lockfile of its
# own. Both legs resolve the same dependency versions through the same path
# dependency, and the release profile below mirrors the workspace's.

[package]
name = "opc-save-probe"
version = "0.0.1"
edition = "2024"

[dependencies]
litchi-opc = { path = "REPLACE_WITH_CHECKOUT/crates/litchi-opc" }
sha2 = "0.10"

[profile.release]
lto = true
panic = "abort"
