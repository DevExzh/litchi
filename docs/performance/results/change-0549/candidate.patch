+    /// Test and set one bit while preserving fallible bounds diagnostics.
+    ///
+    /// The combined operation keeps the old word available for the result and
+    /// performs one checked word lookup for the hot exact-chain walk. Writing
+    /// the same word when a bit was already set is unobservable for this set;
+    /// it also leaves the operation open to lowering as a bit-test-and-set.
+    #[inline]
+    fn test_and_mark(&mut self, bit: usize) -> Result<bool, OleError> {
+        if bit >= self.bit_len {
+            return Err(OleError::CorruptedFile(format!(
+                "bit index {bit} exceeds checked bit-set capacity {}",
+                self.bit_len
+            )));
+        }
+        let word = bit / BITSET_WORD_BITS;
+        let mask = 1u64 << (bit % BITSET_WORD_BITS);
+        let value = self.words.get_mut(word).ok_or_else(|| {
+            OleError::CorruptedFile(format!("bit index {bit} has no backing word"))
+        })?;
+        let old_word = *value;
+        let new_word = old_word | mask;
+        *value = new_word;
+        Ok(old_word & mask != 0)
+    }
