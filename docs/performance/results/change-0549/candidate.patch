+    fn enumerate_exhaustive_chain_tables(
+        table: &mut [u32],
+        values: &[u32],
+        depth: usize,
+        scratch: &mut SectorChainScratch,
+    ) {
+        if depth < table.len() {
+            for &value in values {
+                table[depth] = value;
+                enumerate_exhaustive_chain_tables(table, values, depth + 1, scratch);
+            }
+            return;
+        }
+
+        for &start_sector in values {
+            for expected_count in 0..=table.len() + 1 {
+                let expected =
+                    collect_sector_chain_exact(table, start_sector, expected_count, "exhaustive")
+                        .map_err(|error| error.to_string());
+                let actual_result =
+                    scratch.collect_exact(table, start_sector, expected_count, "exhaustive");
+                let actual = actual_result
+                    .map(|()| scratch.sectors().to_vec())
+                    .map_err(|error| error.to_string());
+
+                assert_eq!(
+                    actual, expected,
+                    "table {table:?}, start {start_sector}, count {expected_count}"
+                );
+                match expected {
+                    Ok(sectors) => {
+                        assert_eq!(scratch.sectors(), sectors.as_slice());
+                        if expected_count == 0 {
+                            assert_eq!(scratch.visited.bit_len, 0);
+                        } else {
+                            assert_eq!(scratch.visited.bit_len, table.len());
+                            for &sector in &sectors {
+                                let slot = usize::try_from(sector).unwrap();
+                                assert!(scratch.visited.contains(slot));
+                            }
+                        }
+                    },
+                    Err(_) => {
+                        assert!(scratch.sectors.is_empty());
+                        assert_eq!(scratch.visited.bit_len, 0);
+                    },
+                }
+            }
+        }
+    }
