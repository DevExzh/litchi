     #[test]
+    fn checked_bit_set_test_and_mark_reports_presence_at_word_boundaries() {
+        let mut bits = CheckedBitSet::try_with_capacity(BITSET_WORD_BITS + 1, "test").unwrap();
+        let words_ptr = bits.words.as_ptr();
+        let words_capacity = bits.words.capacity();
+
+        assert!(!bits.test_and_mark(0).unwrap());
+        assert!(bits.test_and_mark(0).unwrap());
+        assert!(!bits.test_and_mark(BITSET_WORD_BITS - 1).unwrap());
+        assert!(bits.test_and_mark(BITSET_WORD_BITS - 1).unwrap());
+        assert!(!bits.test_and_mark(BITSET_WORD_BITS).unwrap());
+        assert!(bits.test_and_mark(BITSET_WORD_BITS).unwrap());
+        assert_eq!(bits.words[0], 1 | (1u64 << (BITSET_WORD_BITS - 1)));
+        assert_eq!(bits.words[1], 1);
+        assert_eq!(bits.words.as_ptr(), words_ptr);
+        assert_eq!(bits.words.capacity(), words_capacity);
+
+        let out_of_bounds = bits.test_and_mark(bits.bit_len);
+        assert!(matches!(
+            out_of_bounds,
+            Err(OleError::CorruptedFile(message))
+                if message == "bit index 65 exceeds checked bit-set capacity 65"
+        ));
+        assert_eq!(bits.words.as_ptr(), words_ptr);
+        assert_eq!(bits.words.capacity(), words_capacity);
+    }
+
+    #[test]
+    fn checked_bit_set_test_and_mark_preserves_missing_backing_word_without_growth() {
+        let mut bits = CheckedBitSet {
+            words: vec![0],
+            bit_len: BITSET_WORD_BITS + 1,
+        };
+        let words_ptr = bits.words.as_ptr();
+        let words_capacity = bits.words.capacity();
+
+        let missing_word = bits.test_and_mark(BITSET_WORD_BITS);
+        assert!(matches!(
+            missing_word,
+            Err(OleError::CorruptedFile(message))
+                if message == "bit index 64 has no backing word"
+        ));
+        assert_eq!(bits.words, vec![0]);
+        assert_eq!(bits.words.as_ptr(), words_ptr);
+        assert_eq!(bits.words.capacity(), words_capacity);
+
+        let out_of_bounds = bits.test_and_mark(bits.bit_len);
+        assert!(matches!(
+            out_of_bounds,
+            Err(OleError::CorruptedFile(message))
+                if message == "bit index 65 exceeds checked bit-set capacity 65"
+        ));
+        assert_eq!(bits.words.as_ptr(), words_ptr);
+        assert_eq!(bits.words.capacity(), words_capacity);
+    }
