+#[test]
+fn start_attribute_storage_keeps_inline_and_spilled_order_and_refusal_precedence() {
+    let inline = format!(
+        r#"<r xmlns:mc="{NAMESPACE}"><a first="1" second="x&#9;y" p:third="3" xmlns:p="urn:p"/></r>"#
+    );
+    let inline_output = String::from_utf8(tree_result(&inline).expect("inline attributes fit"))
+        .expect("tree output remains UTF-8");
+    assert_eq!(
+        inline_output,
+        format!(
+            r#"<r xmlns:mc="{NAMESPACE}"><a first="1" second="x&#x9;y" p:third="3" xmlns:p="urn:p"></a></r>"#
+        )
+    );
+
+    let spilled = format!(
+        r#"<r xmlns:mc="{NAMESPACE}"><a first="1" second="x&#9;y" p:third="3" xmlns:p="urn:p" p:fourth="4"/></r>"#
+    );
+    let spilled_output = String::from_utf8(tree_result(&spilled).expect("spilled attributes fit"))
+        .expect("tree output remains UTF-8");
+    assert_eq!(
+        spilled_output,
+        format!(
+            r#"<r xmlns:mc="{NAMESPACE}"><a first="1" second="x&#x9;y" p:third="3" xmlns:p="urn:p" p:fourth="4"></a></r>"#
+        )
+    );
+
+    // Five source attributes force the spill path. Expanded-name duplicate
+    // validation still runs before the later unknown-directive refusal.
+    let duplicate = format!(
+        r#"<r xmlns:mc="{NAMESPACE}"><a xmlns:x="urn:shared" xmlns:y="urn:shared" x:k="one" y:k="two" mc:NotARealDirective="1"/></r>"#
+    );
+    assert!(matches!(
+        tree_result(&duplicate),
+        Err(Error::NonConformant(message)) if message == "duplicate attribute"
+    ));
+}
