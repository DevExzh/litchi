+/// The attributes of one start tag.
+///
+/// Most OOXML elements have only a few attributes. Keep those attributes in a
+/// fixed, contiguous stack buffer and retain the existing fallible `Vec`
+/// growth path for larger tags. The inline representation deliberately uses
+/// initialized placeholders instead of `MaybeUninit`, so the adapter remains
+/// safe and can expose the same slices as the old vector.
+struct AttrBuffer<'a> {
+    values: [Attr<'a>; INLINE_ATTRIBUTE_CAPACITY],
+    len: usize,
+    spilled: Vec<Attr<'a>>,
+}
+
+const INLINE_ATTRIBUTE_CAPACITY: usize = 4;
+const ATTRIBUTES_RESOURCE: &str = "MCE attributes";
+
+impl<'a> AttrBuffer<'a> {
+    fn new() -> Self {
+        Self {
+            values: std::array::from_fn(|_| Attr::vacant()),
+            len: 0,
+            spilled: Vec::new(),
+        }
+    }
+
+    /// Reserve the next slot before decoding the source attribute.
+    ///
+    /// The caller intentionally invokes this before UTF-8 and value
+    /// normalization, matching the old `Vec` path's error precedence.
+    fn prepare_push(&mut self) -> R<()> {
+        if !self.spilled.is_empty() {
+            reserve_amortized(&mut self.spilled, 1, ATTRIBUTES_RESOURCE)?;
+            return Ok(());
+        }
+        if self.len < INLINE_ATTRIBUTE_CAPACITY {
+            return Ok(());
+        }
+
+        // Reserve before moving the inline values. If reservation fails, the
+        // buffer remains intact and the allocator error keeps the old source
+        // and resource identity.
+        let inline_len = self.len;
+        reserve_amortized(&mut self.spilled, inline_len + 1, ATTRIBUTES_RESOURCE)?;
+        for value in &mut self.values[..inline_len] {
+            self.spilled.push(std::mem::replace(value, Attr::vacant()));
+        }
+        self.len = 0;
+        Ok(())
+    }
+
+    /// Insert an attribute after [`Self::prepare_push`] succeeded.
+    fn push_prepared(&mut self, attribute: Attr<'a>) {
+        if !self.spilled.is_empty() {
+            debug_assert!(self.spilled.len() < self.spilled.capacity());
+            self.spilled.push(attribute);
+        } else {
+            debug_assert!(self.len < INLINE_ATTRIBUTE_CAPACITY);
+            self.values[self.len] = attribute;
+            self.len += 1;
+        }
+    }
+
+    fn as_slice(&self) -> &[Attr<'a>] {
+        if self.spilled.is_empty() {
+            &self.values[..self.len]
+        } else {
+            &self.spilled
+        }
+    }
+
+    fn as_mut_slice(&mut self) -> &mut [Attr<'a>] {
+        if !self.spilled.is_empty() {
+            self.spilled.as_mut_slice()
+        } else {
+            &mut self.values[..self.len]
+        }
+    }
+}
+
+impl<'a> Attr<'a> {
+    fn vacant() -> Self {
+        Self {
+            key: "",
+            value: Cow::Borrowed(""),
+            keep: false,
+        }
+    }
+}
+
+#[cfg(test)]
+mod attr_buffer_tests {
+    use super::{Attr, AttrBuffer};
+    use std::borrow::Cow;
+
+    #[test]
+    fn keeps_zero_one_four_five_and_larger_tags_in_source_order() {
+        let mut attributes = AttrBuffer::new();
+        assert!(attributes.as_slice().is_empty());
+
+        for (index, key) in ["zero", "one", "two", "three", "four", "five"]
+            .into_iter()
+            .enumerate()
+        {
+            attributes
+                .prepare_push()
+                .expect("bounded attribute reserve");
+            attributes.push_prepared(Attr {
+                key,
+                value: Cow::Borrowed("value"),
+                keep: true,
+            });
+            assert_eq!(attributes.as_slice().len(), index + 1);
+            if index == 3 {
+                assert!(attributes.spilled.is_empty());
+            }
+            if index == 4 {
+                assert!(!attributes.spilled.is_empty());
+            }
+        }
+
+        assert_eq!(
+            attributes
+                .as_slice()
+                .iter()
+                .map(|attribute| attribute.key)
+                .collect::<Vec<_>>(),
+            ["zero", "one", "two", "three", "four", "five"]
+        );
+    }
+}
