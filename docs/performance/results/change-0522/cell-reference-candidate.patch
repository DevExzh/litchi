+
+/// Decode the unqualified cell reference once and prove whether the raw
+/// element can use the compact cell-tag representation. The checked attribute
+/// iteration, error mapping, and reference decode order mirror
+/// `unqualified_attribute_value`; the raw-name proof lets callers elide the
+/// second `cell_tag` scan only for an unprefixed `c` with no attributes or one
+/// unqualified `r` attribute.
+fn cell_reference<'a>(
+    element: &'a BytesStart<'_>,
+    decoder: Decoder,
+) -> Result<(Option<Cow<'a, str>>, bool)> {
+    let mut value: Option<Cow<'a, str>> = None;
+    let mut plain = element.name().as_ref() == b"c";
+    for attribute in element.attributes() {
+        let attribute = attribute.map_err(|error| XmlError::Malformed(error.to_string()))?;
+        plain &= attribute.key.as_ref() == b"r";
+        if attribute.key.prefix().is_none() && attribute.key.local_name().as_ref() == b"r" {
+            if value.is_some() {
+                return Err(XmlError::Invalid(format!(
+                    "duplicate XML attribute '{}'",
+                    String::from_utf8_lossy(b"r")
+                ))
+                .into());
+            }
+            value = Some(
+                attribute
+                    .decoded_and_normalized_value(XmlVersion::Explicit1_0, decoder)
+                    .map_err(|error| XmlError::Malformed(error.to_string()))?,
+            );
+        }
+    }
+    Ok((value, plain))
 }
 
