#!/usr/bin/env python3
"""Validate and compare the 0557 matched XLSX measurements.

The driver and the Rust binary own execution and serialization.  This module
only consumes their retained JSON artifacts.  It performs the baseline noise
calculation, validates the four-stage matched matrix, and emits a deterministic
report.  No build, benchmark, or external command is run here.

``--noise-only`` is useful immediately after the required baseline pilot.  The
normal invocation requires the complete noise, native, and allocator matrix.
"""

from __future__ import annotations

import argparse
import datetime as _datetime
import hashlib
import importlib.util
import json
import math
import re
import sys
from pathlib import Path
from typing import Any


