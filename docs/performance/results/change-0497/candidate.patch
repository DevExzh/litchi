+fn default_route_omits_the_publication_extension_and_keeps_hashing_sink_shape() {
+    let case = run_case(
+        2,
+        1,
+        ChunkMode::Fixed64,
+        TextMode::Short,
+        &config(
+            PublicationMode::HashingSink,
+            AuthoredProvider::Deterministic,
+            None,
+        ),
