+const FORMATTED_DOCUMENT: &[u8] = br#"<?xml version="1.0" encoding="UTF-8"?>
+<document>
+  <before attr="one"/>
+  <!--keep-->
+  <nested>
+    <leaf/>
+  </nested>
+</document>
+"#;
