+    #[test]
+    fn checked_bit_set_test_and_set_matches_insert_at_word_boundaries() {
+        for bit_len in [0usize, 1, 63, 64, 65, 127, 128, 129, 130] {
+            let mut expected =
+                CheckedBitSet::try_with_capacity(bit_len, "expected bit set").unwrap();
+            let mut actual = CheckedBitSet::try_with_capacity(bit_len, "actual bit set").unwrap();
+
+            for bit in 0..bit_len {
+                let expected_was_set = expected.contains(bit);
+                expected.insert(bit).unwrap();
+                assert_eq!(
+                    actual.test_and_set(bit).unwrap(),
+                    expected_was_set,
+                    "first visit at bit {bit} with bit length {bit_len}"
+                );
+                assert_eq!(actual.contains(bit), expected.contains(bit));
+            }
+            for bit in (0..bit_len).rev() {
+                let expected_was_set = expected.contains(bit);
+                expected.insert(bit).unwrap();
+                assert_eq!(
+                    actual.test_and_set(bit).unwrap(),
+                    expected_was_set,
+                    "repeat visit at bit {bit} with bit length {bit_len}"
+                );
+                assert_eq!(actual.contains(bit), expected.contains(bit));
+            }
+
+            assert_eq!(actual.words, expected.words);
+            assert_eq!(actual.bit_len, expected.bit_len);
+        }
+    }
