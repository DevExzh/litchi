+    #[test]
+    fn checked_bit_set_test_and_set_preserves_state_on_bounds_error() {
+        let mut expected = CheckedBitSet::try_with_capacity(65, "expected bit set").unwrap();
+        let mut actual = CheckedBitSet::try_with_capacity(65, "actual bit set").unwrap();
+        expected.insert(0).unwrap();
+        actual.test_and_set(0).unwrap();
+        expected.insert(64).unwrap();
+        actual.test_and_set(64).unwrap();
+        let words_before = actual.words.clone();
+        let bit_len_before = actual.bit_len;
+
+        let expected_error = expected
+            .insert(65)
+            .expect_err("the old insertion helper must reject an out-of-range bit")
+            .to_string();
+        let actual_error = actual
+            .test_and_set(65)
+            .expect_err("the fused helper must reject an out-of-range bit")
+            .to_string();
+
+        assert_eq!(actual_error, expected_error);
+        assert_eq!(actual.words, words_before);
+        assert_eq!(actual.bit_len, bit_len_before);
+        assert!(actual.contains(0));
+        assert!(actual.contains(64));
+    }
