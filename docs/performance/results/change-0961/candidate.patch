+#[test]
+fn multi_sheet_staging_accepts_empty_and_unknown_hint_iterators() {
+    let mut edit = editor(&worksheet("", ""), &PackageShape::default())
+        .expect("fixture editor")
+        .edit_sheets(["Sheet1".into()])
+        .expect("selected worksheet");
+    edit.apply_batch(HintedBatch::new(
+        Vec::<SheetCellValueEdit<'static>>::new(),
+        Some(0),
+    ))
+    .expect("empty batch");
+    assert!(edit.is_empty());
+
+    edit.apply_batch(HintedBatch::new(
+        vec![SheetCellValueEdit::set(
+            "Sheet1",
+            Address::from_a1("A1").expect("A1"),
+            2u32,
+        )],
+        Some(0),
+    ))
+    .expect("a nonempty zero upper bound must grow fallibly");
+    assert_eq!(edit.len(), 1);
+
+    edit.apply_batch(HintedBatch::new(
+        vec![SheetCellValueEdit::set(
+            "Sheet1",
+            Address::from_a1("B1").expect("B1"),
+            3u32,
+        )],
+        None,
+    ))
+    .expect("unknown upper bound remains valid");
+    assert_eq!(edit.len(), 2);
+}
