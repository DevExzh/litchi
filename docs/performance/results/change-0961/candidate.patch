+#[test]
+fn multi_sheet_staging_duplicate_and_late_failure_roll_back_pending_values() {
+    let mut edit = editor(&worksheet("", ""), &PackageShape::default())
+        .expect("fixture editor")
+        .edit_sheets(["Sheet1".into()])
+        .expect("selected worksheet");
+    let duplicate = edit.apply_batch(HintedBatch::new(
+        vec![
+            SheetCellValueEdit::set("Sheet1", Address::from_a1("A1").expect("A1"), 2u32),
+            SheetCellValueEdit::set("Sheet1", Address::from_a1("A1").expect("A1"), 3u32),
+        ],
+        Some(2),
+    ));
+    assert!(matches!(
+        duplicate,
+        Err(Error::Invalid(message))
+            if message == "duplicate multi-sheet value-only selector '0:A1'"
+    ));
+    assert!(edit.is_empty());
+
+    edit.set("Sheet1", Address::from_a1("A1").expect("A1"), 2u32)
+        .expect("preexisting staged value");
+    assert_eq!(edit.len(), 1);
+    let late_failure = edit.apply_batch(HintedBatch::new(
+        vec![
+            SheetCellValueEdit::set("Sheet1", Address::from_a1("B1").expect("B1"), 3u32),
+            SheetCellValueEdit::insert(
+                "Sheet1",
+                Address::from_a1("C1").expect("C1"),
+                Number::new("4").expect("numeral"),
+            ),
+            SheetCellValueEdit::set("Sheet1", Address::from_a1("Z99").expect("Z99"), 5u32),
+        ],
+        Some(1),
+    ));
+    assert!(matches!(
+        late_failure,
+        Err(Error::Invalid(message))
+            if message == "cell selector 'Sheet1!Z99' has no existing cell owner"
+    ));
+    assert_eq!(edit.len(), 1, "preexisting staging must survive rollback");
+}
