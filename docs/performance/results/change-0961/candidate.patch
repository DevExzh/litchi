+#[test]
+fn multi_sheet_staging_grows_after_an_underreported_upper_bound() {
+    let mut edit = editor(&worksheet("", ""), &PackageShape::default())
+        .expect("fixture editor")
+        .edit_sheets(["Sheet1".into()])
+        .expect("selected worksheet");
+    let edits = vec![
+        SheetCellValueEdit::set("Sheet1", Address::from_a1("A1").expect("A1"), 2u32),
+        SheetCellValueEdit::set("Sheet1", Address::from_a1("B1").expect("B1"), 3u32),
+    ];
+    // This deliberately violates Iterator's upper-bound promise.  The
+    // staging path treats the hint as a performance input, never as a
+    // correctness boundary.
+    edit.apply_batch(HintedBatch::new(edits, Some(1)))
+        .expect("a lying upper bound must not affect correctness");
+    assert_eq!(edit.len(), 2);
+}
