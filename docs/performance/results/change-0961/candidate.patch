+#[test]
+fn multi_sheet_staging_over_limit_refuses_before_hint_growth_and_rolls_back() {
+    let mut rows = String::new();
+    for row in 1..=MAX_BATCH_EDITS + 1 {
+        rows.push_str(&format!(
+            r#"<row r="{row}"><c r="A{row}"><v>{row}</v></c></row>"#
+        ));
+    }
+    let sheet = format!(
+        r#"<worksheet xmlns="{SML}"><dimension ref="A1:A257"/><sheetData>{rows}</sheetData></worksheet>"#
+    );
+    let mut edit = editor(&sheet, &PackageShape::default())
+        .expect("fixture editor")
+        .edit_sheets(["Sheet1".into()])
+        .expect("selected worksheet");
+    let edits = (1..=MAX_BATCH_EDITS + 1)
+        .map(|row| {
+            SheetCellValueEdit::set(
+                "Sheet1",
+                Address::from_a1(&format!("A{row}")).expect("address"),
+                0u32,
+            )
+        })
+        .collect::<Vec<_>>();
+    let result = edit.apply_batch(HintedBatch::new(edits, Some(MAX_BATCH_EDITS + 1)));
+    assert!(matches!(
+        result,
+        Err(Error::Invalid(message))
+            if message == format!("multi-sheet value-only batch exceeds {MAX_BATCH_EDITS} unique cells")
+    ));
+    assert!(edit.is_empty());
+}
