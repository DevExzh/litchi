+#[test]
+fn multi_sheet_staging_checks_cancellation_after_size_hint() {
+    let (editor, cancellation_source) =
+        cancellable_editor(&worksheet("", ""), &PackageShape::default())
+            .expect("cancellable fixture editor");
+    let mut edit = editor
+        .edit_sheets(["Sheet1".into()])
+        .expect("selected worksheet");
+    let result = edit.apply_batch(HintedBatch::cancelling_on_hint(
+        vec![SheetCellValueEdit::set(
+            "Sheet1",
+            Address::from_a1("A1").expect("A1"),
+            2u32,
+        )],
+        cancellation_source,
+    ));
+    assert!(matches!(result, Err(Error::Package(OpcError::Cancelled))));
+    assert!(edit.is_empty());
+}
