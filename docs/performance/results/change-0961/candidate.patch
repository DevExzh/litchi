+/// Iterator witness used to exercise the bounded staging reservation without
+/// relying on the standard library's truthful size hints.
+struct HintedBatch<T> {
+    items: std::vec::IntoIter<T>,
+    upper: Option<usize>,
+    cancel_on_hint: Option<CancellationSource>,
+}
+
+impl<T> HintedBatch<T> {
+    fn new(items: Vec<T>, upper: Option<usize>) -> Self {
+        Self {
+            items: items.into_iter(),
+            upper,
+            cancel_on_hint: None,
+        }
+    }
+
+    fn cancelling_on_hint(items: Vec<T>, cancellation_source: CancellationSource) -> Self {
+        Self {
+            items: items.into_iter(),
+            upper: Some(1),
+            cancel_on_hint: Some(cancellation_source),
+        }
+    }
+}
+
+impl<T> Iterator for HintedBatch<T> {
+    type Item = T;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.items.next()
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        if let Some(source) = &self.cancel_on_hint {
+            source.cancel();
+        }
+        (0, self.upper)
+    }
+}
