+fn cancellable_editor(
+    sheet: &str,
+    shape: &PackageShape,
+) -> Result<(SourceBackedEditor, CancellationSource), Error> {
+    let budget = Budget::root(
+        "xlsx-value-staging-admission-test",
+        Limits::new(u64::MAX, u64::MAX, u64::MAX, u64::MAX, u64::MAX, u64::MAX),
+    );
+    let (cancellation_source, cancellation) = CancellationSource::pair();
+    let execution_limits = ExecutionLimits::new(
+        NonZeroUsize::new(1).expect("one worker"),
+        NonZeroUsize::new(1).expect("one task"),
+        NonZeroU64::new(u64::MAX).expect("unbounded in-flight bytes"),
+        0,
+    )
+    .expect("execution limits");
+    let context = ExecutionContext::new(budget, cancellation, execution_limits);
+    let editor = SourceBackedEditor::from_read_at_with_execution_context(
+        Arc::new(OwnedSource::new(package(sheet, shape))),
+        ReadLimits::default(),
+        context,
+    )?;
+    Ok((editor, cancellation_source))
+}
