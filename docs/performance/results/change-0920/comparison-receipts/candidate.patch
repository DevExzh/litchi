+    /// Serializes this writer into an owned byte vector.
+    ///
+    /// When a source-backed sector-reuse plan is accepted, its already
+    /// validated exact output length is used for one fallible reservation
+    /// before emission.  The from-scratch fallback remains the same writer
+    /// path and retains its existing checked layout and sink semantics.
+    ///
+    /// # Errors
+    ///
+    /// Returns the same validation and allocation errors as [`Self::write_to`].
+    /// An accepted source-backed layout additionally reports a typed allocation
+    /// error if its checked output length cannot be reserved, before any owned
+    /// output bytes are emitted. The owned sink's final length is checked before
+    /// the successful sector-layout report is published.
+    pub fn write_to_vec(&mut self) -> Result<Vec<u8>, OleError> {
+        let mut output = Cursor::new(Vec::new());
+        self.write_to_with_reservation(
+            &mut output,
+            |sink, length| {
+                let capacity = usize::try_from(length).map_err(|_| {
+                    OleError::InvalidData("CFB output length exceeds usize".to_string())
+                })?;
+                sink.get_mut()
+                    .try_reserve_exact(capacity)
+                    .map_err(|source| OleError::allocation("CFB owned output", source))?;
+                Ok(())
+            },
+            |sink, expected| {
+                let actual = sink.seek(SeekFrom::End(0))?;
+                if actual != expected {
+                    return Err(OleError::InvalidData(
+                        "CFB owned output length differs from validated plan".to_string(),
+                    ));
+                }
+                Ok(())
+            },
+        )?;
+        Ok(output.into_inner())
+    }
