+use litchi_cfb::{OleWriter, SectorLayoutFallback};
+use std::io::Cursor;
+use std::sync::Arc;
+
+fn writer_model() -> OleWriter {
+    let mut writer = OleWriter::new();
+    writer
+        .create_storage(&["ObjectPool"])
+        .expect("storage path");
+    writer
+        .create_stream(&["WordDocument"], &[0x11; 8192])
+        .expect("large stream");
+    writer
+        .create_stream_shared(&["ObjectPool", "_101"], Arc::<[u8]>::from(vec![0x22; 177]))
+        .expect("mini stream");
+    writer
+}
+
+fn generic_bytes(mut writer: OleWriter) -> Vec<u8> {
+    let mut output = Cursor::new(Vec::new());
+    writer.write_to(&mut output).expect("generic serialization");
+    output.into_inner()
+}
+
+#[test]
+fn owned_output_matches_generic_from_scratch_fallback() {
+    let expected = generic_bytes(writer_model());
+    let actual = writer_model().write_to_vec().expect("owned serialization");
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn owned_output_matches_generic_after_reused_plan() {
+    let source = generic_bytes(writer_model());
+
+    let mut generic = writer_model();
+    assert!(generic.adopt_source_layout(&source).expect("adopt source"));
+    let expected = generic_bytes(generic);
+
+    let mut owned = writer_model();
+    assert!(owned.adopt_source_layout(&source).expect("adopt source"));
+    let actual = owned.write_to_vec().expect("owned serialization");
+    assert_eq!(actual, expected);
+    assert!(
+        owned
+            .last_sector_layout()
+            .expect("published layout report")
+            .reused_source_layout()
+    );
+}
+
+#[test]
+fn owned_output_matches_generic_when_reuse_declines() {
+    let source = generic_bytes(writer_model());
+
+    let mut generic = writer_model();
+    assert!(generic.adopt_source_layout(&source).expect("adopt source"));
+    generic
+        .create_stream(&["Added"], b"forces the from-scratch fallback")
+        .expect("new stream");
+    let expected = generic_bytes(generic);
+
+    let mut owned = writer_model();
+    assert!(owned.adopt_source_layout(&source).expect("adopt source"));
+    owned
+        .create_stream(&["Added"], b"forces the from-scratch fallback")
+        .expect("new stream");
+    let actual = owned.write_to_vec().expect("owned serialization");
+    assert_eq!(actual, expected);
+    let report = owned
+        .last_sector_layout()
+        .expect("published fallback report");
+    assert!(!report.reused_source_layout());
+    assert_eq!(
+        report.fallback(),
+        Some(SectorLayoutFallback::DirectoryShapeChanged)
+    );
+}
