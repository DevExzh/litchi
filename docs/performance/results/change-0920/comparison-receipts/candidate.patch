+    #[test]
+    fn owned_reservation_failure_is_typed_and_pre_emission() {
+        let mut writer = adopted_writer_for_reservation_tests();
+        let mut output = Cursor::new(Vec::new());
+        let result = writer.write_to_with_reservation(
+            &mut output,
+            |_, _| {
+                let mut probe = Vec::<u8>::new();
+                let source = probe.try_reserve(usize::MAX).unwrap_err();
+                Err(OleError::allocation("CFB owned output", source))
+            },
+            |_, _| Ok(()),
+        );
+
+        assert!(matches!(
+            result,
+            Err(OleError::Allocation {
+                resource: "CFB owned output",
