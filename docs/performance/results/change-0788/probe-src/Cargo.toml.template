[package]
name = "litchi-perf-execution"
version = "0.1.0"
edition = "2024"
publish = false

[features]
default = []
# Keep the observer build available for source-call parity diagnostics.  The
# native execution binary remains the frozen feature-off tool.
source-metrics = []

[[bin]]
name = "cached-part-memory"
path = "main.rs"

[dependencies]
litchi-cfb = { path = "@SRC@/crates/litchi-cfb", features = ["write"] }
litchi-core = { path = "@SRC@/crates/litchi-core" }
litchi-opc = { path = "@SRC@/crates/litchi-opc" }
rustix = { version = "1.1.4", default-features = false, features = ["time"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.11"
soapberry-zip = { path = "@SRC@/crates/soapberry-zip" }

# This is an independent evidence project. The build driver materializes the
# source-tree paths above and invokes Cargo with this manifest explicitly.
[workspace]

[profile.release]
opt-level = 3
debug = 1
lto = "thin"
codegen-units = 1
incremental = false
