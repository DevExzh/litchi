+#[cfg(test)]
+mod revision_scan_tests {
+    use super::*;
+    use crate::writer::{CharacterFormatting, ParagraphFormatting, TextRevision, Writer};
+    use std::io::Cursor;
+
+    fn revision_doc() -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer
+            .add_paragraph_runs(
+                vec![
+                    ("plain".to_owned(), CharacterFormatting::default()),
+                    (
+                        "inserted".to_owned(),
+                        CharacterFormatting {
+                            insertion_revision: Some(TextRevision::new("Alice")),
+                            ..CharacterFormatting::default()
+                        },
+                    ),
+                ],
+                ParagraphFormatting::default(),
+            )
+            .expect("revision fixture should be accepted");
+        let mut output = Cursor::new(Vec::new());
+        writer
+            .write_to(&mut output)
+            .expect("revision fixture should serialize");
+        output.into_inner()
+    }
+
+    #[test]
+    fn revision_scan_preserves_positive_metadata() {
+        let editor = RevisionEditor::open(revision_doc(), Limits::default())
+            .expect("revision fixture should open");
+        let revisions = editor.revisions().expect("revision scan should succeed");
+        assert!(revisions.iter().any(|revision| {
+            revision.kind == RevisionKind::Insertion && revision.author == "Alice"
+        }));
+    }
+
+    #[test]
+    fn revision_scan_reports_late_parse_error_before_metadata_error() {
+        let mut editor = RevisionEditor::open(revision_doc(), Limits::default())
+            .expect("revision fixture should open");
+        let mut malformed = Vec::new();
+        malformed.extend_from_slice(&SPRM_C_F_RMARK.to_le_bytes());
+        malformed.push(1);
+        malformed.extend_from_slice(&SPRM_C_IBST_RMARK.to_le_bytes());
+        malformed.extend_from_slice(&u16::MAX.to_le_bytes());
+        malformed.push(0x35); // A valid marker prefix followed by a truncated opcode.
+        editor.chpx[0].grpprl = malformed;
+
+        let error = editor
+            .revisions()
+            .expect_err("late malformed SPRM must be rejected");
+        let message = error.to_string();
+        assert!(message.contains("truncated SPRM opcode"), "{message}");
+        assert!(
+            !message.contains("revision author index exceeds SttbfRMark"),
+            "metadata must not run before whole-group validation: {message}"
+        );
+    }
+
+    #[test]
+    fn revision_scan_keeps_duplicate_property_marker_last_record_semantics() {
+        let mut editor = RevisionEditor::open(revision_doc(), Limits::default())
+            .expect("revision fixture should open");
+        let first = encode_revision(
+            RevisionKind::CharacterFormatting,
+            0,
+            &RevisionMetadata::new("Alice"),
+        )
+        .expect("character property marker should encode");
+        let mut disabled = first.clone();
+        disabled[3] = 0;
+        let mut duplicate = first;
+        duplicate.extend_from_slice(&disabled);
+        editor.chpx[0].grpprl = duplicate;
+
+        let revisions = editor.revisions().expect("duplicate markers should parse");
+        assert!(
+            !revisions
+                .iter()
+                .any(|revision| revision.kind == RevisionKind::CharacterFormatting)
+        );
+    }
+
+    #[test]
+    fn revision_scan_does_not_skip_late_errors_in_a_non_marker_group() {
+        let mut editor = RevisionEditor::open(revision_doc(), Limits::default())
+            .expect("revision fixture should open");
+        editor.chpx[0].grpprl = vec![0x35, 0x08, 1, 0x35];
+
+        let error = editor
+            .revisions()
+            .expect_err("strict parser errors must survive marker filtering");
+        assert!(error.to_string().contains("truncated SPRM opcode"));
+    }
+}
