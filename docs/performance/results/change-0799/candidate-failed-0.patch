+#[test]
+fn clone_matches_each_two_item_phase_boundary() {
+    let content = "e a=\"1\" b=\"2\" c=\"3\" d=\"4\"";
+    for advance in [0, 1, 2, 3, 4] {
+        let tag = tag(content);
+        let mut left = tag.checked_attributes();
+        for _ in 0..advance {
+            let _ = left.next();
+        }
+        let mut right = left.clone();
+        loop {
+            let left_item = left.next().map(owned);
+            let right_item = right.next().map(owned);
+            assert_eq!(left_item, right_item, "advance={advance}");
+            if left_item.is_none() {
+                break;
+            }
+        }
+        assert!(left.next().is_none(), "advance={advance}");
+        assert!(right.next().is_none(), "advance={advance}");
+    }
+}
