      "id": "validation-order",
      "severity": "pass",
      "summary": "Replacement and insertion retain their identity, removal, range, size, and complete-framing checks in the baseline order, with all typed refusals before editor mutation."
    },
    {
      "id": "post-validation-work",
      "severity": "pass",
      "summary": "After validation each function only transfers the owned Vec into BTreeMap::insert, updates the changed bool, and returns Ok; no fallible Result operation or publication work remains."
    },
    {
      "id": "allocation-and-panic-model",
      "severity": "advisory",
      "summary": "Map insertion can still encounter process-level allocation failure, as could the old clone path; the candidate neither promises panic recovery nor relabels this as Error::AllocationFailed."
    },
    {
      "id": "callsite-atomicity",
      "severity": "pass",
      "summary": "Public staging intentionally mutates its transaction-local Editor on success; traced internal callers use local or cloned candidates and preserve source publication atomicity when later typed work fails."
    },
    {
      "id": "focused-refusal-coverage",
      "severity": "pass",
      "summary": "Focused tests exercise unknown, removed, unavailable, too-short, malformed, trailing, and oversized refusals with exhaustive editor-state comparisons, plus successful old-transition and output-byte comparisons."
    }
  ],
