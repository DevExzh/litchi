+/// Replays every occurrence for one coordinate from a previously published
+/// worksheet index.  The index proves that the complete worksheet already
+/// validated, but each selected frame is still parsed and decoded here so
+/// target-specific XF, SST, and formula-STRING errors retain their original
+/// precedence.
+fn replay_indexed_cell(
+    owner: &Arc<SourceInner>,
+    sheet_index: usize,
+    index: &WorksheetCellIndex,
+    row: u16,
+    column: u16,
+    execution: Option<&ExecutionContext>,
+) -> Result<Option<SourceBackedCell>> {
+    if let Some(context) = execution {
+        context.check().map_err(SourceBackedError::from)?;
+    }
+    let sheet = owner
+        .sheets
+        .get(sheet_index)
+        .ok_or_else(|| SourceBackedError::WorksheetNotFound(sheet_index.to_string()))?;
+    let refs = owner
+        .workbook_path
+        .iter()
+        .map(String::as_str)
+        .collect::<Vec<_>>();
+    let mut strings = SharedStringResolver::new(owner, &refs);
+    let mut chain = owner.cfb.chain_hint();
+    let mut found = None;
+    for slot in index.slots_for(row, column) {
+        if let Some(context) = execution {
+            context.check().map_err(SourceBackedError::from)?;
+        }
+        let mut cursor = owner
+            .cfb
+            .stream_cursor_at_hinted(&refs, slot.stream_offset, &mut chain)
+            .map_err(SourceBackedError::from)?;
+        if let Some(value) =
+            replay_indexed_slot(owner, sheet.end, slot, &mut cursor, execution, &mut strings)?
+        {
+            found = Some(SourceBackedCell {
+                row: u32::from(row),
+                column: u32::from(column),
+                value,
+            });
+        }
+    }
+    if let Some(context) = execution {
+        context.check().map_err(SourceBackedError::from)?;
+    }
+    owner.ensure_current()?;
+    Ok(found)
+}
