+fn read_indexed_frame(
+    cursor: &mut SharedOleStreamCursor<'_>,
+    upper_bound: u64,
+) -> Result<(u16, Vec<u8>)> {
+    let offset = cursor.position();
+    if offset.checked_add(4).is_none_or(|end| end > upper_bound) {
+        return Err(SourceBackedError::InvalidData(
+            "indexed worksheet frame header exceeds its boundary".into(),
+        ));
+    }
+    let mut header = [0_u8; 4];
+    cursor
+        .read_exact(&mut header)
+        .map_err(SourceBackedError::from)?;
+    let kind = u16::from_le_bytes([header[0], header[1]]);
+    let payload_len = usize::from(u16::from_le_bytes([header[2], header[3]]));
+    if payload_len > litchi_biff::MAX_RECORD_BYTES {
+        return Err(SourceBackedError::ResourceLimit {
+            resource: "BIFF record bytes",
+            observed: payload_len as u64,
+            maximum: litchi_biff::MAX_RECORD_BYTES as u64,
+        });
+    }
+    let end = offset
+        .checked_add(4)
+        .and_then(|value| value.checked_add(payload_len as u64))
+        .ok_or_else(|| {
+            SourceBackedError::InvalidData("indexed worksheet frame overflows".into())
+        })?;
+    if end > upper_bound {
+        return Err(SourceBackedError::InvalidData(
+            "indexed worksheet frame exceeds its boundary".into(),
+        ));
+    }
+    let mut payload = Vec::new();
+    payload
+        .try_reserve_exact(payload_len)
+        .map_err(|_error| SourceBackedError::Allocation {
+            resource: "indexed worksheet payload",
+            requested: payload_len as u64,
+        })?;
+    payload.resize(payload_len, 0);
+    cursor
+        .read_exact(&mut payload)
+        .map_err(SourceBackedError::from)?;
+    Ok((kind, payload))
+}
+
+fn replay_mul_rk_record(payload: &[u8], slot: &CellSlot) -> Result<CellRecord> {
+    let mut found = None;
+    let mut ordinal = 0_u16;
+    CellRecord::visit_mul_rk_measured(payload, |measured, value| {
+        let current = ordinal;
+        ordinal = ordinal.saturating_add(1);
+        if current == slot.ordinal {
+            found = Some(CellRecord::Rk {
+                row: measured.row,
+                col: measured.col,
+                xf_index: measured.xf_index,
+                value: crate::utils::rk_to_f64(value),
+            });
+        }
+    })
+    .map_err(SourceBackedError::Parse)?;
+    let record = found.ok_or_else(|| {
+        SourceBackedError::InvalidData("worksheet index MulRk ordinal is out of range".into())
+    })?;
+    if record.row() != slot.row || record.col() != slot.column || cell_xf_index(&record) != slot.xf
+    {
+        return Err(SourceBackedError::InvalidData(
+            "worksheet index MulRk locator changed".into(),
+        ));
+    }
+    Ok(record)
+}
+
+fn replay_mul_blank_record(payload: &[u8], slot: &CellSlot) -> Result<CellRecord> {
+    let mut found = None;
+    let mut ordinal = 0_u16;
+    CellRecord::visit_mul_blank_measured(payload, |measured| {
+        let current = ordinal;
+        ordinal = ordinal.saturating_add(1);
+        if current == slot.ordinal {
+            found = Some(CellRecord::Blank {
+                row: measured.row,
+                col: measured.col,
+                xf_index: measured.xf_index,
+            });
+        }
+    })
+    .map_err(SourceBackedError::Parse)?;
+    let record = found.ok_or_else(|| {
+        SourceBackedError::InvalidData("worksheet index MulBlank ordinal is out of range".into())
+    })?;
+    if record.row() != slot.row || record.col() != slot.column || cell_xf_index(&record) != slot.xf
+    {
+        return Err(SourceBackedError::InvalidData(
+            "worksheet index MulBlank locator changed".into(),
+        ));
+    }
+    Ok(record)
 }
 
