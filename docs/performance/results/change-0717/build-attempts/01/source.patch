+
+#[cfg(feature = "ordinary-save-process-metrics")]
+const PROCESS_PROBE_CONTROL_COUNT: usize = 32;
+
+#[cfg(feature = "ordinary-save-process-metrics")]
+const PROCESS_PROBE_SCOPE: &str =
+    "ordinary_save_phase_interval_including_before_after_procfs_snapshot_probe_overhead";
+
+#[cfg(feature = "ordinary-save-process-metrics")]
+const PROCESS_PROBE_LATENCY_CLAIM: &str = "diagnostic_only_procfs_probe_instrumentation_latency";
+
+#[cfg(feature = "ordinary-save-process-metrics")]
+const PROCESS_PROBE_CONTROL_SCOPE: &str =
+    "fixed_32_empty_adjacent_procfs_snapshot_pairs_acquired_before_warmups_and_never_subtracted";
+
+/// Selects the report identity for this opt-in diagnostic feature while
+/// preserving the allocator target's identity when the feature is absent.
+#[cfg(feature = "ordinary-save-process-metrics")]
+fn instrumentation_identity_for(allocation_identity: &'static str) -> &'static str {
+    match allocation_identity {
+        "system_allocator_operation_scoped" => {
+            "ordinary_save_procfs_and_system_allocator_operation_scoped"
+        },
+        _ => "ordinary_save_procfs_operation_scoped",
+    }
+}
+
+pub(crate) fn instrumentation_identity() -> &'static str {
+    #[cfg(feature = "ordinary-save-process-metrics")]
+    {
+        return instrumentation_identity_for(allocation_metrics::instrumentation_identity());
+    }
+
+    #[cfg(not(feature = "ordinary-save-process-metrics"))]
+    {
+        allocation_metrics::instrumentation_identity()
+    }
+}
+
+#[cfg(feature = "ordinary-save-process-metrics")]
+fn empty_process_probe_controls() -> Vec<Option<process_metrics::Delta>> {
+    (0..PROCESS_PROBE_CONTROL_COUNT)
+        .map(|_| {
+            let before = process_metrics::Snapshot::read().ok();
+            let after = process_metrics::Snapshot::read().ok();
+            before.zip(after).map(|(before, after)| after.delta(before))
+        })
+        .collect()
+}
