+            &Capabilities::new(),
+            &StreamLimits::default(),
+            |_| Ok::<(), &'static str>(()),
+        )
+        .expect_err("the Unicode attribute key is not an NCName");
+        assert!(matches!(
+            error,
+            StreamError::Mce {
+                error: Error::NonConformant(message),
+                ..
+            } if message == "invalid QName"
+        ));
+    }
