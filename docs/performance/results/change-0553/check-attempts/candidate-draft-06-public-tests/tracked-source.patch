+pub(crate) fn rewrite_value_only_with_compact_proof<'a>(
+    content: &'a [u8],
+    sheet: &str,
+    cells: BTreeMap<Address, super::model::Action>,
+    proof: Option<CompactLayout>,
+    entries: &[Stored],
