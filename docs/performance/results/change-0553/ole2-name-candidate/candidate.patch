     #[test]
+    fn normal_name_handoff_keeps_public_name_cache_and_scalar_fields() {
+        let file = file_with_streams(["Payload"]);
+        let sid = file.root.as_ref().unwrap().sid_child as usize;
+        let entry = file.dir_entries[sid].as_ref().unwrap();
+
+        assert_eq!(entry.name, "Payload");
+        assert_eq!(entry.entry_type, STGTY_STREAM);
+        assert_eq!(entry.sid_child, NOSTREAM);
+        assert_eq!(entry.clsid, "");
+        assert_eq!(entry.size, 0);
+        assert!(entry.is_minifat);
+        assert!(entry.children.is_empty());
+        assert_eq!(
+            file.dir_name_data[sid].as_ref().unwrap(),
+            &directory_name_data("Payload").unwrap()
+        );
+    }
+
+    #[test]
+    fn classic_mac_root_keeps_public_and_validated_name_views() {
+        let mut data = sample_file();
+        let directory_sector = u32::from_le_bytes(data[0x30..0x34].try_into().unwrap());
+        let directory_offset = (directory_sector as usize + 1) * 512;
+        data[directory_offset..directory_offset + 64].fill(0);
+        data[directory_offset + 1] = b'R';
+        data[directory_offset + 64..directory_offset + 66]
+            .copy_from_slice(&2u16.to_le_bytes());
+
+        let file = OleFile::open(Cursor::new(data)).unwrap();
+        assert_eq!(file.root.as_ref().unwrap().name, "");
+        assert_eq!(
+            file.dir_name_data[0].as_ref().unwrap(),
+            &directory_name_data("Root Entry").unwrap()
+        );
+        assert_eq!(file.stream_len(&["Data"]).unwrap(), 7);
+    }
+
+    #[test]
+    fn name_handoff_does_not_bypass_validated_name_errors() {
+        let mut data = sample_file();
+        let directory_sector = u32::from_le_bytes(data[0x30..0x34].try_into().unwrap());
+        let directory_offset = (directory_sector as usize + 1) * 512;
+        let name_length_offset = directory_offset + DIRENTRY_SIZE + 64;
+        data[name_length_offset..name_length_offset + 2].copy_from_slice(&3u16.to_le_bytes());
+
+        assert!(matches!(
+            OleFile::open(Cursor::new(data)),
+            Err(OleError::CorruptedFile(message))
+                if message == "invalid CFB directory name length 3 at SID 1"
+        ));
+    }
