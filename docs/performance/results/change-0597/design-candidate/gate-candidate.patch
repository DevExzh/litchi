+/// Read at most `window.len()` bytes of the worksheet stream into `window`.
+///
+/// This probe is deliberately infallible. It stops at EOF, at a short read
+/// that makes no progress, or at the first transport error, and reports only
+/// how many bytes it observed. Every byte it consumed is replayed into the
+/// scanner by the caller, so a declined probe leaves the stream, its limits,
+/// and its typed errors exactly as they were.
+fn read_bounded_prefix(input: &mut dyn BufRead, window: &mut [u8]) -> usize {
+    let mut filled = 0;
+    while filled < window.len() {
+        match input.read(&mut window[filled..]) {
+            Ok(0) | Err(_) => break,
+            Ok(read) => match filled.checked_add(read) {
+                Some(total) if total <= window.len() => filled = total,
+                _ => break,
+            },
+        }
+    }
