+/// Whether a worksheet prefix carries a `<cols>` column-formatting element.
+///
+/// The search window ends at the first `<sheetData` occurrence because the
+/// schema places `<cols>` before it; a later occurrence is left to the
+/// scanner. The needle must be followed by a name terminator so that no other
+/// element whose name starts with `cols` can match. The predicate reads raw
+/// pre-MCE bytes, so it is deliberately one-sided: a match only ever selects
+/// the materialized parser, which is the authority on this worksheet's values
+/// and on its first typed error, and a miss keeps today's streaming scan.
+fn prefix_declares_columns(prefix: &[u8]) -> bool {
+    let window = match memchr::memmem::find(prefix, SHEET_DATA_MARKER) {
+        Some(position) => &prefix[..position],
+        None => prefix,
+    };
+    memchr::memmem::find_iter(window, COLUMNS_MARKER).any(|position| {
+        window
+            .get(position + COLUMNS_MARKER.len())
+            .is_none_or(|byte| matches!(byte, b'>' | b'/' | b' ' | b'\t' | b'\r' | b'\n'))
+    })
+}
