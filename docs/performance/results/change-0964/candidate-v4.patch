+fn frozen_ns_reader_source_events(content: &[u8]) -> Result<Vec<SourceObservation>, String> {
+    let origin = ReaderOrigin::of(content);
+    let mut reader = NsReader::from_reader(content);
+    reader.config_mut().check_end_names = true;
+    let mut observations = Vec::new();
+    loop {
+        let start = origin
+            .offset(reader.buffer_position())
+            .ok_or_else(|| "reader start offset outside source".to_owned())?;
+        let event = reader.read_event().map_err(|error| error.to_string())?;
+        let end = origin
+            .offset(reader.buffer_position())
+            .ok_or_else(|| "reader end offset outside source".to_owned())?;
+        let (namespace, event) = reader.resolver().resolve_event(event);
