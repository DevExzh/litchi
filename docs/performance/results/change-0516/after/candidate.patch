+
+impl SpeculativeBudget {
+    fn new(initial_output_capacity: usize, ceiling: usize) -> Option<Self> {
+        initial_output_capacity
+            .checked_add(MIN_PARSER_BYTES)
+            .filter(|total| *total <= ceiling)
+            .map(|_| Self {
+                output_capacity: initial_output_capacity,
+                ceiling,
+            })
+    }
