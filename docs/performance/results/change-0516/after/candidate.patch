+#[test]
+fn finite_speculative_ceiling_drops_feed_after_initial_events_without_changing_output() {
+    let payload = "x".repeat(40_000);
+    let input = format!(
+        r#"<worksheet xmlns="{SML}"><sheetData><row r="1"><c r="A1"><f>A2+1</f><v><![CDATA[1]]></v></c><c r="B1"><v>&#x32;</v></c><c r="C1" t="inlineStr"><is><t xml:space="preserve"> text </t></is></c></row></sheetData><future xml:space="preserve">{payload}</future></worksheet>"#,
+        SML = SML,
+        payload = payload,
+    );
+    let expected_bytes = compact_bytes(input.as_bytes()).expect("reference compaction");
+    let expected = parse_store(&expected_bytes).expect("reference semantic parse");
+
+    let mut ordinary = changed_worksheet_with_store(input.as_bytes(), "ceiling parity")
+        .expect("default candidate compaction");
+    let ordinary_store = ordinary
+        .take_store(|| Ok(None))
+        .expect("default candidate finalization")
+        .expect("ordinary fixture qualifies under the default ceiling");
+    let (ordinary_bytes, ordinary_bindings) = ordinary
+        .into_bytes_and_web()
+        .expect("default web validation");
+    assert_eq!(ordinary_bytes, expected_bytes);
+    assert!(ordinary_bindings.is_empty());
+    assert_store_equivalent(&expected, &ordinary_store);
+    assert!(matches!(
+        ordinary_store.get(address("A1")),
+        Some(Cell::Formula(formula)) if formula.text() == "A2+1"
+    ));
+    assert!(matches!(
+        ordinary_store.get(address("B1")),
+        Some(Cell::Value(Value::Number(value))) if value.as_str() == "2"
+    ));
+    assert!(matches!(
+        ordinary_store.get(address("C1")),
+        Some(Cell::Value(Value::Text(value))) if value.as_str() == " text "
+    ));
+
+    // The constructor's 64 KiB minimum is satisfied, and the first worksheet
+    // events fit. The 40,000-byte preserved text event charges 80,000 bytes
+    // plus the already-live parser state, so this finite ceiling trips during
+    // the feed and silently selects the exact-output fallback.
+    let ceiling = input.len().saturating_add(80 * 1024);
+    let mut finite =
+        changed_worksheet_with_store_with_ceiling(input.as_bytes(), "ceiling parity", ceiling)
+            .expect("finite-ceiling compaction");
+    assert!(
+        finite
+            .take_store(|| Ok(None))
+            .expect("finite-ceiling fallback selection")
+            .is_none(),
+        "speculative budget exhaustion must drop the provisional feed"
+    );
+    let (finite_bytes, finite_bindings) = finite
+        .into_bytes_and_web()
+        .expect("fallback web validation");
+    assert_eq!(finite_bytes, expected_bytes);
+    assert!(finite_bindings.is_empty());
+    let fallback = parse_store(&finite_bytes).expect("exact-output fallback parse");
+    assert_store_equivalent(&expected, &fallback);
+}
