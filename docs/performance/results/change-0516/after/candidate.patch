+fn rich_worksheet() -> Vec<u8> {
+    format!(
+        r#"<?xml version="1.0" encoding="UTF-8"?>
+<q:worksheet xmlns:q="{SML}" xmlns:strict="{STRICT_SML}" q:future="preserve">
+  <q:dimension ref="A1:D3"/>
+  <q:sheetFormatPr defaultRowHeight="15"/>
+  <q:cols><q:col min="3" max="3" width="12" style="1" customWidth="1"/></q:cols>
+  <q:sheetData>
+    <q:row r="1" ht="20" customHeight="1">
+      <q:c r="A1"><q:f t="shared" ref="A1:B1" si="7">B1+$C$1</q:f><q:v><![CDATA[1]]></q:v></q:c>
+      <q:c r="B1"><q:f t="shared" si="7"/><q:v>&#x32;</q:v></q:c>
+      <q:c r="C1" t="inlineStr"><q:is><q:t xml:space="preserve"> café &amp; tea </q:t></q:is></q:c>
+    </q:row>
+    <q:row r="3"><q:c r="D3" t="b"><q:v>1</q:v></q:c></q:row>
+  </q:sheetData>
+  <q:mergeCells count="1"><q:mergeCell ref="A1:B2"/></q:mergeCells>
+  <strict:future strict:opaque="kept"/>
+</q:worksheet>"#,
+        SML = SML,
+        STRICT_SML = STRICT_SML,
+    )
+    .into_bytes()
+}
+
+fn column_name(mut index: usize) -> String {
+    let mut bytes = [0_u8; 3];
+    let mut start = bytes.len();
+    loop {
+        start -= 1;
+        bytes[start] = b'A' + (index % 26) as u8;
+        if index < 26 {
+            break;
+        }
+        index = index / 26 - 1;
+    }
+    String::from_utf8(bytes[start..].to_vec()).expect("ASCII column name")
+}
+
+fn dense_numeric_worksheet() -> Vec<u8> {
+    let columns = (0..256).map(column_name).collect::<Vec<_>>();
+    let mut input = String::with_capacity(2 * 1024 * 1024);
+    write!(
+        input,
+        r#"<worksheet xmlns="{SML}"><dimension ref="A1:IV256"/><sheetData>"#,
+        SML = SML
+    )
+    .expect("worksheet header");
+    for row in 1..=256 {
+        write!(input, r#"<row r="{row}">"#).expect("row start");
+        for (column, name) in columns.iter().enumerate() {
+            let value = (row - 1) * 256 + column;
+            write!(input, r#"<c r="{name}{row}"><v>{value}</v></c>"#).expect("numeric cell");
+        }
+        input.push_str("</row>");
+    }
+    input.push_str("</sheetData></worksheet>");
+    input.into_bytes()
+}
+
+fn shared_formula_worksheet(formula_type: &str, tail: &str) -> Vec<u8> {
+    format!(
+        r#"<worksheet xmlns="{SML}"><sheetData><row r="1"><c r="A1"><f t="{formula_type}" ref="A1:B1" si="11">A2+1</f><v>1</v></c><c r="B1"><f t="{formula_type}" si="11"/><v>2</v></c></row></sheetData>{tail}</worksheet>"#,
+        SML = SML,
+        formula_type = formula_type,
+        tail = tail,
+    )
+    .into_bytes()
+}
