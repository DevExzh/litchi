+#[test]
+fn shared_string_owner_error_is_typed_and_called_once() {
+    const OWNER_MESSAGE: &str = "shared-string callback sentinel";
+    let input = format!(
+        r#"<worksheet xmlns="{SML}"><sheetData><row r="1"><c r="A1" t="s"><v>0</v></c></row></sheetData></worksheet>"#,
+        SML = SML,
+    )
+    .into_bytes();
+    let expected_bytes = compact_bytes(&input).expect("shared-string compaction");
+
+    let mut reference_calls = 0;
+    let expected = worksheet::parse(&expected_bytes, || {
+        reference_calls += 1;
+        Err(Error::Invalid(OWNER_MESSAGE.to_owned()))
+    })
+    .err()
+    .expect("reference parser must request the shared-string owner");
+    assert_eq!(reference_calls, 1);
+
+    let mut output = changed_worksheet_with_store(&input, "shared-string owner error")
+        .expect("shared-string output");
+    let mut callback_calls = 0;
+    let actual = match output.take_store(|| {
+        callback_calls += 1;
+        Err(Error::Invalid(OWNER_MESSAGE.to_owned()))
+    }) {
+        Err(error) => error,
+        Ok(Some(_)) => panic!("a failing shared-string owner cannot produce a Store"),
+        Ok(None) => worksheet::parse(output.bytes(), || {
+            callback_calls += 1;
+            Err(Error::Invalid(OWNER_MESSAGE.to_owned()))
+        })
+        .err()
+        .expect("exact-output fallback must request the shared-string owner"),
+    };
+    assert_eq!(
+        callback_calls, 1,
+        "candidate finalization must call the owner once"
+    );
+    assert_eq!(discriminant(&actual), discriminant(&expected));
+    assert_eq!(actual.to_string(), expected.to_string());
+
+    let (actual_bytes, bindings) = output
+        .into_bytes_and_web()
+        .expect("owner error does not invalidate exact output or web phase");
+    assert_eq!(actual_bytes, expected_bytes);
+    assert!(bindings.is_empty());
+}
