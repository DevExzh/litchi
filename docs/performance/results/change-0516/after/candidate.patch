+fn parser_limit_is_owned_by_depth_and_payload_checks_without_ordinary_event_cap() {
+    let mut depth = format!(r#"<worksheet xmlns="{SML}">"#, SML = SML);
+    for _ in 0..256 {
+        depth.push_str("<future>");
+    }
+    depth.push_str("<sheetData/>");
+    for _ in 0..256 {
+        depth.push_str("</future>");
+    }
+    depth.push_str("</worksheet>");
+    let depth_error = parse_store(&compact_bytes(depth.as_bytes()).expect("depth compaction"))
+        .expect_err("worksheet depth owner must reject 257 nested levels");
+    assert!(depth_error.to_string().contains("levels"));
+
+    let valid_many_events = format!(
+        r#"<worksheet xmlns="{SML}"><sheetData><row r="1"><c r="A1"><v>1</v></c></row></sheetData>{}</worksheet>"#,
+        "<future/>".repeat(8_192),
+        SML = SML,
+    );
+    let bytes = compact_bytes(valid_many_events.as_bytes()).expect("many harmless XML events");
+    parse_store(&bytes).expect("ordinary worksheet parser has no invented event cap");
+    let (output, candidate, _) =
+        output_bytes_store_and_web(valid_many_events.as_bytes()).expect("many-event output");
+    assert_eq!(output, bytes);
+    assert!(
+        candidate.is_some(),
+        "harmless events must not exhaust a speculative budget"
+    );
