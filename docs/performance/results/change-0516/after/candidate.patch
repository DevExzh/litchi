+    let expected = parse_store(&expected_bytes).expect("reference output parse");
+    let actual = parse_store(&actual_bytes).expect("candidate output parse");
+    assert_store_equivalent(&expected, &actual);
+    if let Some(candidate) = candidate {
+        assert_store_equivalent(&expected, &candidate);
+    }
+
+    assert!(matches!(
+        actual.get(address("A1")),
+        Some(Cell::Formula(formula))
+            if formula.text() == "B1+$C$1"
+                && matches!(formula.cached().map(Cache::value), Some(Value::Number(value)) if value.as_str() == "1")
+    ));
+    assert!(matches!(
