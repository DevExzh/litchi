+//! Differential checks for the emitted SpreadsheetML validation boundary.
+//!
+//! These tests keep the exact compacted byte stream as the authority and
+//! compare any parser-facing result with the existing materialized parser.
+//! They intentionally use bounded fixtures so a parser-feed candidate cannot
+//! pass by matching only a decoded source event stream.
+
+use std::fmt::Write as _;
+use std::mem::discriminant;
+
+use litchi_sheet::Cell as Address;
+
+use super::{changed, changed_worksheet_with_store, changed_worksheet_with_store_with_ceiling};
+use crate::cell::{Cell, Store, Value};
+use crate::error::{Error, Result};
+use crate::formula::Cache;
+use crate::raw::worksheet;
+
+const SML: &str = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+const STRICT_SML: &str = "http://purl.oclc.org/ooxml/spreadsheetml/main";
+const MC: &str = "http://schemas.openxmlformats.org/markup-compatibility/2006";
+const X14AC: &str = "http://schemas.microsoft.com/office/spreadsheetml/2009/9/ac";
+const X15: &str = "http://schemas.microsoft.com/office/spreadsheetml/2010/11/main";
+const XM: &str = "http://schemas.microsoft.com/office/excel/2006/main";
+const WEB_URI: &str = "{F7C9EE02-42E1-4005-9D12-6889AFFD525C}";
+
+fn address(reference: &str) -> Address {
+    Address::from_a1(reference).expect("valid worksheet address")
+}
+
+fn assert_store_equivalent(expected: &Store, actual: &Store) {
+    assert_eq!(expected.extents(), actual.extents());
+    assert_eq!(expected.entries().len(), actual.entries().len());
+    for (expected, actual) in expected.entries().iter().zip(actual.entries()) {
+        assert_eq!(expected.address, actual.address);
+        assert_eq!(expected.cell, actual.cell);
+        assert_eq!(expected.style, actual.style);
+        assert_eq!(expected.shared_string, actual.shared_string);
+        assert_eq!(expected.inline_rich, actual.inline_rich);
+        assert_eq!(expected.formula_range, actual.formula_range);
+        assert_eq!(expected.shared_formula, actual.shared_formula);
+        assert_eq!(expected.cell_metadata, actual.cell_metadata);
+        assert_eq!(expected.value_metadata, actual.value_metadata);
+    }
+    assert_eq!(expected.row_entries(), actual.row_entries());
+    assert_eq!(expected.column_entries(), actual.column_entries());
+    assert_eq!(expected.defaults(), actual.defaults());
+    assert_eq!(expected.merge_ranges(), actual.merge_ranges());
+}
+
+fn parse_store(content: &[u8]) -> Result<Store> {
+    worksheet::parse(content, || Ok(None))
+}
+
+fn compact_bytes(content: &[u8]) -> Result<Vec<u8>> {
+    changed(content, "emitted worksheet test")
+}
+
+fn output_bytes_store_and_web(
+    content: &[u8],
+) -> Result<(Vec<u8>, Option<Store>, crate::web::Bindings)> {
+    let mut output = changed_worksheet_with_store(content, "emitted worksheet test")?;
+    let store = output.take_store(|| Ok(None))?;
+    let (bytes, bindings) = output.into_bytes_and_web()?;
+    Ok((bytes, store, bindings))
+}
