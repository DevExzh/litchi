+/// Parser state used by the changed-output compactor. The source reader owns
+/// namespace resolution while the compactor owns the normalized events;
+/// keeping the state here makes finalization identical to the ordinary
+/// worksheet parser.
+#[derive(Debug)]
+pub(crate) struct EventParser {
+    parser: Parser,
+    stack: Vec<Context>,
+    closed_root: bool,
+    speculative_bytes: usize,
+    event_scratch_bytes: usize,
+    payload_bytes: usize,
+    cell_count: usize,
+    row_count: usize,
+    merge_count: usize,
+    requires_exact_parser: bool,
+}
+
+impl EventParser {
+    pub(crate) fn new() -> Self {
+        // Vec::try_reserve(1) may choose its small initial growth rather than
+        // exactly one element. Reserve accounting below charges geometric
+        // growth per retained record; these small baselines cover that first
+        // allocation for cells, rows, and merge ranges.
+        let initial_vectors = size_of::<RawCell>()
+            .saturating_mul(2)
+            .saturating_add(size_of::<row::Stored>().saturating_mul(2))
+            .saturating_add(size_of::<Rect>().saturating_mul(2));
+        Self {
+            parser: Parser::new(x14ac::Values::default()),
+            stack: Vec::new(),
+            closed_root: false,
+            speculative_bytes: size_of::<Parser>()
+                .saturating_add(MAX_XML_DEPTH.saturating_mul(size_of::<Context>()))
+                .saturating_add(initial_vectors),
+            event_scratch_bytes: 0,
+            payload_bytes: 0,
+            cell_count: 0,
+            row_count: 0,
+            merge_count: 0,
+            requires_exact_parser: false,
+        }
+    }
+
+    /// Charge the parser state before handing an emitted event to the shared
+    /// consumer. The charge intentionally includes retained payload and
+    /// record overhead, so a budget trip drops the whole provisional parser
+    /// before `Parser::start`, `push_text`, or `finish` can grow state.
+    pub(crate) fn try_charge_event(&mut self, event: &Event<'_>) -> bool {
+        const EVENT_SCRATCH_BYTES: usize = 512;
+        // Retained parser strings can reach roughly 2x geometric capacity;
+        // finish_cell may decode inline text while that original allocation
+        // is still live, and materialization can then create an immutable
+        // Arc-backed Text. Charge the full four-copy peak throughout the
+        // feed so the End-cell decode is covered before it runs.
+        const RETAINED_PAYLOAD_MULTIPLIER: usize = 4;
+        // During the writer-boundary proof, the raw event, decoded value, and
+        // parser/materialization-facing text can coexist. Keep three copies
+        // of the emitted payload available for that short-lived scope.
+        const EVENT_COPY_MULTIPLIER: usize = 3;
+        const CELL_BYTES: usize = size_of::<RawCell>()
+            .saturating_mul(2)
+            .saturating_add(size_of::<PendingCell>());
+        // `Parser::seen_rows` is a HashSet<u32>; this explicit term covers its
+        // bucket/control growth alongside the retained row and pending-row
+        // records. The fixed base covers the first small table allocation;
+        // Vec geometric growth is covered by the factors above.
+        const SEEN_ROW_BYTES: usize = size_of::<u32>().saturating_mul(16);
+        const SEEN_ROW_BASE_BYTES: usize = 1024;
+        const ROW_BYTES: usize = size_of::<row::Stored>()
+            .saturating_mul(2)
+            .saturating_add(size_of::<PendingRow>())
+            .saturating_add(SEEN_ROW_BYTES);
+        const MERGE_BYTES: usize = size_of::<Rect>().saturating_mul(2);
+        const COLUMNS_BYTES: usize = 4 * 1024 * 1024;
+
+        let (payload_bytes, cells, rows, merges, columns) = match event {
+            Event::Start(element) | Event::Empty(element) => {
+                let local = element.local_name();
+                (
+                    element
+                        .name()
+                        .as_ref()
+                        .len()
+                        .saturating_add(element.attributes_raw().len()),
+                    usize::from(local.as_ref() == b"c"),
+                    usize::from(local.as_ref() == b"row"),
+                    usize::from(local.as_ref() == b"mergeCell"),
+                    usize::from(local.as_ref() == b"cols"),
+                )
+            },
+            Event::End(element) => (element.name().as_ref().len(), 0, 0, 0, 0),
+            Event::Text(value) => (value.as_ref().len(), 0, 0, 0, 0),
+            Event::CData(value) => (value.as_ref().len(), 0, 0, 0, 0),
+            Event::GeneralRef(value) => (value.as_ref().len(), 0, 0, 0, 0),
+            Event::Comment(_) | Event::Decl(_) | Event::PI(_) | Event::DocType(_) => {
+                (0, 0, 0, 0, 0)
+            },
+            Event::Eof => (0, 0, 0, 0, 0),
+        };
+        let retained_payload = payload_bytes.saturating_mul(RETAINED_PAYLOAD_MULTIPLIER);
+        let seen_row_base = if rows != 0 && self.row_count == 0 {
+            SEEN_ROW_BASE_BYTES
+        } else {
+            0
+        };
+        let record_bytes = cells
+            .saturating_mul(CELL_BYTES)
+            .saturating_add(rows.saturating_mul(ROW_BYTES))
+            .saturating_add(seen_row_base)
+            .saturating_add(merges.saturating_mul(MERGE_BYTES))
+            .saturating_add(columns.saturating_mul(COLUMNS_BYTES));
+        let Some(total) = self
+            .speculative_bytes
+            .checked_add(retained_payload)
+            .and_then(|value| value.checked_add(record_bytes))
+        else {
+            return false;
+        };
+        let Some(payload_total) = self.payload_bytes.checked_add(payload_bytes) else {
+            return false;
+        };
+        let Some(cell_total) = self.cell_count.checked_add(cells) else {
+            return false;
+        };
+        let Some(row_total) = self.row_count.checked_add(rows) else {
+            return false;
+        };
+        let Some(merge_total) = self.merge_count.checked_add(merges) else {
+            return false;
+        };
+        let Some(scratch) = payload_bytes
+            .checked_mul(EVENT_COPY_MULTIPLIER)
+            .and_then(|value| value.checked_add(EVENT_SCRATCH_BYTES))
+        else {
+            return false;
+        };
+        self.speculative_bytes = total;
+        self.event_scratch_bytes = scratch;
+        self.payload_bytes = payload_total;
+        self.cell_count = cell_total;
+        self.row_count = row_total;
+        self.merge_count = merge_total;
+        true
+    }
+
+    pub(crate) const fn speculative_bytes(&self) -> usize {
+        self.speculative_bytes
+            .saturating_add(self.event_scratch_bytes)
+    }
+
+    pub(crate) const fn release_event_scratch(&mut self) {
+        self.event_scratch_bytes = 0;
+    }
+
+    /// Include the second set of cell/row vectors and semantic materialized
+    /// values that coexist briefly while the shared finalizer builds `Store`.
+    pub(crate) fn final_speculative_bytes(&self) -> usize {
+        const MATERIALIZED_CELL_BYTES: usize = size_of::<crate::cell::Stored>()
+            .saturating_mul(2)
+            .saturating_add(128);
+        const MATERIALIZED_ROW_BYTES: usize = size_of::<row::Stored>()
+            .saturating_mul(2)
+            .saturating_add(64);
+        const CELL_ROW_INDEX_BYTES: usize = 128;
+        // `Store` grows its cell-row index one entry at a time; this covers
+        // the first allocation and allocator/container metadata when the
+        // worksheet has only a few retained cells.
+        const CELL_ROW_INDEX_BASE_BYTES: usize = 1024;
+        // `merge::Index::new` retains ranges and builds node/span/index
+        // arrays, recursive partition vectors, and validation's map/heap.
+        // A fixed startup allowance covers small tables and container
+        // metadata; the per-range allowance covers the live arrays and
+        // allocator growth overlap without claiming process-wide memory.
+        const MERGE_INDEX_BASE_BYTES: usize = 64 * 1024;
+        const MERGE_INDEX_BYTES: usize = 1024;
+        let cell_row_index_base = (self.cell_count != 0).then_some(CELL_ROW_INDEX_BASE_BYTES);
+        let merge_index_base = (self.merge_count != 0).then_some(MERGE_INDEX_BASE_BYTES);
+        self.speculative_bytes
+            // The final materialized cell Vec has the same small initial
+            // growth behavior as the raw vectors above.
+            .saturating_add(size_of::<crate::cell::Stored>().saturating_mul(2))
+            .saturating_add(
+                self.parser
+                    .cells
+                    .len()
+                    .saturating_mul(MATERIALIZED_CELL_BYTES),
+            )
+            .saturating_add(
+                self.parser
+                    .rows
+                    .len()
+                    .saturating_mul(MATERIALIZED_ROW_BYTES),
+            )
+            .saturating_add(cell_row_index_base.unwrap_or(0))
+            .saturating_add(self.cell_count.saturating_mul(CELL_ROW_INDEX_BYTES))
+            .saturating_add(merge_index_base.unwrap_or(0))
+            .saturating_add(self.merge_count.saturating_mul(MERGE_INDEX_BYTES))
+    }
+
+    pub(crate) fn consume(
+        &mut self,
+        namespace: &ResolveResult<'_>,
+        event: &Event<'_>,
+        decoder: Decoder,
+        resolver: &NamespaceResolver,
+    ) -> Result<()> {
+        Parser::consume_event(
+            &mut self.parser,
+            &mut self.stack,
+            &mut self.closed_root,
+            namespace,
+            event,
+            decoder,
+            resolver,
+        )?;
+        // Read decoded parser fields after consumption. Looking only for raw
+        // bytes would miss equivalent values such as `t="shar&#x65;d"` or
+        // `t="&#x73;"`. Shared formulas are excluded because their translation
+        // strings can grow during finalization; shared-string cells are
+        // excluded because their Store value depends on the package callback.
+        let shared_formula = self.parser.cell.as_ref().is_some_and(|cell| {
+            matches!(
+                cell.formula_kind.as_ref(),
+                Some(RawFormulaKind::Shared { .. })
+            )
+        });
+        let shared_string = self
+            .parser
+            .cell
+            .as_ref()
+            .is_some_and(|cell| cell.cell_type.as_deref() == Some("s"))
+            || self
+                .parser
+                .cells
+                .last()
+                .is_some_and(|cell| cell.cell_type.as_deref() == Some("s"));
+        self.requires_exact_parser |= shared_formula || shared_string;
+        Ok(())
+    }
+
+    pub(crate) const fn requires_exact_parser(&self) -> bool {
+        self.requires_exact_parser
+    }
+
+    pub(crate) fn is_complete(&self) -> bool {
+        self.closed_root && self.stack.is_empty()
+    }
+
+    pub(crate) fn finish<'a, F>(self, strings: F) -> Result<Store>
+    where
+        F: FnOnce() -> Result<Option<&'a [Text]>>,
+    {
+        if !self.is_complete() {
+            return Err(invalid(
+                "worksheet XML has a missing or unterminated SpreadsheetML worksheet root",
+            ));
+        }
+        Parser::finish_store(self.parser, strings)
+    }
+}
