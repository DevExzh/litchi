+#[test]
+fn emitted_compaction_bytes_are_exact_and_parser_state_is_semantically_complete() {
+    let input = rich_worksheet();
+    let expected_bytes = compact_bytes(&input).expect("reference compaction");
+    let (actual_bytes, candidate, bindings) =
+        output_bytes_store_and_web(&input).expect("output validation");
+    assert_eq!(
+        actual_bytes, expected_bytes,
+        "candidate must validate emitted bytes"
+    );
+    assert!(bindings.is_empty(), "fixture has no web extensions");
