+#[test]
+fn escaped_shared_formula_type_matches_literal_and_budget_fallback() {
+    let payload = "x".repeat(40_000);
+    let tail = format!(r#"<future xml:space="preserve">{payload}</future>"#);
+    let literal = shared_formula_worksheet("shared", &tail);
+    let escaped = shared_formula_worksheet("shar&#x65;d", &tail);
+
+    let literal_bytes = compact_bytes(&literal).expect("literal shared formula compaction");
+    let escaped_bytes = compact_bytes(&escaped).expect("escaped shared formula compaction");
+    let literal_store = parse_store(&literal_bytes).expect("literal shared formula parse");
+    let escaped_store = parse_store(&escaped_bytes).expect("escaped shared formula parse");
+    assert_store_equivalent(&literal_store, &escaped_store);
+    assert!(matches!(
+        escaped_store.get(address("A1")),
+        Some(Cell::Formula(formula)) if formula.text() == "A2+1"
+    ));
+    assert!(matches!(
+        escaped_store.get(address("B1")),
+        Some(Cell::Formula(formula)) if formula.text() == "B2+1"
+    ));
+
+    let mut output = changed_worksheet_with_store(&escaped, "escaped shared formula")
+        .expect("escaped shared formula output");
+    let candidate = output
+        .take_store(|| Ok(None))
+        .expect("escaped shared formula finalization");
+    let (actual_bytes, bindings) = output
+        .into_bytes_and_web()
+        .expect("escaped shared formula web validation");
+    assert_eq!(actual_bytes, escaped_bytes);
+    assert!(bindings.is_empty());
+    let actual_store = parse_store(&actual_bytes).expect("escaped shared formula output parse");
+    assert_store_equivalent(&escaped_store, &actual_store);
+    if let Some(candidate) = candidate {
+        assert_store_equivalent(&escaped_store, &candidate);
+    }
+
+    // The finite ceiling admits the initial parser state and worksheet
+    // records, then drops the provisional feed on the preserved tail. The
+    // exact compacted bytes and reference Store remain authoritative.
+    let ceiling = escaped.len().saturating_add(80 * 1024);
+    let mut finite =
+        changed_worksheet_with_store_with_ceiling(&escaped, "escaped shared formula", ceiling)
+            .expect("finite escaped shared formula output");
+    assert!(
+        finite
+            .take_store(|| Ok(None))
+            .expect("finite escaped shared formula finalization")
+            .is_none(),
+        "budget exhaustion must refuse the provisional escaped-formula feed"
+    );
+    let (finite_bytes, finite_bindings) = finite
+        .into_bytes_and_web()
+        .expect("finite escaped shared formula web validation");
+    assert_eq!(finite_bytes, escaped_bytes);
+    assert!(finite_bindings.is_empty());
+    let fallback = parse_store(&finite_bytes).expect("escaped shared formula fallback parse");
+    assert_store_equivalent(&escaped_store, &fallback);
+}
