+        },
+        Event::Text(text) => text.decode().is_ok(),
+        Event::CData(text) => text.decode().is_ok(),
+        Event::DocType(_) | Event::PI(_) => false,
+        Event::Comment(_) | Event::Decl(_) | Event::GeneralRef(_) => true,
+        Event::Eof => false,
+    }
