+#[test]
+fn exactly_4096_cells_stay_within_the_validated_store_handoff() {
+    let source = Workbook::new().expect("baseline workbook");
+    let mut edit = source.edit().expect("edit");
+    {
+        let mut sheet = edit
+            .sheet("Sheet1")
+            .expect("sheet lookup")
+            .expect("worksheet");
+        for index in 0..4_096_u32 {
+            sheet
+                .set(
+                    (index / 64, index % 64),
+                    i32::try_from(index).expect("bounded cell"),
+                )
+                .expect("cell edit");
+        }
+    }
+    let committed = edit.commit().expect("4096-cell commit");
+    let xml = part_text(committed.workbook(), "/xl/worksheets/sheet1.xml");
+    assert!(
+        xml.len() <= 1_048_576,
+        "fixture must exercise the cell owner"
+    );
+    assert!(
+        committed.workbook().inner.sheets[0].cells.get().is_some(),
+        "the 4096-cell result is eligible for validated Store handoff"
+    );
+}
+
+#[test]
+fn a_4096_cell_output_over_1mib_drops_the_validated_store_handoff() {
+    let source = Workbook::new().expect("baseline workbook");
+    let mut edit = source.edit().expect("edit");
+    {
+        let mut sheet = edit
+            .sheet("Sheet1")
+            .expect("sheet lookup")
+            .expect("worksheet");
+        for index in 0..4_096_u32 {
+            let value = format!("{index:04}:{}", "x".repeat(300));
+            sheet
+                .set((index / 64, index % 64), value)
+                .expect("cell edit");
+        }
+    }
+    let committed = edit.commit().expect("large 4096-cell commit");
+    let xml = part_text(committed.workbook(), "/xl/worksheets/sheet1.xml");
+    assert!(xml.len() > 1_048_576, "fixture must cross the byte owner");
+    assert!(
+        committed.workbook().inner.sheets[0].cells.get().is_none(),
+        "the 1 MiB owner boundary must prevent Store retention"
+    );
+}
