+//! Public commit-path checks for the changed worksheet output handoff.
+
+use super::super::*;
+use super::support::{part_text, styled_workbook};
+
+use crate::cell::Value;
+use crate::error::Error;
+
+const SML: &str = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+const X15: &str = "http://schemas.microsoft.com/office/spreadsheetml/2010/11/main";
+const XM: &str = "http://schemas.microsoft.com/office/excel/2006/main";
+const WEB_URI: &str = "{F7C9EE02-42E1-4005-9D12-6889AFFD525C}";
+
+fn workbook_with_sheet(xml: &[u8]) -> Workbook {
+    let source = Workbook::new().expect("baseline workbook");
+    let mut package = source.inner.package.clone();
+    package
+        .get_part_mut(&source.inner.sheets[0].part_uri)
+        .expect("worksheet part")
+        .set_blob(xml.to_vec());
+    Workbook::from_package(package).expect("worksheet workbook")
+}
+
+fn source_with_unknown_tail() -> Workbook {
+    workbook_with_sheet(
+        format!(
+            r#"<worksheet xmlns="{SML}"><dimension ref="A1:B1"/><sheetData><row r="1"><c r="A1"><v>7</v></c><c r="B1"><f>A1*2</f><v>14</v></c></row></sheetData><future marker="source's spelling"/></worksheet>"#,
+            SML = SML,
+        )
+        .as_bytes(),
+    )
+}
+
+fn invalid_style_with_valid_web() -> Workbook {
+    let source = styled_workbook();
+    let mut package = source.inner.package.clone();
+    package
+        .get_part_mut(&source.inner.sheets[0].part_uri)
+        .expect("worksheet part")
+        .set_blob(
+            format!(
+                r#"<worksheet xmlns="{SML}" xmlns:x15="{X15}" xmlns:xm="{XM}"><sheetData><row r="1"><c r="A1" s="99"><v>1</v></c></row></sheetData><extLst><ext uri="{WEB_URI}"><x15:webExtensions><x15:webExtension appRef="dashboard"><xm:f>Sheet1!A1</xm:f></x15:webExtension></x15:webExtensions></ext></extLst></worksheet>"#,
+                SML = SML,
+                X15 = X15,
+                XM = XM,
+                WEB_URI = WEB_URI,
+            )
+            .into_bytes(),
+        );
+    Workbook::from_package(package).expect("invalid-style workbook")
+}
+
+#[test]
+fn ineffective_cell_edit_keeps_source_bytes_and_patch_identity() {
+    let source = source_with_unknown_tail();
+    let source_bytes = source.to_plain_bytes().expect("source bytes");
+    let source_sheet = part_text(&source, "/xl/worksheets/sheet1.xml").to_owned();
+
+    let mut edit = source.edit().expect("edit");
+    edit.sheet("Sheet1")
+        .expect("sheet lookup")
+        .expect("worksheet")
+        .set("A1", 7_i32)
+        .expect("same value");
+    let committed = edit.commit().expect("no-op commit");
+
+    assert!(committed.patch().is_empty());
+    assert_eq!(
+        part_text(committed.workbook(), "/xl/worksheets/sheet1.xml"),
+        source_sheet
+    );
+    assert_eq!(
+        committed.workbook().to_plain_bytes().expect("no-op bytes"),
+        source_bytes
+    );
+}
+
+#[test]
+fn changed_output_reopens_with_values_and_formula_and_round_trips_inverse() {
+    let source = source_with_unknown_tail();
+    let source_bytes = source.to_plain_bytes().expect("source bytes");
+
+    let mut edit = source.edit().expect("edit");
+    edit.sheet("Sheet1")
+        .expect("sheet lookup")
+        .expect("worksheet")
+        .set("A1", 9_i32)
+        .expect("changed value");
+    let committed = edit.commit().expect("changed commit");
+    let sheet = committed
+        .workbook()
+        .sheet("Sheet1")
+        .expect("sheet lookup")
+        .expect("worksheet");
+    assert!(matches!(
+        sheet.cell("A1").expect("A1").stored(),
+        Some(Cell::Value(Value::Number(value))) if value.as_str() == "9"
+    ));
+    assert!(matches!(
+        sheet.cell("B1").expect("B1").stored(),
+        Some(Cell::Formula(formula)) if formula.text() == "A1*2"
+    ));
+    let committed_bytes = committed
+        .workbook()
+        .to_plain_bytes()
+        .expect("committed bytes");
+    assert_ne!(committed_bytes, source_bytes);
+    assert_eq!(
+        source.to_plain_bytes().expect("source remains unchanged"),
+        source_bytes
+    );
+
+    let restored = committed
+        .workbook()
+        .apply(&committed.patch().inverse())
+        .expect("inverse apply");
+    assert_eq!(
+        restored
+            .workbook()
+            .to_plain_bytes()
+            .expect("restored bytes"),
+        source_bytes
+    );
+    let replayed = source.apply(committed.patch()).expect("forward replay");
+    assert_eq!(
+        replayed
+            .workbook()
+            .to_plain_bytes()
+            .expect("replayed bytes"),
+        committed_bytes
+    );
+}
