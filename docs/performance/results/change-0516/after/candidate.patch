+#[test]
+fn web_output_validation_remains_before_style_validation() {
+    let source = invalid_style_with_valid_web();
+    let mut edit = source.edit().expect("edit");
+    edit.sheet("Sheet1")
+        .expect("sheet lookup")
+        .expect("worksheet")
+        .set("A1", 2_i32)
+        .expect("changed value");
+    let error = edit.commit().expect_err("invalid style must be rejected");
+    assert!(matches!(
+        error,
+        Error::Invalid(message) if message.contains("shared style 99")
+    ));
+}
