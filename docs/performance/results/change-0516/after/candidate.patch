+        Some(Cell::Value(Value::Text(value))) if value.as_str() == " café & tea "
+    ));
+    assert!(matches!(
+        actual.get(address("D3")),
+        Some(Cell::Value(Value::Bool(true)))
+    ));
+    assert_eq!(actual.row_entries().len(), 2);
+    assert_eq!(actual.column_entries().len(), 1);
