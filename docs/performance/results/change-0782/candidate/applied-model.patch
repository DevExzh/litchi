+#[test]
+fn grouped_shape_accepts_borrowed_text() {
+    let source = String::from("borrowed group text");
+    let shape = UserShapeData {
+        text: Some(source.as_str()),
+        ..Default::default()
+    };
+    let group = GroupShape::new(10, EscherSpgrData::ZERO).with_shape(
+        11,
+        ChildAnchor {
+            left: 0,
+            top: 0,
+            right: 100,
+            bottom: 100,
+        },
+        shape,
+    );
+
+    let bytes = create_group_shape_container(&group).expect("group drawing");
+    let textboxes = Parser::new(&bytes).textboxes().expect("textboxes");
+    assert_eq!(textboxes.len(), 1);
+    let expected = build_client_textbox(source.as_str(), 4).expect("plain textbox");
+    assert_eq!(textboxes[0].data(), &expected[8..]);
+    let textbox =
+        crate::EscherTextboxWrapper::new(textboxes[0].data().to_vec()).expect("valid textbox");
+    assert_eq!(textbox.text(), source);
+}
