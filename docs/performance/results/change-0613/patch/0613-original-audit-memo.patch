@@ -0,0 +1,195 @@
+//! Internal coverage for the publication memo of original-Part audit verdicts.
+//!
+//! The public integration tests show that two publications from one source
+//! produce identical bytes and identical refusals. These tests live under
+//! `source_backed` so they can reach the memo directly and show that the
+//! verdict it reproduces is the verdict the auditor produced: the same
+//! acceptance, and the same refusal value, offset and message.
+
+#![allow(
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    clippy::panic,
+    clippy::unwrap_used,
+    reason = "focused internal memo tests deliberately panic on fixture errors"
+)]
+
+use super::*;
+use soapberry_zip::office::StreamingArchiveWriter;
+
+const CONTENT_TYPES_NS: &str = "http://schemas.openxmlformats.org/package/2006/content-types";
+const RELATIONSHIPS_NS: &str = "http://schemas.openxmlformats.org/package/2006/relationships";
+const OFFICE_DOCUMENT_REL: &str =
+    "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument";
+const DOCUMENT_MEMBER: &str = "word/document.xml";
+const DOCUMENT_URI: &str = "/word/document.xml";
+const SECOND_MEMBER: &str = "word/settings.xml";
+const SECOND_URI: &str = "/word/settings.xml";
+/// A compact authored payload, the shape litchi itself writes.
+const COMPACT: &[u8] = b"<document><body/></document>";
+/// The shape a real producer writes: indented, so the authored compactness
+/// audit refuses it. Change 0602 measured that refusal on 94 of 95 real
+/// packages; this fixture reproduces it in one part.
+const INDENTED: &[u8] = b"<document>\n  <body/>\n</document>";
+
+fn archive_bytes(document: &[u8], second: &[u8]) -> Vec<u8> {
+    let content_types = format!(
+        r#"<Types xmlns="{CONTENT_TYPES_NS}"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/></Types>"#
+    );
+    let relationships = format!(
+        r#"<Relationships xmlns="{RELATIONSHIPS_NS}"><Relationship Id="rId1" Type="{OFFICE_DOCUMENT_REL}" Target="{DOCUMENT_MEMBER}"/></Relationships>"#
+    );
+    let mut writer = StreamingArchiveWriter::new();
+    writer
+        .write_stored("[Content_Types].xml", content_types.as_bytes())
+        .expect("content types fixture must be writable");
+    writer
+        .write_stored("_rels/.rels", relationships.as_bytes())
+        .expect("relationships fixture must be writable");
+    writer
+        .write_stored(DOCUMENT_MEMBER, document)
+        .expect("document fixture must be writable");
+    writer
+        .write_stored(SECOND_MEMBER, second)
+        .expect("settings fixture must be writable");
+    writer
+        .finish_to_bytes()
+        .expect("archive fixture must finish")
+}
+
+fn open_package(document: &[u8], second: &[u8]) -> SourceBackedPackage {
+    SourceBackedPackage::from_vec(archive_bytes(document, second))
+        .expect("fixture package must open")
+}
+
+fn part_index(package: &SourceBackedPackage, uri: &str) -> usize {
+    package
+        .part(&PackURI::new(uri).expect("fixture URI must be valid"))
+        .expect("fixture part must exist")
+        .index
+}
+
+fn memo_len(package: &SourceBackedPackage) -> usize {
+    package
+        .original_audits
+        .entries
+        .lock()
+        .expect("memo lock must not be poisoned")
+        .len()
+}
+
+#[test]
+fn a_repeated_audit_of_one_source_part_reproduces_the_acceptance() {
+    let package = open_package(COMPACT, COMPACT);
+    let index = part_index(&package, DOCUMENT_URI);
+    assert_eq!(memo_len(&package), 0);
+
+    package
+        .validate_original_part_xml(index, DOCUMENT_URI, COMPACT)
+        .expect("a compact original must be accepted");
+    assert_eq!(memo_len(&package), 1);
+    package
+        .validate_original_part_xml(index, DOCUMENT_URI, COMPACT)
+        .expect("the memoized verdict must reproduce the acceptance");
+    assert_eq!(memo_len(&package), 1);
+}
+
+#[test]
+fn a_repeated_audit_reproduces_the_exact_refusal() {
+    let package = open_package(INDENTED, COMPACT);
+    let index = part_index(&package, DOCUMENT_URI);
+
+    let first = package
+        .validate_original_part_xml(index, DOCUMENT_URI, INDENTED)
+        .expect_err("an indented original must be refused");
+    let second = package
+        .validate_original_part_xml(index, DOCUMENT_URI, INDENTED)
+        .expect_err("the memoized verdict must reproduce the refusal");
+
+    let (
+        OpcError::XmlPublication {
+            part: first_part,
+            source: first_source,
+        },
+        OpcError::XmlPublication {
+            part: second_part,
+            source: second_source,
+        },
+    ) = (&first, &second)
+    else {
+        panic!("both refusals must be publication audit failures: {first:?}, {second:?}");
+    };
+    assert_eq!(first_part, second_part);
+    assert_eq!(first_source, second_source);
+    assert_eq!(first.to_string(), second.to_string());
+    assert_eq!(format!("{first:?}"), format!("{second:?}"));
+}
+
+#[test]
+fn the_memoized_verdict_is_the_one_publication_reports() {
+    // Replace the recorded verdict with a distinguishable one. The audit of
+    // these bytes accepts them, so a second acceptance would prove only that
+    // the auditor ran again. Reporting the planted verdict proves that the
+    // memo — not a fresh audit — answered.
+    let package = open_package(COMPACT, COMPACT);
+    let index = part_index(&package, DOCUMENT_URI);
+    package
+        .validate_original_part_xml(index, DOCUMENT_URI, COMPACT)
+        .expect("a compact original must be accepted");
+
+    let planted = xml_minifier::audit::Error::Doctype { offset: 17 };
+    package
+        .original_audits
+        .remember(index, COMPACT.len(), &Err(planted.clone()));
+
+    let error = package
+        .validate_original_part_xml(index, DOCUMENT_URI, COMPACT)
+        .expect_err("the memo must answer instead of the auditor");
+    let OpcError::XmlPublication { part, source } = &error else {
+        panic!("a memoized refusal must stay a publication audit failure: {error:?}");
+    };
+    assert_eq!(part, DOCUMENT_URI);
+    assert_eq!(source, &planted);
+}
+
+#[test]
+fn a_payload_the_memo_did_not_audit_takes_a_fresh_audit() {
+    // The memo is keyed on the source Part *and* the audited length. A
+    // payload of a different length is not the payload whose verdict was
+    // recorded, so it is audited on its own merits.
+    let package = open_package(COMPACT, COMPACT);
+    let index = part_index(&package, DOCUMENT_URI);
+    package.original_audits.remember(
+        index,
+        COMPACT.len() + 1,
+        &Err(xml_minifier::audit::Error::Doctype { offset: 0 }),
+    );
+
+    package
+        .validate_original_part_xml(index, DOCUMENT_URI, COMPACT)
+        .expect("a length the memo did not record must be audited afresh");
+}
+
+#[test]
+fn the_memo_records_one_verdict_for_each_source_part() {
+    let package = open_package(COMPACT, INDENTED);
+    let document = part_index(&package, DOCUMENT_URI);
+    let second = part_index(&package, SECOND_URI);
+    assert_ne!(document, second);
+
+    package
+        .validate_original_part_xml(document, DOCUMENT_URI, COMPACT)
+        .expect("a compact original must be accepted");
+    package
+        .validate_original_part_xml(second, SECOND_URI, INDENTED)
+        .expect_err("an indented original must be refused");
+    assert_eq!(memo_len(&package), 2);
+
+    // Each Part keeps its own verdict; neither answers for the other.
+    package
+        .validate_original_part_xml(document, DOCUMENT_URI, COMPACT)
+        .expect("the document's acceptance must not be displaced");
+    package
+        .validate_original_part_xml(second, SECOND_URI, INDENTED)
+        .expect_err("the settings refusal must not be displaced");
+}
