new file mode 100644
index 000000000..a1a463466
--- /dev/null
+++ b/crates/litchi-opc/tests/source_backed_original_audit.rs
@@ -0,0 +1,175 @@
+#![allow(
+    clippy::cast_possible_truncation,
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    clippy::panic,
+    clippy::unwrap_used,
+    reason = "focused publication-audit tests deliberately panic on fixture errors"
+)]
+
+//! Publication audits the original bytes of every replaced XML Part.
+//!
+//! Those bytes are immutable for one source lineage, so publication records
+//! the verdict it computed and reproduces it instead of parsing them again.
+//! These tests keep the observable contract fixed: two publications from one
+//! source produce identical bytes, an original the audit refuses is refused
+//! identically every time, and a source that changed underneath the package
+//! is refused before any recorded verdict is consulted.
+
+use std::io;
+use std::sync::{
+    Arc, RwLock,
+    atomic::{AtomicU64, Ordering},
+};
+
+use litchi_core::{ReadAt, SourceVersion};
+use litchi_opc::{OpcError, PackURI, SourceBackedPackage};
+use soapberry_zip::office::StreamingArchiveWriter;
+
+const CONTENT_TYPES_NS: &str = "http://schemas.openxmlformats.org/package/2006/content-types";
+const RELATIONSHIPS_NS: &str = "http://schemas.openxmlformats.org/package/2006/relationships";
+const OFFICE_DOCUMENT_REL: &str =
+    "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument";
+const DOCUMENT_MEMBER: &str = "word/document.xml";
+const DOCUMENT_URI: &str = "/word/document.xml";
+/// A compact authored payload, the shape litchi itself writes.
+const COMPACT: &[u8] = b"<document><body/></document>";
+/// A real producer's shape: indented, which the authored compactness audit
+/// refuses. Change 0602 measured that refusal on 94 of 95 real packages.
+const INDENTED: &[u8] = b"<document>\n  <body/>\n</document>";
+const REPLACEMENT: &[u8] = b"<document><body><p/></body></document>";
+
+#[derive(Debug)]
+struct MutableSource {
+    bytes: RwLock<Vec<u8>>,
+    revision: AtomicU64,
+}
+
+impl MutableSource {
+    fn new(bytes: Vec<u8>) -> Self {
+        Self {
+            bytes: RwLock::new(bytes),
+            revision: AtomicU64::new(0),
+        }
+    }
+
+    fn replace_bytes(&self, bytes: Vec<u8>) {
+        *self.bytes.write().expect("mutable source lock must work") = bytes;
+        self.revision.fetch_add(1, Ordering::Release);
+    }
+}
+
+impl ReadAt for MutableSource {
+    fn len(&self) -> io::Result<u64> {
+        Ok(self
+            .bytes
+            .read()
+            .expect("mutable source lock must work")
+            .len() as u64)
+    }
+
+    fn read_at(&self, offset: u64, output: &mut [u8]) -> io::Result<usize> {
+        let bytes = self.bytes.read().expect("mutable source lock must work");
+        let start = usize::try_from(offset).map_err(|_| io::Error::other("offset overflow"))?;
+        if start >= bytes.len() {
+            return Ok(0);
+        }
+        let count = output.len().min(bytes.len() - start);
+        output[..count].copy_from_slice(&bytes[start..start + count]);
+        Ok(count)
+    }
+
+    fn version(&self) -> io::Result<SourceVersion> {
+        Ok(SourceVersion::new(
+            0x4f50_435f_4849_4e54,
+            self.revision.load(Ordering::Acquire),
+        ))
+    }
+}
+
+fn archive_bytes(document: &[u8]) -> Vec<u8> {
+    let content_types = format!(
+        r#"<Types xmlns="{CONTENT_TYPES_NS}"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/></Types>"#
+    );
+    let relationships = format!(
+        r#"<Relationships xmlns="{RELATIONSHIPS_NS}"><Relationship Id="rId1" Type="{OFFICE_DOCUMENT_REL}" Target="{DOCUMENT_MEMBER}"/></Relationships>"#
+    );
+    let mut writer = StreamingArchiveWriter::new();
+    writer
+        .write_stored("[Content_Types].xml", content_types.as_bytes())
+        .expect("content types fixture must be writable");
+    writer
+        .write_stored("_rels/.rels", relationships.as_bytes())
+        .expect("relationships fixture must be writable");
+    writer
+        .write_stored(DOCUMENT_MEMBER, document)
+        .expect("document fixture must be writable");
+    writer
+        .finish_to_bytes()
+        .expect("archive fixture must finish")
+}
+
+fn document_uri() -> PackURI {
+    PackURI::new(DOCUMENT_URI).expect("fixture URI must be valid")
+}
+
+fn publish(source: &Arc<dyn ReadAt>) -> Result<Vec<u8>, OpcError> {
+    let package = SourceBackedPackage::from_read_at(Arc::clone(source))?;
+    let mut output = Vec::new();
+    package.write_part_overlay_to_stream(&mut output, &document_uri(), REPLACEMENT.to_vec())?;
+    Ok(output)
+}
+
+#[test]
+fn two_publications_from_one_source_produce_identical_bytes() {
+    let source: Arc<dyn ReadAt> = Arc::new(MutableSource::new(archive_bytes(COMPACT)));
+    let first = publish(&source).expect("the first publication must succeed");
+    let second = publish(&source).expect("the second publication must succeed");
+    assert_eq!(first, second);
+    assert!(!first.is_empty());
+}
+
+#[test]
+fn two_publications_of_a_refused_original_report_the_identical_refusal() {
+    let source: Arc<dyn ReadAt> = Arc::new(MutableSource::new(archive_bytes(INDENTED)));
+    let first = publish(&source).expect_err("an indented original must be refused");
+    let second = publish(&source).expect_err("the refusal must not depend on the attempt");
+
+    let (
+        OpcError::XmlPublication {
+            part: first_part,
+            source: first_source,
+        },
+        OpcError::XmlPublication {
+            part: second_part,
+            source: second_source,
+        },
+    ) = (&first, &second)
+    else {
+        panic!("both refusals must be publication audit failures: {first:?}, {second:?}");
+    };
+    assert_eq!(first_part, DOCUMENT_URI);
+    assert_eq!(first_part, second_part);
+    assert_eq!(first_source, second_source);
+    assert_eq!(first.to_string(), second.to_string());
+}
+
+#[test]
+fn a_source_that_changed_is_refused_before_any_recorded_verdict() {
+    let mutable = Arc::new(MutableSource::new(archive_bytes(COMPACT)));
+    let source: Arc<dyn ReadAt> = mutable.clone();
+    let package = SourceBackedPackage::from_read_at(source).expect("fixture package must open");
+
+    // The audited original is now stale: publication must refuse the changed
+    // source, never publish an earlier lineage's verdict over new bytes.
+    mutable.replace_bytes(archive_bytes(INDENTED));
+
+    let mut output = Vec::new();
+    let error = package
+        .write_part_overlay_to_stream(&mut output, &document_uri(), REPLACEMENT.to_vec())
+        .expect_err("a changed source must be refused");
+    assert!(
+        matches!(error, OpcError::SourceChanged { .. }),
+        "expected SourceChanged, found {error:?}"
+    );
+}
