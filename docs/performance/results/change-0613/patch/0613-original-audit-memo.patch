+/// Authored-compactness verdicts already computed for immutable source Parts.
+///
+/// The original bytes of an admitted Part cannot change while one source
+/// lineage lives: every publication re-checks the source revision and refuses
+/// [`OpcError::SourceChanged`] before any audit runs, and the catalog is
+/// immutable. `verify_authored` is a pure function of those bytes and the
+/// package's own [`ReadLimits`], so the verdict computed for one Part is the
+/// verdict every later audit of the same Part in the same lineage computes.
+///
+/// The memo never observes a replacement payload. It is keyed on the catalog
+/// index of the *source* Part and checked against the audited byte length, so
+/// a payload this lineage did not audit always takes a fresh audit.
+#[derive(Debug, Default)]
+struct OriginalAuditMemo {
+    /// At most one entry per admitted ordinary Part, so the retained set is
+    /// bounded by [`ReadLimits::max_parts`]. One publication replaces at most
+    /// `MAX_SOURCE_OVERLAY_PARTS` Parts, so the scan is over a bounded set.
+    entries: Mutex<Vec<OriginalAuditMemoEntry>>,
+}
+
+#[derive(Debug)]
+struct OriginalAuditMemoEntry {
+    /// Catalog position of the immutable source Part.
+    part: usize,
+    /// Length of the audited original payload.
+    len: usize,
+    /// The verdict `verify_authored` returned for those exact bytes.
+    verdict: std::result::Result<(), xml_minifier::audit::Error>,
+}
+
+impl OriginalAuditMemo {
+    /// Return the verdict this lineage already computed for one source Part.
+    fn recall(
+        &self,
+        part: usize,
+        len: usize,
+    ) -> Option<std::result::Result<(), xml_minifier::audit::Error>> {
+        let entries = self
+            .entries
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        entries
+            .iter()
+            .find(|entry| entry.part == part && entry.len == len)
+            .map(|entry| match &entry.verdict {
+                Ok(()) => Ok(()),
+                Err(error) => Err(clone_audit_error(error)),
+            })
+    }
+
+    /// Record one verdict. A memo that cannot be retained only costs a later
+    /// audit, so an allocation failure here never fails a publication.
+    fn remember(
+        &self,
+        part: usize,
+        len: usize,
+        verdict: &std::result::Result<(), xml_minifier::audit::Error>,
+    ) {
+        let recorded = OriginalAuditMemoEntry {
+            part,
+            len,
+            verdict: match verdict {
+                Ok(()) => Ok(()),
+                Err(error) => Err(clone_audit_error(error)),
+            },
+        };
+        let mut entries = self
+            .entries
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if let Some(existing) = entries.iter_mut().find(|entry| entry.part == part) {
+            *existing = recorded;
+            return;
+        }
+        if entries.try_reserve(1).is_err() {
+            return;
+        }
+        entries.push(recorded);
+    }
+}
+
+/// Reproduce one audit refusal without re-running the audit.
+///
+/// The audit error is a bounded owned value: its only allocation is the
+/// parser diagnostic, whose length the auditor already bounds. Reproducing it
+/// preserves the error identity `verify_authored` produced for these exact
+/// bytes, so a memoized refusal is indistinguishable from a fresh one.
+fn clone_audit_error(error: &xml_minifier::audit::Error) -> xml_minifier::audit::Error {
+    error.clone()
+}
