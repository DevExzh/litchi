+/// Probes one retained target frame with the worksheet-start checkpoint and
+/// keeps the resulting chain position as optional replay metadata.  The CFB
+/// cursor constructor only walks already validated allocation metadata; it
+/// does not read the source or observe freshness.  Any refusal is therefore a
+/// cache-only miss and leaves the original worksheet checkpoint in force.
+fn retain_target_chain_checkpoint(
+    owner: &SourceInner,
+    candidate: &mut IndexCandidate<'_>,
+    row: u16,
+    column: u16,
+) {
+    let Some((frame_offset, original)) = candidate.target_slot_and_chain_checkpoint(row, column)
+    else {
+        return;
+    };
+    // The normal worksheet scan already owns its borrowed path view. Rebuild
+    // it only for this optional probe, and make that scratch allocation
+    // fallible so a metadata-only optimization cannot change query results.
+    let mut refs = Vec::new();
+    if refs.try_reserve_exact(owner.workbook_path.len()).is_err() {
+        return;
+    }
+    refs.extend(owner.workbook_path.iter().map(String::as_str));
+    let mut chain = owner.cfb.chain_hint_from_checkpoint(original);
+    if owner
+        .cfb
+        .stream_cursor_at_hinted(&refs, frame_offset, &mut chain)
+        .is_err()
+    {
+        return;
+    }
+    candidate.set_target_chain_checkpoint(frame_offset, &chain);
+}
