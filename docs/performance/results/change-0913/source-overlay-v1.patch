+impl<'a> IndexedReadSession<'a, Arc<Vec<u8>>> {
+    /// Create a session that reads directly from an immutable retained source.
+    ///
+    /// This is deliberately private plumbing for the specialized owned-source
+    /// archive method below. The generic session keeps its bounded
+    /// `MemberSpan` optimization and its source-read grammar unchanged.
+    fn new_direct_owned(archive: &'a IndexedArchive<Arc<Vec<u8>>>) -> Self {
+        Self {
+            archive,
+            decoder: None,
+            source_policy: IndexedReadSourcePolicy::DirectOwned,
+        }
+    }
+}
+
+impl IndexedArchive<Arc<Vec<u8>>> {
+    /// Read and verify one member directly from an immutable retained source.
+    ///
+    /// This is the owned-source path used by deferred OPC payloads. It keeps
+    /// the indexed reader's framing, output reservation, decoder, verifier,
+    /// and accounting grammar, while bypassing the generic source's bounded
+    /// speculative `MemberSpan` copy. The method is hidden implementation
+    /// plumbing because callers should use their format owner's API. Each
+    /// call creates a fresh read session; it does not cache decoded members or
+    /// promise decoder reuse across calls.
+    #[doc(hidden)]
+    pub fn read_owned(&self, name: &str) -> Result<Vec<u8>, Error> {
+        let mut accounting = ZipOperationAccounting::default();
+        self.read_owned_with_accounting(name, &mut accounting)
+    }
+
+    /// Read and verify one owned-source member while recording payload work.
+    #[doc(hidden)]
+    pub fn read_owned_with_accounting(
+        &self,
+        name: &str,
+        accounting: &mut ZipOperationAccounting,
+    ) -> Result<Vec<u8>, Error> {
+        let entry_id = self.entry_id_for_name(name)?;
+        let mut session = IndexedReadSession::new_direct_owned(self);
+        session.read_entry_with_accounting(entry_id, accounting)
+    }
+}
+
