+struct PendingCapturedStream {
+    path: Vec<String>,
+    metadata: directory::Metadata,
+    size: u64,
+    reused: Option<Arc<[u8]>>,
+}
+
+fn capture_container_reusing(
+    ole: &OleFile<Cursor<&[u8]>>,
+    path: &[String],
+    package: &mut Package,
+    budget: &mut Budget,
+    limits: Limits,
+    comparer: &mut SourceStreamComparer<'_>,
+    staged_by_path: &HashMap<&[String], &Stream>,
+    pending: &mut Vec<PendingCapturedStream>,
+) -> Result<(), OleError> {
+    let max_entries = budget.max_directory_entries();
+    let refs = path_refs(path);
+    ole.visit_directory_entry_refs(&refs, max_entries, |entry| {
+        let metadata = directory::decode(entry)?;
+        let mut child = path.to_vec();
+        child.push(entry.name.clone());
+        match metadata.kind() {
+            EntryKind::Storage => {
+                if child.len() > limits.max_storage_depth {
+                    return Err(OleError::InvalidFormat(
+                        "CFB storage nesting limit exceeded".into(),
+                    ));
+                }
+                budget.charge_storage()?;
+                package
+                    .storages
+                    .try_reserve(1)
+                    .map_err(|source| OleError::Allocation {
+                        resource: "CFB storage capture",
+                        source,
+                    })?;
+                package.storages.push(Storage::new(child.clone(), metadata));
+                capture_container_reusing(
+                    ole,
+                    &child,
+                    package,
+                    budget,
+                    limits,
+                    comparer,
+                    staged_by_path,
+                    pending,
+                )?;
+            },
+            EntryKind::Stream => {
+                if entry.size > limits.max_stream_size {
+                    return Err(OleError::InvalidFormat(format!(
+                        "stream {child:?} exceeds size limit"
+                    )));
+                }
+                budget.charge(entry.size)?;
+                let staged_stream = staged_by_path.get(child.as_slice()).copied();
+                let expected = staged_stream.map_or(&[][..], Stream::bytes);
+                // Even an absent staged path is compared against an empty
+                // expectation. This validates the candidate stream in
+                // traversal order before any later queued read can be
+                // reached; the missing path still falls back to open_stream.
+                let equal = comparer.stream_equals(&path_refs(&child), expected)?;
+                let reused = equal
+                    .then(|| staged_stream.map(Stream::bytes_shared))
+                    .flatten();
+                pending
+                    .try_reserve(1)
+                    .map_err(|source| OleError::Allocation {
+                        resource: "CFB pending stream capture",
+                        source,
+                    })?;
+                pending.push(PendingCapturedStream {
+                    path: child,
+                    metadata,
+                    size: entry.size,
+                    reused,
+                });
+            },
+            EntryKind::Root => {},
+        }
+        Ok(())
+    })
+}
+
+fn finish_reused_stream_capture(
+    ole: &mut OleFile<Cursor<&[u8]>>,
+    package: &mut Package,
+    pending: Vec<PendingCapturedStream>,
+) -> Result<(), OleError> {
+    for stream in pending {
+        let data = match stream.reused {
+            Some(data) => data,
+            None => {
+                let data = ole.open_stream(&path_refs(&stream.path))?;
+                if data.len() as u64 != stream.size {
+                    return Err(OleError::InvalidFormat(format!(
+                        "stream {:?} size changed during capture",
+                        stream.path
+                    )));
+                }
+                Arc::<[u8]>::from(data)
+            },
+        };
+        package
+            .streams
+            .try_reserve(1)
+            .map_err(|source| OleError::Allocation {
+                resource: "CFB stream capture",
+                source,
+            })?;
+        package
+            .streams
+            .push(Stream::new(stream.path, data, Some(stream.metadata)));
+    }
+    Ok(())
+}
