+/// A stream comparer bound to the immutable bytes parsed by a cursor reader.
+///
+/// This adapter deliberately does not accept a second byte slice: the
+/// candidate ranges are read from the exact `Cursor<&[u8]>` that
+/// [`OleFile::open`] parsed.  Keeping that binding in the type prevents a
+/// caller from validating one reader against unrelated bytes.
+pub struct SourceStreamComparer<'a> {
+    inner: StreamComparer<'a, Cursor<&'a [u8]>, OleFile<Cursor<&'a [u8]>>>,
+}
+
+impl SourceStreamComparer<'_> {
+    /// Whether the stream at `path` holds exactly `expected`.
+    ///
+    /// The comparison retains the existing comparer’s chain, tail,
+    /// readability, zero-fill, and one-time root mini-stream validation.  A
+    /// false result means the parsed stream is valid but its bytes differ; an
+    /// error means the parsed source failed one of those validations.
+    ///
+    /// # Errors
+    ///
+    /// Returns the same structural, bounds, and candidate-read errors that a
+    /// corresponding stream read would report.
+    pub fn stream_equals(&mut self, path: &[&str], expected: &[u8]) -> Result<bool, OleError> {
+        self.inner.stream_equals(path, expected)
+    }
+}
+
+impl CandidateBytes for OleFile<Cursor<&[u8]>> {
+    fn equals_at(&self, offset: u64, expected: &[u8]) -> Result<bool, OleError> {
+        Ok(source_range(self.reader.get_ref(), offset, expected.len())? == expected)
+    }
+
+    fn check_readable(&self, offset: u64, len: usize) -> Result<(), OleError> {
+        source_range(self.reader.get_ref(), offset, len).map(drop)
+    }
+}
+
+fn source_range(bytes: &[u8], offset: u64, len: usize) -> Result<&[u8], OleError> {
+    let start = usize::try_from(offset)
+        .map_err(|_error| OleError::InvalidData("comparison leaves the file".to_string()))?;
+    let end = start
+        .checked_add(len)
+        .ok_or_else(|| OleError::InvalidData("comparison leaves the file".to_string()))?;
+    bytes
+        .get(start..end)
+        .ok_or_else(|| OleError::InvalidData("comparison leaves the file".to_string()))
+}
