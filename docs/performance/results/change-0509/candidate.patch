+    struct FailingSink;
+
+    impl Write for FailingSink {
+        fn write(&mut self, _bytes: &[u8]) -> io::Result<usize> {
+            Err(io::Error::other("injected sink failure"))
+        }
+
+        fn flush(&mut self) -> io::Result<()> {
