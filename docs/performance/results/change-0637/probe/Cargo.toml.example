# Manifest template for change 0637's PPTX catalog probe.
# Build one copy per leg with its own `CARGO_TARGET_DIR`, pointing the path
# dependencies at that leg's checkout.

[package]
name = "probe0637-pptx"
version = "0.1.0"
edition = "2024"

[workspace]

[dependencies]
litchi-pptx = { path = "REPLACE_WITH_CHECKOUT/crates/litchi-pptx" }
litchi-core = { path = "REPLACE_WITH_CHECKOUT/crates/litchi-core" }
sha2 = "0.10"

[profile.release]
lto = true
panic = "abort"
debug = 1
