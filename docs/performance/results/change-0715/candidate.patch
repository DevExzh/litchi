+    fn old_two_pass(document: &MutableDocument) -> Result<SectionPublicationReferences> {
+        let mut parts: Vec<(bool, SectionHeaderFooterPart)> = Vec::new();
+        collect_section_parts(document.section(), &mut parts)?;
+        old_collect_body_parts(&document.body, &mut parts)?;
+
+        let mut unique: Vec<(bool, SectionHeaderFooterPart)> = Vec::new();
+        for (header, part) in parts {
+            if let Some((existing_header, existing)) =
+                unique.iter().find(|(_, existing)| existing.key == part.key)
+            {
+                if *existing_header != header || existing.xml != part.xml {
+                    return Err(Error::InvalidFormat(format!(
+                        "section header/footer key {:?} has conflicting definitions",
+                        part.key
+                    )));
+                }
+            } else {
+                unique.push((header, part));
+            }
+        }
+
+        let mut relationships = Vec::new();
+        collect_explicit_section_relationships(document.section(), &mut relationships);
+        old_collect_body_relationships(&document.body, &mut relationships)?;
+        relationships.sort();
+        relationships.dedup();
+        Ok(SectionPublicationReferences {
+            parts: unique,
+            relationships,
+        })
+    }
+
+    fn old_collect_body_parts(
+        body: &DocumentBody,
+        parts: &mut Vec<(bool, SectionHeaderFooterPart)>,
+    ) -> Result<()> {
+        for element in &body.elements {
+            match element {
+                BodyElement::Paragraph(paragraph) => {
+                    if let Some(section) = paragraph.section_break() {
+                        collect_section_parts(section, parts)?;
+                    }
+                },
+                BodyElement::PreservedParagraph(raw) => {
+                    if let Some((start, end)) = paragraph_section_range(raw)? {
+                        collect_section_parts(
+                            &SectionProperties::from_xml(&raw[start..end])?,
+                            parts,
+                        )?;
+                    }
+                },
+                BodyElement::Table(_)
+                | BodyElement::PreservedTable(_)
+                | BodyElement::PreservedSectionProperties(_)
+                | BodyElement::PreservedAlt(..)
+                | BodyElement::PreservedOther(_) => {},
+            }
+        }
+        Ok(())
+    }
+
+    fn old_collect_body_relationships(
+        body: &DocumentBody,
+        relationships: &mut Vec<(String, bool)>,
+    ) -> Result<()> {
+        for element in &body.elements {
+            match element {
+                BodyElement::Paragraph(paragraph) => {
+                    if let Some(section) = paragraph.section_break() {
+                        collect_explicit_section_relationships(section, relationships);
+                    }
+                },
+                BodyElement::PreservedParagraph(raw) => {
+                    if let Some((start, end)) = paragraph_section_range(raw)? {
+                        collect_explicit_section_relationships(
+                            &SectionProperties::from_xml(&raw[start..end])?,
+                            relationships,
+                        );
+                    }
+                },
+                BodyElement::Table(_)
+                | BodyElement::PreservedTable(_)
+                | BodyElement::PreservedSectionProperties(_)
+                | BodyElement::PreservedAlt(..)
+                | BodyElement::PreservedOther(_) => {},
+            }
+        }
+        Ok(())
+    }
+
+    fn compare_with_old_two_pass(document: &MutableDocument) {
+        let expected = old_two_pass(document).map_err(|error| error.to_string());
+        let actual = document
+            .collect_section_publication_references()
+            .map_err(|error| error.to_string());
+        assert_eq!(actual, expected);
+    }
+
+    fn assert_invalid_format(result: Result<SectionPublicationReferences>, expected: &str) {
+        match result {
+            Err(Error::InvalidFormat(message)) => assert_eq!(message, expected),
+            Err(error) => panic!("expected InvalidFormat, got {error}"),
+            Ok(_) => panic!("expected InvalidFormat({expected:?})"),
+        }
+    }
+
+    fn preserved_paragraph_document(raw: &str) -> MutableDocument {
+        let mut document = MutableDocument::new();
+        document
+            .body
+            .elements
+            .push(BodyElement::PreservedParagraph(raw.to_owned()));
+        document
+    }
