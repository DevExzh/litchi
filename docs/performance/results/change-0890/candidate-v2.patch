--- a/crates/litchi-ooxml-common/src/mce/tests.rs
+++ b/crates/litchi-ooxml-common/src/mce/tests.rs
@@ -425,6 +425,109 @@ mod preservation_tests {
             Err(Error::NonConformant(message)) if message == "unbound prefix xmlns"
         ));
     }
+
+    #[test]
+    fn unprefixed_attributes_reuse_validation_inside_a_default_namespace() {
+        let source = format!(
+            r#"<r xmlns:mc="{MC}" xmlns="urn:default" xmlns:x="urn:ext" mc:Ignorable="x"><item plain="ok" x:drop="no"/></r>"#
+        );
+        let (actual, report) = run(&source).expect("default namespace attributes remain valid");
+        assert_eq!(
+            actual,
+            format!(
+                r#"<r xmlns:mc="{MC}" xmlns="urn:default" xmlns:x="urn:ext"><item plain="ok"></item></r>"#
+            )
+        );
+        assert_eq!(
+            report,
+            Report {
+                ignored_attributes: 2,
+                ..Report::default()
+            }
+        );
+    }
+
+    #[test]
+    fn inherited_opaque_paths_still_validate_malformed_attribute_names() {
+        let source = format!(
+            r#"<r xmlns:mc="{MC}" xmlns:e="urn:ext"><e:opaque><child bad!name="1"/></e:opaque></r>"#
+        );
+        let mut capabilities = Capabilities::new();
+        capabilities.preserve_extension_element(Name {
+            namespace: "urn:ext".to_owned(),
+            local_name: "opaque".to_owned(),
+        });
+
+        assert!(matches!(
+            run_with(&source, &capabilities, &Limits::default()),
+            Err(Error::NonConformant(message))
+                if message == "invalid QName: invalid XML QName 'bad!name'"
+        ));
+    }
+
+    #[test]
+    fn inactive_choice_attributes_do_not_change_report_counters() {
+        let source = format!(
+            r#"<r xmlns:mc="{MC}" xmlns:u="urn:unsupported"><mc:AlternateContent><mc:Choice Requires="u" mc:Ignorable="u" u:flag="discarded"/><mc:Fallback><kept/></mc:Fallback></mc:AlternateContent></r>"#
+        );
+        let (actual, report) = run(&source).expect("inactive choice remains well formed");
+        assert_eq!(
+            actual,
+            format!(r#"<r xmlns:mc="{MC}" xmlns:u="urn:unsupported"><kept></kept></r>"#)
+        );
+        assert_eq!(
+            report,
+            Report {
+                alternate_content_count: 1,
+                selected_fallbacks: 1,
+                ..Report::default()
+            }
+        );
+    }
+
+    #[test]
+    fn directive_and_malformed_attribute_errors_follow_source_order() {
+        for malformed in ["x:bad:attr", "bad!name"] {
+            let malformed_first = format!(
+                r#"<r xmlns:mc="{MC}" xmlns:x="urn:x" valid="1" {malformed}="1" mc:NotARealDirective="1"/>"#
+            );
+            assert!(matches!(
+                run(&malformed_first),
+                Err(Error::NonConformant(message))
+                    if message == format!("invalid QName: invalid XML QName '{malformed}'")
+            ));
+
+            let directive_first = format!(
+                r#"<r xmlns:mc="{MC}" xmlns:x="urn:x" valid="1" mc:NotARealDirective="1" {malformed}="1"/>"#
+            );
+            assert!(matches!(
+                run(&directive_first),
+                Err(Error::NonConformant(message)) if message == "unknown MCE attribute"
+            ));
+        }
+    }
+
+    #[test]
+    fn name_reuse_does_not_bypass_duplicate_or_directive_token_limits() {
+        let duplicate = format!(
+            r#"<r xmlns:mc="{MC}" xmlns:a="urn:same" xmlns:b="urn:same" a:value="1" b:value="2"/>"#
+        );
+        assert!(matches!(
+            run(&duplicate),
+            Err(Error::NonConformant(message)) if message == "duplicate attribute"
+        ));
+
+        let token_limited =
+            format!(r#"<r xmlns:mc="{MC}" xmlns:x="urn:x" xmlns:y="urn:y" mc:Ignorable="x y"/>"#);
+        let limits = Limits {
+            max_directive_tokens: 1,
+            ..Limits::default()
+        };
+        assert!(matches!(
+            run_with(&token_limited, &Capabilities::new(), &limits),
+            Err(Error::LimitExceeded(message)) if message == "directive tokens"
+        ));
+    }
 }
 
