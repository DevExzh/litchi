+    fn presentation_with_auxiliary_member() -> Result<Presentation> {
+        let mut builder = Builder::new();
+        builder.add_slide_with_title("First", "First body")?;
+        let base = Presentation::from_bytes(builder.build()?)?;
+        let base_package = base.owned_package();
+        let package = base_package.package()?;
+        let mut manifest = b"\xef\xbb\xbf<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- retained noncompact manifest -->\n<m:manifest xmlns:m=\"urn:oasis:names:tc:opendocument:xmlns:manifest:1.0\" m:version=\"1.3\">\n".to_vec();
+        for (path, entry) in &package.manifest().entries {
+            manifest.extend_from_slice(
+                format!(
+                    "  <m:file-entry m:full-path=\"{path}\" m:media-type=\"{}\"/>\n",
+                    entry.media_type
+                )
+                .as_bytes(),
+            );
+        }
+        manifest.extend_from_slice(
+            b"  <m:file-entry m:full-path=\"vendor/foreign.xml\" m:media-type=\"text/xml\"/>\n  <m:file-entry m:full-path=\"vendor/opaque.bin\" m:media-type=\"application/octet-stream\"/>\n</m:manifest>\n",
+        );
+
+        let mut archive = StreamingArchiveWriter::new();
+        archive
+            .write_stored("mimetype", base_package.mimetype()?.as_bytes())
+            .unwrap();
+        for path in package.files()? {
+            if matches!(path.as_str(), "mimetype" | "META-INF/manifest.xml") {
+                continue;
+            }
+            archive
+                .write_deflated(&path, &package.get_file(&path)?)
+                .unwrap();
+        }
+        archive
+            .write_deflated("vendor/foreign.xml", b"<foreign>\n  <opaque/>\n</foreign>")
+            .unwrap();
+        archive
+            .write_deflated("vendor/opaque.bin", b"producer-owned-auxiliary")
+            .unwrap();
+        archive
+            .write_deflated("META-INF/manifest.xml", &manifest)
+            .unwrap();
+        Presentation::from_bytes(archive.finish_to_bytes().unwrap())
+    }
+
+    #[test]
+    fn proof_covers_preserved_manifest_and_exact_auxiliary_copy() -> Result<()> {
+        let presentation = presentation_with_auxiliary_member()?;
+        let source_manifest = presentation
+            .owned_package()
+            .get_file("META-INF/manifest.xml")?;
+        let validated_slides = Arc::from(presentation.slides()?);
+        let draft = MutablePresentation::from_presentation_with_validated_slides(
+            &presentation,
+            &validated_slides,
+        )?;
+        let (package, proof) = draft.to_owned_package_bounded(FINAL_PACKAGE_BYTES)?;
+        assert_eq!(package.get_file("META-INF/manifest.xml")?, source_manifest);
+        assert_eq!(
+            package.get_file("vendor/opaque.bin")?,
+            b"producer-owned-auxiliary"
+        );
+        assert_eq!(
+            package.get_file("vendor/foreign.xml")?,
+            b"<foreign>\n  <opaque/>\n</foreign>"
+        );
+        let proof = proof.expect("preserved authored publication should be auditable");
+        assert!(proof.covers(
+            &package,
+            presentation.owned_package(),
+            final_limits(),
+            FINAL_PACKAGE_BYTES,
+            FINAL_XML_PARTS,
+        ));
+        Ok(())
+    }
