+        )?;
+        let (package, proof) = draft.to_owned_package_bounded(FINAL_PACKAGE_BYTES)?;
+        let proof = proof.expect("successful authored publication should be auditable");
+        let profiles = [
+            audit::Limits::new(
+                31 * 1024 * 1024,
+                256,
+                1_000_000,
+                250_000,
+                4 * 1024 * 1024,
+                16 * 1024 * 1024,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+            audit::Limits::new(
+                32 * 1024 * 1024,
+                255,
+                1_000_000,
+                250_000,
+                4 * 1024 * 1024,
+                16 * 1024 * 1024,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+            audit::Limits::new(
+                32 * 1024 * 1024,
+                256,
+                999_999,
+                250_000,
+                4 * 1024 * 1024,
+                16 * 1024 * 1024,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+            audit::Limits::new(
+                32 * 1024 * 1024,
+                256,
+                1_000_000,
+                249_999,
+                4 * 1024 * 1024,
+                16 * 1024 * 1024,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+            audit::Limits::new(
+                32 * 1024 * 1024,
+                256,
+                1_000_000,
+                250_000,
+                4 * 1024 * 1024 - 1,
+                16 * 1024 * 1024,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+            audit::Limits::new(
+                32 * 1024 * 1024,
+                256,
+                1_000_000,
+                250_000,
+                4 * 1024 * 1024,
+                16 * 1024 * 1024 - 1,
+            )
+            .expect("fixed narrower audit profile should be valid"),
+        ];
+
+        for limits in profiles {
+            assert!(!proof.covers(
+                &package,
+                presentation.owned_package(),
+                limits,
+                FINAL_PACKAGE_BYTES,
+                FINAL_XML_PARTS,
+            ));
+        }
+        Ok(())
+    }
