+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+struct AuthoredXmlAccounting {
+    bytes: usize,
+    parts: usize,
+    core_parts: usize,
+    eligible: bool,
+}
+
+impl AuthoredXmlAccounting {
+    fn new() -> Self {
+        Self {
+            eligible: true,
+            ..Self::default()
+        }
+    }
+
+    fn record(&mut self, path: &str, bytes: usize, media_type: &str, core: bool) {
+        if !audit::package::is_xml_part(path, media_type) {
+            if core {
+                self.eligible = false;
+            }
+            return;
+        }
+
+        let Some(total_bytes) = self.bytes.checked_add(bytes) else {
+            self.eligible = false;
+            return;
+        };
+        let Some(total_parts) = self.parts.checked_add(1) else {
+            self.eligible = false;
+            return;
+        };
+        let total_core_parts = if core {
+            let Some(total_core_parts) = self.core_parts.checked_add(1) else {
+                self.eligible = false;
+                return;
+            };
+            total_core_parts
+        } else {
+            self.core_parts
+        };
+        self.bytes = total_bytes;
+        self.parts = total_parts;
+        self.core_parts = total_core_parts;
+    }
+
+    fn into_proof_budget(self) -> Option<(usize, usize)> {
+        if !self.eligible || self.core_parts != AUTHORED_CORE_XML_PARTS {
+            return None;
+        }
+        Some((
+            self.bytes
+                .checked_add(audit::Limits::default().max_bytes())?,
+            self.parts.checked_add(MANIFEST_XML_PARTS)?,
+        ))
+    }
+}
