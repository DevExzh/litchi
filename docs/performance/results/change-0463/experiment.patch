+            presentation.owned_package(),
+            FINAL_PACKAGE_BYTES + 1,
+            FINAL_XML_PARTS,
+        );
+        assert!(!bytes_over.covers(
+            &package,
+            presentation.owned_package(),
+            final_limits(),
+            FINAL_PACKAGE_BYTES,
+            FINAL_XML_PARTS,
+        ));
+
+        let parts_over = proof_with_budget(
+            &package,
+            presentation.owned_package(),
+            FINAL_PACKAGE_BYTES,
+            FINAL_XML_PARTS + 1,
+        );
+        assert!(!parts_over.covers(
+            &package,
+            presentation.owned_package(),
+            final_limits(),
+            FINAL_PACKAGE_BYTES,
+            FINAL_XML_PARTS,
+        ));
+        Ok(())
+    }
