+/// Proof that the bounded writer audited authored members against one exact
+/// source package publication.
+///
+/// This is deliberately private to the ODP authoring path.  It is never cached
+/// on [`MutablePresentation`]; the candidate and source byte owners bind it to
+/// the one successful serialization that produced it.
+pub(super) struct PublicationAuditProof {
+    candidate: Arc<Vec<u8>>,
+    source: Arc<Vec<u8>>,
+    authored_xml_bytes: usize,
+    authored_xml_parts: usize,
+    limits: audit::Limits,
+}
+
+impl PublicationAuditProof {
+    fn from_successful_serialization(
+        candidate: Arc<Vec<u8>>,
+        source: Option<Arc<Vec<u8>>>,
+        accounting: AuthoredXmlAccounting,
+    ) -> Option<Self> {
+        let source = source?;
+        let (authored_xml_bytes, authored_xml_parts) = accounting.into_proof_budget()?;
+        Some(Self {
+            candidate,
+            source,
+            authored_xml_bytes,
+            authored_xml_parts,
+            limits: audit::Limits::default(),
+        })
+    }
+
+    pub(super) fn covers(
+        &self,
+        candidate: &OwnedPackage,
+        source: &OwnedPackage,
+        final_limits: audit::Limits,
+        final_max_bytes: usize,
+        final_max_parts: usize,
+    ) -> bool {
+        let candidate_bytes = candidate.shared_bytes();
+        if !Arc::ptr_eq(&self.candidate, &candidate_bytes) {
+            return false;
+        }
+
+        let source_bytes = source.shared_bytes();
+        if !Arc::ptr_eq(&self.source, &source_bytes) {
+            return false;
+        }
+
+        let captured = self.limits;
+        if captured.max_attributes() > final_limits.max_attributes()
+            || captured.max_bytes() > final_limits.max_bytes()
+            || captured.max_depth() > final_limits.max_depth()
+            || captured.max_events() > final_limits.max_events()
+            || captured.max_text_bytes() > final_limits.max_text_bytes()
+            || captured.max_token_bytes() > final_limits.max_token_bytes()
+        {
+            return false;
+        }
+
+        self.authored_xml_bytes <= final_max_bytes && self.authored_xml_parts <= final_max_parts
+    }
+}
+
+struct SerializedPublication {
+    bytes: Vec<u8>,
+    source: Option<Arc<Vec<u8>>>,
+    accounting: AuthoredXmlAccounting,
+}
 
