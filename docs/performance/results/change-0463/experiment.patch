+    #[test]
+    fn ineligible_or_overflowed_audit_budget_falls_back_without_an_error() {
+        let mut non_xml_core = super::AuthoredXmlAccounting::new();
+        non_xml_core.record("core.part", 1, "application/octet-stream", true);
+        assert_eq!(non_xml_core.into_proof_budget(), None);
+
+        let mut overflow = super::AuthoredXmlAccounting {
+            bytes: usize::MAX,
+            parts: 3,
+            core_parts: 3,
+            eligible: true,
+        };
+        overflow.record("custom.xml", 1, "text/xml", false);
+        assert_eq!(overflow.into_proof_budget(), None);
+
+        let manifest_bytes_overflow = super::AuthoredXmlAccounting {
+            bytes: usize::MAX - audit::Limits::default().max_bytes() + 1,
+            parts: 3,
+            core_parts: 3,
+            eligible: true,
+        };
+        assert_eq!(manifest_bytes_overflow.into_proof_budget(), None);
+
+        let manifest_parts_overflow = super::AuthoredXmlAccounting {
+            bytes: 0,
+            parts: usize::MAX,
+            core_parts: 3,
+            eligible: true,
+        };
+        assert_eq!(manifest_parts_overflow.into_proof_budget(), None);
+    }
