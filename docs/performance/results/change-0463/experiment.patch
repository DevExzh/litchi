+    #[test]
+    fn proof_rejects_each_narrower_document_limit_profile() -> Result<()> {
+        let presentation = presentation_with_two_slides()?;
+        let validated_slides = Arc::from(presentation.slides()?);
+        let draft = MutablePresentation::from_presentation_with_validated_slides(
