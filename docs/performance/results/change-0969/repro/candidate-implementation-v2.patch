+fn source_layout_projection_matches_full_capture_for_all_stream_classes() {
+    for sector_size in [512, 4096] {
+        let original = write_cfb_with_sector_size(sector_size, |writer| {
+            writer.set_root_state_bits(0x1020_3040);
+            writer.set_root_creation_time_from_source(0x0102_0304_0506_0708);
+            writer.set_root_modified_time(0x1112_1314_1516_1718);
+            writer.create_stream(&["Empty"], &[]).unwrap();
+            writer.create_stream(&["Small"], &[0x11; 31]).unwrap();
+            writer.create_stream(&["Regular"], &[0x22; 5_000]).unwrap();
+            writer.create_storage(&["ObjectPool"]).unwrap();
+            writer.create_storage(&["ObjectPool", "_42"]).unwrap();
+            writer
+                .set_storage_metadata(
+                    &["ObjectPool", "_42"],
+                    0xA1A2_A3A4,
+                    0x2122_2324_2526_2728,
+                    0x3132_3334_3536_3738,
+                )
+                .unwrap();
+            writer
+                .create_stream(&["ObjectPool", "_42", "NestedEmpty"], &[])
+                .unwrap();
+            writer
+                .create_stream(&["ObjectPool", "_42", "NestedSmall"], &[0x33; 63])
+                .unwrap();
+            writer
+                .create_stream(
+                    &["ObjectPool", "_42", "NestedRegular"],
+                    &[0x44; 8_192],
+                )
+                .unwrap();
+            writer
+                .set_stream_metadata(
+                    &["ObjectPool", "_42", "NestedRegular"],
+                    0xB1B2_B3B4,
+                    0x4142_4344_4546_4748,
+                    0x5152_5354_5556_5758,
+                )
+                .unwrap();
+        });
+        let selected = targets("object", &["ObjectPool", "_42"]);
+        let mut editor = Editor::open(original, selected.clone(), Limits::default())
+            .expect("source should open");
+        let unchanged = editor
+            .stream_shared(&[
+                "ObjectPool".to_string(),
+                "_42".to_string(),
+                "NestedRegular".to_string(),
+            ])
+            .expect("regular stream should be captured");
+        let replacement: Arc<[u8]> = Arc::from(vec![0xA5; 5_000]);
+        let rendered = editor
+            .put_stream_shared_with_rendered(&["Small".to_string()], Arc::clone(&replacement))
+            .expect("size-changing stream edit should commit");
+        assert!(Arc::ptr_eq(
+            &replacement,
+            &editor
+                .stream_shared(&["Small".to_string()])
+                .expect("replaced stream should be retained")
+        ));
+        assert!(Arc::ptr_eq(
+            &unchanged,
+            &editor
+                .stream_shared(&[
+                    "ObjectPool".to_string(),
+                    "_42".to_string(),
+                    "NestedRegular".to_string(),
+                ])
+                .expect("unchanged stream should retain its allocation")
+        ));
+        let mut oracle_file = OleFile::open(Cursor::new(rendered.clone()))
+            .expect("rendered CFB should reopen");
+        let oracle = discover(&mut oracle_file, &selected, Limits::default())
+            .expect("independent full capture should pass");
+        let projected = editor
+            .objects()
+            .get("object")
+            .expect("projected object should remain selected");
+        let captured = oracle
+            .get("object")
+            .expect("oracle object should remain selected");
+        assert_eq!(projected.storage().path(), captured.storage().path());
+        assert_eq!(projected.storage().directory(), captured.storage().directory());
+        assert_eq!(projected.storages().len(), captured.storages().len());
+        for (left, right) in projected.storages().iter().zip(captured.storages()) {
+            assert_eq!(left.path(), right.path());
+            assert_eq!(left.directory(), right.directory());
+        }
+        assert_eq!(projected.streams().len(), captured.streams().len());
+        for (left, right) in projected.streams().iter().zip(captured.streams()) {
+            assert_eq!(left.path(), right.path());
+            assert_eq!(left.bytes(), right.bytes());
+            assert_eq!(left.directory(), right.directory());
+        }
+        assert_eq!(editor.finish().expect("editor should finish"), rendered);
+    }
