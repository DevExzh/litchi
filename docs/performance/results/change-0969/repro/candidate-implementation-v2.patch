+        if let Some(root) = model.root_directory.as_mut() {
+            root.set_class_id(Some(root_class))
+                .set_state_bits(0x1020_3040)
+                .set_creation_time(0x0102_0304_0506_0708)
+                .set_modified_time(0x1112_1314_1516_1718);
+            model.root_clsid = Some(root_class);
+        }
+        for (index, storage) in model.storages.clone().iter().enumerate() {
+            let mut directory = *storage.directory();
+            directory
+                .set_class_id(Some(Guid::from_bytes([0x20 + index as u8; 16])))
+                .set_state_bits(0x2020_0000 + index as u32)
+                .set_creation_time(0x2122_2324_2526_2728 + index as u64)
+                .set_modified_time(0x3132_3334_3536_3738 + index as u64);
+            model.storages[index] = Storage::new(storage.path().to_vec(), directory);
+        }
+        for (index, stream) in model.streams.clone().iter().enumerate() {
+            let mut directory = stream
