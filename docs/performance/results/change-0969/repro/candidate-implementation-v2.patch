+/// The output of the operation-local source-layout render used by an editor
+/// commit.  The optional receipt is private to this module and is only
+/// created after a fresh writer has successfully emitted a validated reuse
+/// plan into the accompanying `Vec`.
+pub(crate) struct RenderedCommit<'a> {
+    bytes: Vec<u8>,
+    reuse: Option<ValidatedReuse<'a>>,
+    model: &'a Package,
+    limits: Limits,
+}
+
+impl<'a> RenderedCommit<'a> {
+    pub(crate) fn ordinary(bytes: Vec<u8>, model: &'a Package, limits: Limits) -> Self {
+        Self {
+            bytes,
+            reuse: None,
+            model,
+            limits,
+        }
+    }
+
+    pub(crate) fn capture(self) -> Result<(Package, Vec<u8>), OleError> {
+        let Self {
+            bytes,
+            reuse,
+            model,
+            limits,
+        } = self;
+        let mut check = OleFile::open(Cursor::new(bytes.as_slice()))?;
+        open(&check, limits.max_package_directory_entries())?;
+        let parsed = if let Some(reuse) = reuse {
+            Package::capture_with_receipt(&mut check, reuse)?
+        } else {
+            let mut parsed = Package::capture(&mut check, limits)?;
+            parsed.reuse_stream_allocations(model)?;
+            parsed
+        };
+        Ok((parsed, bytes))
+    }
+}
+
+/// A proof that the model and source borrowed here are the ones used to
+/// produce `RenderedCommit::bytes`.  This type cannot be constructed outside
+/// this module, and it is consumed before the editor publishes its package.
+struct ValidatedReuse<'a> {
+    model: &'a Package,
+    source: &'a [u8],
+    limits: Limits,
+}
+
+#[derive(Debug)]
+enum CaptureWalkError {
+    Cfb(OleError),
+    Declined,
+}
+
+impl From<OleError> for CaptureWalkError {
+    fn from(error: OleError) -> Self {
+        Self::Cfb(error)
+    }
+}
+
+/// Bounded path index used only while proving that a final CFB directory is
+/// the same logical model that the validated writer emitted.
+struct ProjectionIndex<'a> {
+    storages: HashMap<&'a [String], (&'a Storage, bool)>,
+    streams: HashMap<&'a [String], (&'a Stream, bool)>,
+}
+
+impl<'a> ProjectionIndex<'a> {
+    fn new(model: &'a Package) -> Result<Self, ()> {
+        Self::new_with_reserves(model, model.storages.len(), model.streams.len())
+    }
+
+    fn new_with_reserves(
+        model: &'a Package,
+        storage_reserve: usize,
+        stream_reserve: usize,
+    ) -> Result<Self, ()> {
+        let mut storages = HashMap::new();
+        storages.try_reserve(storage_reserve).map_err(|_| ())?;
+        for storage in &model.storages {
+            if storages.insert(storage.path(), (storage, false)).is_some() {
+                return Err(());
+            }
+        }
+
+        let mut streams = HashMap::new();
+        streams.try_reserve(stream_reserve).map_err(|_| ())?;
+        for stream in &model.streams {
+            if streams.insert(stream.path(), (stream, false)).is_some() {
+                return Err(());
+            }
+        }
+
+        Ok(Self { storages, streams })
+    }
+
+    fn stream_bytes(&self, path: &[String], size: u64) -> Option<Arc<[u8]>> {
+        let (stream, _) = self.streams.get(path)?;
+        let bytes = stream.bytes_shared();
+        (bytes.len() as u64 == size).then_some(bytes)
+    }
+
+    fn verify_package(&mut self, package: &Package) -> bool {
+        for storage in &package.storages {
+            let Some((_expected, seen)) = self.storages.get_mut(storage.path()) else {
+                return false;
+            };
+            if *seen {
+                return false;
+            }
+            *seen = true;
+        }
+        for stream in &package.streams {
+            let Some((expected, seen)) = self.streams.get_mut(stream.path()) else {
+                return false;
+            };
+            if *seen || !Arc::ptr_eq(&expected.bytes_shared(), &stream.bytes_shared()) {
+                return false;
+            }
+            *seen = true;
+        }
+        self.storages.values().all(|(_, seen)| *seen)
+            && self.streams.values().all(|(_, seen)| *seen)
+    }
 }
 
