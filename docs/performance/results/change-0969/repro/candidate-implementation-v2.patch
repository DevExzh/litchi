+                let rendered = model
+                    .render_with_layout_for_commit(&source, SectorLayoutPolicy::Reuse, limits)
+                    .expect("boundary render should succeed");
+                let has_receipt = rendered.reuse.is_some();
+                positive_receipts += usize::from(has_receipt);
