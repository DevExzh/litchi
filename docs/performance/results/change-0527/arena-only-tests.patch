+#[test]
+fn snapshot_scan_resolves_each_row_arena_range_to_its_own_payload_markers() {
+    let source = format!(
+        r#"<x:worksheet xmlns:x="{MAIN}"><x:sheetData><x:row r="1"><x:c r="A1"><x:v>row-one-a</x:v><!--row-one-gap--><x:f>row-one-f</x:f></x:c><x:c r="B1"><x:v>row-one-b</x:v></x:c><x:c r="C1"/></x:row><q:row xmlns:q="{MAIN}" r="2"><q:c r="A2"><q:v>row-two-a</q:v><q:is><q:t>row-two-is</q:t></q:is></q:c><q:c r="B2"/></q:row><x:row r="3"/></x:sheetData></x:worksheet>"#
+    )
+    .into_bytes();
+    let layout = scan(&source).expect("worksheet scan");
+    assert_eq!(layout.sheet_data.rows.len(), 3);
+
+    let row_one = &layout.sheet_data.rows[0];
+    assert_eq!(row_one.primary.len(), 3);
+    let a1 = &row_one.cells[0];
+    let a1_spans = row_one
+        .primary
+        .get(a1.primary.clone())
+        .expect("A1 arena range");
+    assert_eq!(a1_spans.len(), 2);
+    assert_eq!(
+        &source[a1_spans[0].start..a1_spans[0].end],
+        b"<x:v>row-one-a</x:v>"
+    );
+    assert_eq!(
+        &source[a1_spans[1].start..a1_spans[1].end],
+        b"<x:f>row-one-f</x:f>"
+    );
+    assert!(a1_spans.windows(2).all(|pair| pair[0].end <= pair[1].start));
+    assert!(a1_spans
+        .iter()
+        .all(|span| span.start >= a1.tag_end && span.end <= a1.close_start));
+
+    let b1 = &row_one.cells[1];
+    let b1_spans = row_one
+        .primary
+        .get(b1.primary.clone())
+        .expect("B1 arena range");
+    assert_eq!(b1_spans.len(), 1);
+    assert_eq!(
+        &source[b1_spans[0].start..b1_spans[0].end],
+        b"<x:v>row-one-b</x:v>"
+    );
+    assert!(b1_spans[0].start >= b1.tag_end && b1_spans[0].end <= b1.close_start);
+
+    let c1 = &row_one.cells[2];
+    assert!(c1.empty);
+    assert_eq!(c1.primary.start, c1.primary.end);
+
+    let row_two = &layout.sheet_data.rows[1];
+    assert_eq!(row_two.primary.len(), 2);
+    let a2 = &row_two.cells[0];
+    let a2_spans = row_two
+        .primary
+        .get(a2.primary.clone())
+        .expect("A2 arena range");
+    assert_eq!(a2_spans.len(), 2);
+    assert_eq!(
+        &source[a2_spans[0].start..a2_spans[0].end],
+        b"<q:v>row-two-a</q:v>"
+    );
+    assert_eq!(
+        &source[a2_spans[1].start..a2_spans[1].end],
+        b"<q:is><q:t>row-two-is</q:t></q:is>"
+    );
+    let b2 = &row_two.cells[1];
+    assert!(b2.empty);
+    assert_eq!(b2.primary.start, b2.primary.end);
+
+    let row_three = &layout.sheet_data.rows[2];
+    assert!(row_three.empty);
+    assert!(row_three.cells.is_empty());
+    assert!(row_three.primary.is_empty());
+}
