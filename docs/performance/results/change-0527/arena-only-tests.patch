+#[test]
+fn snapshot_writer_rejects_primary_range_outside_owning_row() {
+    let source = format!(
+        r#"<x:worksheet xmlns:x="{MAIN}"><x:sheetData><x:row r="1"><x:c r="A1"><x:v>one</x:v></x:c></x:row></x:sheetData></x:worksheet>"#
+    )
+    .into_bytes();
+    let mut layout = scan(&source).expect("worksheet scan");
+    let row = layout.sheet_data.rows.first_mut().expect("row 1");
+    let arena_len = row.primary.len();
+    row.cells[0].primary = arena_len..arena_len + 1;
+
+    let mut output = Vec::new();
+    let result = write_sheet_data(
+        &mut output,
+        &source,
+        &layout.sheet_data,
+        BTreeMap::from([(
+            Address::from_a1("A1").expect("A1"),
+            Action::set(2_i32.into()),
+        )]),
+        BTreeMap::new(),
+        "",
+    );
+    assert!(matches!(
+        result,
+        Err(crate::error::Error::Invalid(message))
+            if message == "worksheet cell primary span range exceeds its owning row"
+    ));
+}
