+                && is_spreadsheetml_name(namespace, element.name(), b"row") =>
+        {
+            Some(SourceHandoffKind::RowEmpty)
+        },
+        Event::End(element)
+            if parent == Some(Context::Row) && element.local_name().as_ref() == b"row" =>
+        {
+            Some(SourceHandoffKind::RowEnd)
+        },
+        _ => None,
+    }
