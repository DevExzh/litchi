+    #[test]
+    fn checkpoint_counter_boundaries_are_checked_without_overflow() {
+        let mut power_overflow = SectorChainCheckpoint {
+            checkpoint: Some(7),
+            power: usize::MAX / 2 + 1,
+            distance: usize::MAX / 2,
+        };
+        assert!(power_overflow.advance(11, usize::MAX));
+        assert_eq!(power_overflow.checkpoint, Some(11));
+        assert_eq!(power_overflow.distance, 0);
+        assert_eq!(power_overflow.power, usize::MAX);
+
+        let mut distance_overflow = SectorChainCheckpoint {
+            checkpoint: Some(7),
+            power: usize::MAX,
+            distance: usize::MAX,
+        };
+        assert!(!distance_overflow.advance(11, usize::MAX));
+        assert_eq!(distance_overflow.checkpoint, Some(7));
+        assert_eq!(distance_overflow.power, usize::MAX);
+        assert_eq!(distance_overflow.distance, usize::MAX);
+
+        let mut count_bound = SectorChainCheckpoint {
+            checkpoint: Some(7),
+            power: 8,
+            distance: 7,
+        };
+        assert!(!count_bound.advance(11, 7));
+    }
