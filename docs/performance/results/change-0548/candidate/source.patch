+    #[test]
+    fn scratch_exhaustively_matches_owned_helper_for_small_tables() {
+        for length in 0..=4 {
+            let mut values: Vec<u32> = (0..length).map(|value| value as u32).collect();
+            values.extend([
+                length as u32,
+                ENDOFCHAIN,
+                MAXREGSECT,
+                MAXREGSECT + 2,
+                u32::MAX,
+            ]);
+            let mut table = vec![ENDOFCHAIN; length];
+            let mut scratch = SectorChainScratch::default();
+            enumerate_exhaustive_chain_tables(&mut table, &values, 0, &mut scratch);
+        }
+    }
