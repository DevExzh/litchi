+/// Scalar Brent-style checkpoint state for the successful exact chain walk.
+///
+/// The checkpoint schedule is at positions `0, 1, 3, 7, ...`.  A checkpoint
+/// hit proves that a valid sector has repeated, but it is never reported
+/// directly: the prepared authoritative walk is replayed so that the current
+/// cycle/error precedence remains exact.  The counters are private and are
+/// bounded by the declared chain length; checked arithmetic falls back to the
+/// authoritative walk if an impossible state would exceed that bound.
+#[derive(Debug)]
+struct SectorChainCheckpoint {
+    checkpoint: Option<u32>,
+    power: usize,
+    distance: usize,
+}
+
+impl Default for SectorChainCheckpoint {
+    fn default() -> Self {
+        Self {
+            checkpoint: None,
+            power: 1,
+            distance: 0,
+        }
+    }
+}
+
+impl SectorChainCheckpoint {
+    #[inline(always)]
+    fn matches(&self, sector: u32) -> bool {
+        self.checkpoint == Some(sector)
+    }
+
+    /// Advance after the current sector's successor has passed marker checks.
+    ///
+    /// `false` means that checked counter arithmetic could not maintain the
+    /// bounded state.  The caller must replay the prepared authoritative walk
+    /// in that case; no new diagnostic is manufactured here.
+    #[inline(always)]
+    fn advance(&mut self, sector: u32, expected_count: usize) -> bool {
+        if self.checkpoint.is_none() {
+            self.checkpoint = Some(sector);
+            return true;
+        }
+
+        let Some(next_distance) = self.distance.checked_add(1) else {
+            return false;
+        };
+        if next_distance > expected_count {
+            return false;
+        }
+        self.distance = next_distance;
+
+        if self.distance == self.power {
+            self.checkpoint = Some(sector);
+            self.distance = 0;
+            self.power = match self.power.checked_mul(2) {
+                Some(next_power) => next_power.min(expected_count),
+                None => expected_count,
+            };
+        }
+        true
+    }
+}
