+    fn empty_and_single_assignments_avoid_dense_storage() {
+        let assignments = Assignments::<u8>::new();
+        assert!(assignments.nodes.is_empty());
+        assert_eq!(assignments.nodes.capacity(), 0);
+        assert!(assignments.first.is_none());
+        assert_eq!(assignments.get(Index::FIRST), None);
+        assert_eq!(assignments.get(Index::LAST), None);
+        assert!(assignments.into_ranges().expect("empty ranges").is_empty());
+
+        let mut assignments = Assignments::new();
+        let first = Index::new(10).expect("first");
+        let last = Index::new(20).expect("last");
+        assignments.assign(first, last, 7).expect("assign");
+        assert!(assignments.nodes.is_empty());
+        assert_eq!(assignments.nodes.capacity(), 0);
+        assert_eq!(
+            assignments.first,
+            Some(Assigned {
+                first,
+                last,
+                value: 7,
+            })
+        );
+        assert_eq!(assignments.get(first), Some(7));
+        assert_eq!(assignments.get(last), Some(7));
+        assert_eq!(assignments.get(Index::FIRST), None);
+        assert_eq!(assignments.get(Index::LAST), None);
+
+        let ranges = assignments.into_ranges().expect("single range");
+        assert_eq!(
+            &*ranges,
+            &[Assigned {
+                first,
+                last,
+                value: 7,
+            }]
+        );
+    }
