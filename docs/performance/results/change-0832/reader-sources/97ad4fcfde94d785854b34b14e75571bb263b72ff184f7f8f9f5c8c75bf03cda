            ("case", "expected_components", "total_prediction",
             "observed_after_minus_before", "interpretation")}


def same_descriptor(left: Any, right: Any, label: str) -> None:
    require(isinstance(left, dict) and isinstance(right, dict), f"{label} descriptor is missing")
    for key in ("path", "bytes", "sha256"):
        require(left.get(key) == right.get(key), f"{label} {key} differs")


def encoded(value: dict[str, Any]) -> bytes:
    text = json.dumps(value, indent=2, sort_keys=True) + "\n"
    require(len(text.encode("utf-8")) < 5 * 1024 * 1024,
            "audit output is unexpectedly large; complete reports must not be embedded")
    return text.encode("utf-8")


def write_or_check(value: dict[str, Any], check: bool) -> None:
    path = PACKET / "audit.json"
    content = encoded(value)
    # The root reader wrapper deliberately invokes audit.py without flags on
    # every replay, including after cleanup and after the source commit.  The
    # first invocation creates the retained artifact; later invocations use
    # the same byte-for-byte check as --check and never overwrite it.
    if check or path.exists():
        require(path.is_file() and not path.is_symlink(), "audit.json is missing")
        require(path.read_bytes() == content, "audit.json does not replay deterministically")
        return
    try:
        with path.open("xb") as stream:
            stream.write(content)
    except FileExistsError:
        fail("refusing to overwrite retained audit.json")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="replay and compare retained audit.json")
    args = parser.parse_args(argv)
    try:
        write_or_check(build_audit(), args.check)
    except (AuditError, AssertionError, OSError, UnicodeError, ValueError,
            KeyError, TypeError, IndexError) as error:
        print(f"0832 independent audit failed: {error}", file=sys.stderr)
        return 1
    print(json.dumps({"status": "pass", "reports": 180, "samples": 20_304}, sort_keys=True))
    return 0




# ---- 0832 independent reader -----------------------------------------------
# The raw report arithmetic is shared by the two lanes; the functions below
# own this packet's four-source custody, receipt, and assembly decisions.
EXPECTED_SOURCES = set(SOURCE_PATHS)


def _normalise_declared_sources(raw: Any) -> set[str]:
    """Extract source paths from a driver's optional multi-source declaration."""
    if raw is None:
        return set()
    if isinstance(raw, dict):
        keys = {key for key in raw if isinstance(key, str)}
        if keys <= {"before", "after"}:
            result: set[str] = set()
            for value in raw.values():
                result.update(_normalise_declared_sources(value))
            return result
        return {key for key in keys if "/" in key}
    if isinstance(raw, (list, tuple, set)):
        return {item for item in raw if isinstance(item, str) and "/" in item}
    if isinstance(raw, str) and "/" in raw:
        return {raw}
    return set()


def _check_driver_source_declaration() -> None:
    declared = set()
    for name in ("SOURCE_PATHS", "SOURCES", "SOURCE_FILES", "SOURCE_HASHES"):
        declared.update(_normalise_declared_sources(getattr(driver, name, None)))
    if declared:
        require(declared == EXPECTED_SOURCES, "driver source declaration changed")
    source = getattr(driver, "SOURCE", None)
    if isinstance(source, str) and "/" in source:
        require(source in EXPECTED_SOURCES, "driver singular source declaration changed")


def candidate_files(leg: str) -> dict[str, Path]:
    root = PACKET / "candidate" / leg
    require(root.is_dir() and not root.is_symlink(),
            f"missing {leg} candidate source directory")
    files = {}
    for path in root.rglob("*"):
        if path.is_file() and not path.is_symlink():
            rel = str(path.relative_to(root))
            files[rel] = path
    require(set(files) == EXPECTED_SOURCES,
            f"{leg} candidate file set changed")
    return files


def source_hashes(leg: str) -> dict[str, str]:
    return {source: sha256(path) for source, path in candidate_files(leg).items()}


def source_descriptors(leg: str) -> dict[str, dict[str, Any]]:
    return {source: descriptor(path, f"{leg} candidate {source}")
            for source, path in candidate_files(leg).items()}


def source_binding(row: dict[str, Any], leg: str, label: str) -> None:
    hashes = source_hashes(leg)
    packet_hashes = {
        str(Path("candidate") / leg / source): digest
        for source, digest in hashes.items()
    }
    root_hashes = {source: digest for source, digest in hashes.items()}
    if isinstance(row.get("source_map"), dict):
        require(row["source_map"] == root_hashes,
                f"{label} root source map changed")
    received = row.get("source_hashes")
    if received is None:
        received = row.get("sources_sha256")
    if received is None and isinstance(row.get("source_sha256"), dict):
        received = row["source_sha256"]
    if received is not None:
        require(received in (hashes, packet_hashes),
                f"{label} source hash map changed")
        return
    digest = row.get("source_sha256")
    # The driver retains the primary source as a convenient scalar alongside
    # the complete four-file map.  It is checked against the declared primary
    # path when that scalar is present.
    require(digest == hashes[SOURCE], f"{label} primary source hash changed")


def source_plan_value(plan: dict[str, Any]) -> Any:
    for key in ("sources", "source_paths", "source"):
        if key in plan:
            return plan[key]
    return None


def source_plan_matches(plan: dict[str, Any]) -> bool:
    value = source_plan_value(plan)
    if value == list(SOURCE_PATHS) or value == sorted(SOURCE_PATHS):
        return True
    if isinstance(value, dict):
        return _normalise_declared_sources(value) == EXPECTED_SOURCES
    return False


def validate_plan() -> dict[str, Any]:
    plan = read_json(PACKET / "plan.json")
    require(isinstance(plan, dict) and plan.get("schema") == PLAN_SCHEMA,
            "plan schema changed")
    require(plan.get("base") == BASE and plan.get("cpu") == 12,
            "plan identity changed")
    require(source_plan_matches(plan), "plan source paths changed")
    require(plan.get("primary_source") == SOURCE and plan.get("source") == SOURCE,
            "plan primary source changed")
    require(plan.get("cases") == list(CASES), "plan case matrix changed")
    require(plan.get("qualification") == {"samples": 1, "warmup": 0, "reports": 36},
            "qualification plan changed")
    require(plan.get("native") == {"blocks": 6, "warmup": 3,
                                   "orders": [list(row) for row in NATIVE_ORDERS]},
            "native plan changed")
    require(plan.get("observer") == {"blocks": 2, "samples": 3, "warmup": 0,
                                     "orders": [list(row) for row in OBSERVER_ORDERS]},
            "observer plan changed")
    require(plan.get("expected_reports") == 180 and plan.get("expected_samples") == 20_304,
            "planned cardinality changed")
    require(plan.get("expected_fresh_child_commands") == 192,
            "planned fresh command cardinality changed")
    require(plan.get("qualification_admission_required_before_capture") is True,
            "qualification admission requirement changed")
    require(plan.get("quality", {}).get("gates") ==
            ["fmt", "check", "test", "clippy", "doc", "boundaries", "oracle", "harness-test"],
            "quality gate set changed")
    require(plan.get("statistics") == {
        "within_process": "nearest-rank", "across_process": "midpoint median",
        "bootstrap_resamples": 10_000, "seed": 832832, "endpoints": [250, 9749],
    }, "statistics plan changed")
    return plan


def _verify_root_file(raw_path: str, expected_hash: str, label: str) -> None:
    require(isinstance(raw_path, str) and not Path(raw_path).is_absolute()
            and valid_sha(expected_hash), f"invalid {label} entry: {raw_path}")
    path = ROOT / raw_path
    require(not any(item.is_symlink() for item in (path, *path.parents)),
            f"symlink in {label}: {raw_path}")
    path = path.resolve(strict=False)
    require(path.is_relative_to(ROOT) and path.is_file() and not path.is_symlink(),
            f"{label} is missing or escaped: {raw_path}")
    require(sha256(path) == expected_hash, f"{label} changed: {raw_path}")


def validate_custody() -> dict[str, Any]:
    plan = validate_plan()
    _check_driver_source_declaration()
    inputs_path = PACKET / "inputs.json"
    inputs = read_json(inputs_path)
    require(isinstance(inputs, dict) and inputs, "inputs manifest is malformed")
    require(inputs.get("test-data/libreoffice-core/sc/qa/unit/data/xlsx/dateAutofilter.xlsx")
            == REAL_INPUT_SHA256, "real input is not pinned in inputs manifest")
    require(sha256(INPUT) == REAL_INPUT_SHA256 and INPUT.stat().st_size == REAL_INPUT_BYTES,
            "real input bytes or hash changed")
    require(sha256(REFERENCE) == REAL_OUTPUT_SHA256 and REFERENCE.stat().st_size == REAL_OUTPUT_BYTES,
            "pinned ordinary-save output bytes or hash changed")

    before_hashes = source_hashes("before")
    after_hashes = source_hashes("after")
    require(before_hashes.keys() == EXPECTED_SOURCES and after_hashes.keys() == EXPECTED_SOURCES,
            "candidate source map is incomplete")
    require(all(inputs.get(source) == digest for source, digest in before_hashes.items()),
            "frozen before source census is incomplete")
    for raw_path, expected_hash in inputs.items():
        if raw_path in EXPECTED_SOURCES:
            require(expected_hash == before_hashes[raw_path],
                    f"frozen before source hash changed: {raw_path}")
        else:
            _verify_root_file(raw_path, expected_hash, "frozen input")
    architecture_path = PACKET / "architecture-inputs.json"
    architecture = read_json(architecture_path)
    require(isinstance(architecture, dict) and architecture, "normative manifest is malformed")
    frozen_normative = {name: digest for name, digest in inputs.items()
                        if name.startswith("docs/adr/") or name in
                        {"docs/GOAL.md", "docs/CRUD_Scenario_Checklist.md"}}
    require(architecture == frozen_normative, "normative manifest differs from frozen inventory")
    normative = {}
    for raw_path, expected_hash in architecture.items():
        _verify_root_file(raw_path, expected_hash, "normative")
        path = ROOT / raw_path
        normative[raw_path] = {"bytes": path.stat().st_size, "sha256": expected_hash}
    unrelated = {}
    for raw_path, expected_hash in driver.UNRELATED.items():
        _verify_root_file(raw_path, expected_hash, "unrelated input")
        unrelated[raw_path] = expected_hash

    before = source_descriptors("before")
    after = source_descriptors("after")
    production = {}
    for source in SOURCE_PATHS:
        path = ROOT / source
        _verify_root_file(source, after_hashes[source], "production source")
        production[source] = descriptor(path, f"production source {source}")
        require(production[source]["sha256"] == after[source]["sha256"]
                and before[source]["sha256"] != after[source]["sha256"],
                f"production/candidate binding changed: {source}")

    host_path = PACKET / "host.json"
    host = read_json(host_path)
    require(isinstance(host, dict) and isinstance(host.get("affinity"), list)
            and 12 in host["affinity"], "host receipt is incomplete")
    prepare_path = PACKET / "prepare.json"
    prepare = read_json(prepare_path)
    require(prepare.get("status") == "pass" and prepare.get("base") == BASE,
            "prepare receipt is not terminal pass")
    require(prepare.get("plan_sha256") == sha256(PACKET / "plan.json")
            and prepare.get("inputs_sha256") == sha256(inputs_path)
            and prepare.get("host_sha256") == sha256(host_path)
            and valid_sha(prepare.get("baseline_witness_sha256")),
            "prepare custody hashes do not bind plan/host/inputs")
    baseline_path = PACKET / "baseline-witness.json"
    baseline = read_json(baseline_path)
    require(baseline.get("status") == "verified-reusable"
            and baseline.get("base") == BASE
            and baseline.get("packet") == "docs/performance/results/change-0831",
            "baseline reuse witness changed")
    require(prepare.get("baseline_witness_sha256") == sha256(baseline_path),
            "baseline reuse witness hash changed")
    lock_path = PACKET / "lock-parity.json"
    lock = read_json(lock_path)
    require(lock.get("status") == "comparison-complete"
            and valid_sha(lock.get("root_sha256")) and valid_sha(lock.get("tool_sha256")),
            "lock parity receipt is incomplete")
    require(lock["root_sha256"] == sha256(ROOT / "Cargo.lock")
            and lock["tool_sha256"] == sha256(ROOT / "tools/perf-baseline/Cargo.lock"),
            "lock parity source changed")
    require(lock.get("all_external_tool_entries_match_root") == (not bool(lock.get("mismatches"))),
            "lock parity summary is stale")
    return {
        "plan": {"path": relative(PACKET / "plan.json"), "bytes": (PACKET / "plan.json").stat().st_size,
                 "sha256": sha256(PACKET / "plan.json"), "schema": plan["schema"]},
        "inputs": {"path": relative(inputs_path), "bytes": inputs_path.stat().st_size,
                   "sha256": sha256(inputs_path), "entries": len(inputs)},
        "host": descriptor(host_path, "host receipt"),
        "prepare": descriptor(prepare_path, "prepare receipt"),
        "normative": {"manifest": descriptor(architecture_path, "normative manifest"),
                      "files": normative, "count": len(normative)},
        "unrelated": {"count": len(unrelated), "sha256": unrelated},
        "corpus": {"input": {"path": relative(INPUT), "bytes": REAL_INPUT_BYTES,
                              "sha256": REAL_INPUT_SHA256},
                   "pinned_output": {"path": relative(REFERENCE), "bytes": REAL_OUTPUT_BYTES,
                                     "sha256": REAL_OUTPUT_SHA256}},
        "candidate": {"before": before, "after": after, "production": production},
        "lock_parity": descriptor(lock_path, "lock parity receipt"),
        "baseline_witness": descriptor(baseline_path, "baseline reuse witness"),
    }


def expected_source_for_command(name: str) -> tuple[str | None, str | None]:
    parts = name.split("-")
    if parts[0] == "quality" and len(parts) >= 2:
        leg = parts[1]
        if leg in {"before", "after"}:
            return leg, None
    if parts[0] in {"build", "qualification"} and len(parts) >= 2:
        leg = parts[1]
        if leg in {"before", "after"}:
            return leg, leg
    if parts[0] in {"native", "observer"} and len(parts) >= 3:
        leg = parts[2]
        if leg in {"before", "after"}:
            return "after", leg
    return None, None


def validate_stage(name: str, *, source_leg: str | None = None) -> dict[str, Any]:
    path = PACKET / f"{name}.json"
    value = read_json(path)
    require(value.get("status") == "pass", f"{name} is not terminal pass")
    if "terminal" in value:
        require(value["terminal"] in (True, "pass"), f"{name} terminal state changed")
    if "inputs_sha256" in value:
        require(value["inputs_sha256"] == sha256(PACKET / "inputs.json"),
                f"{name} input custody changed")
    if source_leg is not None:
        source_binding(value, source_leg, f"{name} stage")
    return {"path": relative(path), "bytes": path.stat().st_size, "sha256": sha256(path),
            "status": "pass"}


def load_build(leg: str) -> dict[str, Any]:
    receipt = read_json(PACKET / f"build-{leg}.json")
    require(receipt.get("status") == "pass", f"build-{leg} is not terminal pass")
    source_binding(receipt, leg, f"build-{leg}")
    require(receipt.get("inputs_sha256") == sha256(PACKET / "inputs.json"),
            f"build-{leg} input binding changed")
    binaries = receipt.get("binaries")
    require(isinstance(binaries, dict) and set(binaries) == {"native", "observer"},
            f"build-{leg} binary set changed")
    result = {"path": relative(PACKET / f"build-{leg}.json"),
              "bytes": (PACKET / f"build-{leg}.json").stat().st_size,
              "sha256": sha256(PACKET / f"build-{leg}.json"), "status": "pass", "binaries": {}}
    for logical in ("native", "observer"):
        row = descriptor_value(binaries[logical], f"build-{leg}/{logical} binary",
                               allow_cleanup=True)
        require(Path(row["path"]).name == f"{leg}-{logical}",
                f"build-{leg}/{logical} binary path is not bound to its leg")
        result["binaries"][logical] = row
    return result


def decision_input(observer: dict[str, Any]) -> dict[str, Any]:
    row = next(item for item in observer["cases"] if item["id"] == "real-edit")
    return {"case": "real-edit",
            "expected_components": {
                "dense_assignment_trees": {
                    "allocation_calls": -2,
                    "allocated_bytes": -2_097_152,
                },
            },
            "total_prediction": (
                "not exact: inline raw-range materialization is an additional component"),
            "observed_after_minus_before": {
                name: row["after_minus_before"][name]["block_values"]
                for name in ("allocation_calls", "allocated_bytes")},
            "interpretation": "review input only; no automatic adoption or rejection decision"}


def validate_qualification_admission(qualification: dict[str, Any]) -> dict[str, Any]:
    path = PACKET / "qualification-admission.json"
    value = read_json(path)
    require(value.get("status") == "pass" and value.get("reports") == 36
            and value.get("samples") == 36,
            "qualification admission receipt changed")
    require(value.get("analysis_reader_sha256") == sha256(PACKET / "analyze.py")
            and value.get("independent_reader_sha256") == sha256(PACKET / "audit.py"),
            "qualification admission reader identities changed")
    expected = {row["path"]: row["sha256"] for row in qualification["rows"]}
    require(value.get("qualified_report_hashes") == expected,
            "qualification admission report hashes changed")
    return {"path": relative(path), "bytes": path.stat().st_size, "sha256": sha256(path),
            "status": "pass", "reports": 36, "samples": 36}


def _analysis_sources(value: Any, leg: str) -> dict[str, Any]:
    if isinstance(value, dict) and isinstance(value.get("sources"), dict):
        value = value["sources"]
    require(isinstance(value, dict), f"analysis {leg} candidate sources are missing")
    result = {}
    for source in SOURCE_PATHS:
        item = value.get(source)
        if item is None:
            # Permit a map keyed by basename only when unambiguous; the packet
            # itself remains full-path keyed.
            item = value.get(Path(source).name)
        require(item is not None, f"analysis {leg} candidate omitted {source}")
        result[source] = item
    return result


def validate_analysis(counts: dict[str, int], custody: dict[str, Any],
                      stages: dict[str, Any], builds: dict[str, Any],
                      qualification: dict[str, Any], native: dict[str, Any],
                      observer: dict[str, Any], decision: dict[str, Any],
                      install: dict[str, Any] | None,
                      commands: dict[str, Any]) -> dict[str, Any]:
    path = PACKET / "analysis.json"
    analysis = read_json(path)
    require(analysis.get("status") == "pass" and analysis.get("base") == BASE,
            "analysis is not terminal pass")
    require(analysis.get("counts") == counts, "analysis counts differ from raw audit")
    require(analysis.get("plan", {}).get("schema") == PLAN_SCHEMA,
            "analysis plan identity changed")
    same_descriptor(analysis.get("plan"), custody["plan"], "analysis plan")
    same_descriptor(analysis.get("inputs"), custody["inputs"], "analysis inputs")
    candidate = analysis.get("candidate")
    require(isinstance(candidate, dict) and candidate.get("source_count") == len(SOURCE_PATHS),
            "analysis candidate identities are missing")
    for leg in ("before", "after"):
        theirs = _analysis_sources(candidate.get(leg), leg)
        ours = custody["candidate"][leg]
        for source in SOURCE_PATHS:
            same_descriptor(theirs[source], ours[source],
                            f"analysis {leg} candidate {source}")
    for name, stage in stages.items():
        same_descriptor(analysis.get("stages", {}).get(name), stage,
                        f"analysis {name} stage")
    analysis_commands = analysis.get("commands")
    require(isinstance(analysis_commands, dict)
            and analysis_commands.get("fresh_count") == 192
            and analysis_commands.get("baseline_count") == 8
            and analysis_commands.get("total_count") == 200,
            "analysis command custody counts differ")
    ours_commands = {row["name"]: row for row in commands["rows"] if not row["inherited"]}
    theirs_commands = {row.get("name"): row for row in analysis_commands.get("fresh", [])
                       if isinstance(row, dict)}
    require(set(ours_commands) == set(theirs_commands),
            "analysis fresh command identities differ")
    for name, ours_row in ours_commands.items():
        theirs_row = theirs_commands[name]
        for key in ("argv", "source_leg", "binary_leg", "exit_code"):
            require(theirs_row.get(key) == ours_row[key],
                    f"analysis command {name} {key} differs")
    for leg in ("before", "after"):
        analysis_build = analysis.get("builds", {}).get(leg)
        require(isinstance(analysis_build, dict) and analysis_build.get("status") == "pass",
                f"analysis build-{leg} identity is missing")
        for logical in ("native", "observer"):
            same_descriptor(analysis_build.get("binaries", {}).get(logical),
                            builds[leg]["binaries"][logical],
                            f"analysis build-{leg}/{logical}")
    if install is None:
        require(analysis.get("install", {}).get("status") == "not-retained",
                "analysis install identity changed")
    else:
        theirs = analysis.get("install")
        require(isinstance(theirs, dict), "analysis install identity missing")
        # An install receipt may expose either a scalar source or the full map.
        if "sources" in theirs:
            require(_analysis_sources(theirs, "install") == custody["candidate"]["after"],
                    "analysis install source map changed")
        else:
            require(any(theirs.get(key) == value["sha256"]
                        for value in custody["candidate"]["after"].values()
                        for key in ("after", "sha256")),
                    "analysis install identity changed")
    analysis_rows = analysis.get("qualification", {}).get("rows")
    require(isinstance(analysis_rows, list), "analysis qualification identities are missing")
    ours_rows = [{key: row[key] for key in
                  ("label", "path", "bytes", "sha256", "id", "logical", "rss_kib")}
                 for row in qualification["rows"]]
    require(analysis_rows == ours_rows
            and analysis.get("qualification", {}).get("oracle_checked") is True,
            "analysis qualification report identities differ")
    analysis_native = analysis.get("native", {}).get("cases")
    require(isinstance(analysis_native, list) and len(analysis_native) == len(CASES),
            "analysis native case summaries are missing")
    for ours_case in native["cases"]:
        matches = [item for item in analysis_native
                   if isinstance(item, dict) and item.get("id") == ours_case["id"]]
        require(len(matches) == 1
                and native_numeric_projection(matches[0]) ==
                native_numeric_projection(ours_case),
                f"analysis native summary differs: {ours_case['id']}")
    analysis_observer = analysis.get("observer", {}).get("cases")
    require(isinstance(analysis_observer, list) and len(analysis_observer) == len(CASES),
            "analysis observer case summaries are missing")
    for ours_case in observer["cases"]:
        matches = [item for item in analysis_observer
                   if isinstance(item, dict) and item.get("id") == ours_case["id"]]
        require(len(matches) == 1
                and observer_numeric_projection(matches[0]) ==
                observer_numeric_projection(ours_case),
                f"analysis observer summary differs: {ours_case['id']}")
    require(decision_projection(analysis.get("decision_input", {})) ==
            decision_projection(decision), "analysis decision input differs")
    return {"path": relative(path), "bytes": path.stat().st_size,
            "sha256": sha256(path), "matched": True,
            "numeric_case_summaries": len(CASES) * 2,
            "qualification_identities": len(ours_rows)}


def build_audit() -> dict[str, Any]:
    custody = validate_custody()
    commands = validate_commands()
    stages = {}
    for name in (
        "prepare", "quality-before", "build-before", "qualification-before",
        "quality-after", "build-after", "qualification-after", "capture",
    ):
        source_leg = ("before" if name.endswith("-before") else
                      "after" if name.endswith("-after") else None)
        stages[name] = validate_stage(name, source_leg=source_leg)
    for leg in ("before", "after"):
        quality = read_json(PACKET / f"quality-{leg}.json")
        require(quality.get("gates") == 8, f"quality-{leg} gate count changed")
        source_binding(quality, leg, f"quality-{leg}")
    install_path = PACKET / "install.json"
    install_value = read_json(install_path)
    require(install_value.get("status") == "pass"
            and install_value.get("source") == SOURCE,
            "install receipt changed")
    install_hashes = install_value.get("sources_sha256")
    require(install_hashes == source_hashes("after"),
            "install source hash map changed")
    install_sources = install_value.get("sources")
    require(isinstance(install_sources, dict)
            and set(install_sources) == EXPECTED_SOURCES,
            "install source descriptor map changed")
    for source in SOURCE_PATHS:
        same_descriptor(install_sources[source], source_descriptors("after")[source],
                        f"install source {source}")
    install_transitions = install_value.get("transitions")
    require(isinstance(install_transitions, dict)
            and set(install_transitions) == EXPECTED_SOURCES,
            "install source transitions changed")
    before_hashes = source_hashes("before")
    after_hashes = source_hashes("after")
    for source in SOURCE_PATHS:
        require(install_transitions[source] == {
            "before": before_hashes[source], "after": after_hashes[source]},
                f"install source transition changed: {source}")
    install = descriptor(install_path, "install receipt")
    builds = {leg: load_build(leg) for leg in ("before", "after")}
    qualification, oracles = load_qualification(builds)
    admission = validate_qualification_admission(qualification)
    native_meta, native_rows = load_native(builds, oracles)
    observer_meta, observer_rows = load_observer(builds, oracles)
    native_meta["cases"] = [native_summary(native_rows, expected) for expected in CASES]
    observer_meta["cases"] = [observer_summary(observer_rows, expected) for expected in CASES]
    counts = {"qualification_reports": qualification["reports"],
              "qualification_samples": qualification["samples"],
              "native_reports": native_meta["reports"],
              "native_samples": native_meta["samples"],
              "observer_reports": observer_meta["reports"],
              "observer_samples": observer_meta["samples"],
              "reports": 180, "samples": 20_304}
    require(native_meta["reports"] + observer_meta["reports"] +
            qualification["reports"] == 180
            and native_meta["samples"] + observer_meta["samples"] +
            qualification["samples"] == 20_304,
            "total cardinality changed")
    capture = read_json(PACKET / "capture.json")
    require(capture.get("status") == "pass" and capture.get("reports") == 180
            and capture.get("samples") == 20_304
            and capture.get("measured_reports") == 144
            and capture.get("measured_samples") == 20_268
            and capture.get("inputs_sha256") == sha256(PACKET / "inputs.json"),
            "capture receipt changed")
    require(capture.get("qualification_admission_sha256") ==
            sha256(PACKET / "qualification-admission.json"),
            "capture qualification admission binding changed")
    decision = decision_input(observer_meta)
    analysis = validate_analysis(counts, custody, stages, builds, qualification,
                                 native_meta, observer_meta, decision, install,
                                 commands)
    return {"schema": AUDIT_SCHEMA, "status": "pass", "base": BASE,
            "custody": custody, "commands": commands, "stages": stages,
            "install": install, "builds": builds, "counts": counts,
            "qualification": qualification, "qualification_admission": admission,
            "native": native_meta,
            "observer": observer_meta, "analysis": analysis,
            "decision_input": decision,
            "claims": {"native": "descriptive paired process timing and RSS only",
                       "observer": "allocation calls, requested bytes, peaks and signed live-byte deltas only",
                       "observer_latency": False, "pooled_latency": False,
                       "automatic_adoption_decision": False,
                       "historical_comparison": False,
                       "full_report_payloads_retained": False}}



def _inherited_quality_rows(expected_capture: dict[str, list[str]]) -> list[dict[str, Any]]:
    """Independently verify the eight reused 0831 quality command receipts."""
    witness_path = PACKET / "baseline-witness.json"
    witness = read_json(witness_path)
    commands = witness.get("commands")
    require(isinstance(commands, dict) and set(commands) == {
        "fmt", "check", "test", "clippy", "doc", "boundaries", "oracle", "harness-test"},
        "baseline quality command witness is incomplete")
    previous_inputs = witness.get("previous_inputs_sha256")
    require(valid_sha(previous_inputs), "baseline quality input binding is malformed")
    rows = []
    intervals = []
    for gate in sorted(commands):
        item = commands[gate]
        require(isinstance(item, dict), f"baseline quality witness {gate} is malformed")
        terminal_path = ROOT / item["receipt"]
        started_path = ROOT / item["started"]
        log_path = ROOT / item["log"]
        for path, label in ((terminal_path, f"inherited {gate} terminal receipt"),
                            (started_path, f"inherited {gate} start receipt"),
                            (log_path, f"inherited {gate} log")):
            require(path.is_file() and not path.is_symlink(), f"missing {label}")
        require(valid_sha(item.get("receipt_sha256"))
                and sha256(terminal_path) == item["receipt_sha256"],
                f"inherited {gate} receipt hash changed")
        require(valid_sha(item.get("log_sha256")) and sha256(log_path) == item["log_sha256"],
                f"inherited {gate} log hash changed")
        started = read_json(started_path)
        terminal = read_json(terminal_path)
        require(isinstance(started, dict) and isinstance(terminal, dict),
                f"inherited {gate} receipt is malformed")
        for key in ("argv", "cwd", "source_leg", "source_sha256",
                    "input_inventory_sha256", "environment", "started_unix"):
            require(terminal.get(key) == started.get(key),
                    f"inherited {gate} {key} changed")
        require(terminal.get("argv") == expected_capture[f"quality-before-{gate}"],
                f"inherited {gate} argv changed")
        require(terminal.get("cwd") == str(ROOT)
                and terminal.get("source_leg") == "after"
                and terminal.get("source_sha256") == source_hashes("before")[SOURCE]
                and terminal.get("input_inventory_sha256") == previous_inputs
                and terminal.get("exit_code") == 0
                and type(terminal.get("started_unix")) in (int, float)
                and not isinstance(terminal.get("started_unix"), bool)
                and math.isfinite(float(terminal["started_unix"]))
                and type(terminal.get("finished_unix")) in (int, float)
                and not isinstance(terminal.get("finished_unix"), bool)
                and math.isfinite(float(terminal["finished_unix"]))
                and terminal["finished_unix"] >= terminal["started_unix"],
                f"inherited {gate} terminal state changed")
        intervals.append((gate, float(terminal["started_unix"]),
                          float(terminal["finished_unix"])))
        rows.append({
            "name": f"quality-before-{gate}",
            "started": descriptor(started_path, f"inherited {gate} start receipt"),
            "terminal": descriptor(terminal_path, f"inherited {gate} terminal receipt"),
            "log": descriptor(log_path, f"inherited {gate} log"),
            "exit_code": 0, "source_leg": "before", "binary_leg": None,
            "inherited": True,
        })
    intervals.sort(key=lambda row: row[1])
    for previous, current in zip(intervals, intervals[1:]):
        require(previous[2] <= current[1],
                f"inherited quality intervals overlap: {previous[0]} and {current[0]}")
    return rows


def validate_commands() -> dict[str, Any]:
    command_dir = PACKET / "commands"
    require(command_dir.is_dir() and not command_dir.is_symlink(), "commands directory is missing")
    starts = {path.name[:-13]: path for path in command_dir.glob("*.started.json")}
    terminals = {path.name[:-5]: path for path in command_dir.glob("*.json")
                 if not path.name.endswith(".started.json")}
    logs = {path.name[:-4]: path for path in command_dir.glob("*.log")}
    expected_capture = expected_capture_argv()
    all_names = expected_command_names()
    inherited_names = {f"quality-before-{gate}" for gate in
                       ("fmt", "check", "test", "clippy", "doc", "boundaries", "oracle", "harness-test")}
    fresh_names = all_names - inherited_names
    require(set(starts) == set(terminals) == set(logs) == fresh_names,
            "fresh command started/terminal/log sets do not match")
    rows = []
    fresh_intervals = []
    for name in sorted(fresh_names):
        started = read_json(starts[name])
        terminal = read_json(terminals[name])
        require(isinstance(started, dict) and isinstance(terminal, dict),
                f"command {name} receipt is malformed")
        for key in ("argv", "cwd", "source_leg", "input_inventory_sha256", "environment"):
            require(terminal.get(key) == started.get(key),
                    f"command {name} {key} changed at termination")
        for key in ("source_sha256", "source_hashes", "sources_sha256", "source_map"):
            if key in started or key in terminal:
                require(terminal.get(key) == started.get(key),
                        f"command {name} {key} changed at termination")
        require(type(started.get("started_unix")) in (int, float)
                and not isinstance(started.get("started_unix"), bool)
                and math.isfinite(float(started["started_unix"]))
                and terminal.get("started_unix") == started.get("started_unix")
                and type(terminal.get("finished_unix")) in (int, float)
                and not isinstance(terminal.get("finished_unix"), bool)
                and math.isfinite(float(terminal["finished_unix"]))
                and terminal["finished_unix"] >= terminal["started_unix"],
                f"command {name} terminal timing changed")
        require(terminal.get("cwd") == str(ROOT), f"command {name} ran outside root")
        require(terminal.get("input_inventory_sha256") == sha256(PACKET / "inputs.json"),
                f"command {name} input inventory changed")
        require(isinstance(terminal.get("argv"), list) and terminal["argv"]
                and terminal["argv"] == expected_capture[name],
                f"command {name} argv changed")
        source_leg, binary_leg = expected_source_for_command(name)
        require(source_leg is not None and terminal.get("source_leg") == source_leg,
                f"command {name} source leg is wrong")
        source_binding(terminal, source_leg, f"command {name}")
        log = logs[name]
        require(valid_sha(terminal.get("log_sha256")) and sha256(log) == terminal["log_sha256"],
                f"command {name} log hash changed")
        if "log_sha256" in started:
            require(started["log_sha256"] == terminal["log_sha256"],
                    f"command {name} start log hash changed")
        require(type(terminal.get("exit_code")) is int and terminal["exit_code"] == 0,
                f"command {name} did not terminate successfully")
        fresh_intervals.append((name, float(started["started_unix"]),
                                float(terminal["finished_unix"])))
        rows.append({"name": name, "started": descriptor(starts[name], f"{name} start receipt"),
                     "terminal": descriptor(terminals[name], f"{name} terminal receipt"),
                     "log": descriptor(log, f"{name} log"), "exit_code": 0,
                     "argv": terminal["argv"], "source_leg": source_leg,
                     "binary_leg": binary_leg, "inherited": False})
    fresh_intervals.sort(key=lambda row: row[1])
    for previous, current in zip(fresh_intervals, fresh_intervals[1:]):
        require(previous[2] <= current[1],
                f"fresh command intervals overlap: {previous[0]} and {current[0]}")
    inherited = _inherited_quality_rows(expected_capture)
    rows.extend(inherited)
    require(len(rows) == 200 and len(fresh_intervals) == 192 and len(inherited) == 8,
            "command cardinality or inheritance split changed")
    return {"count": len(rows), "fresh": len(fresh_intervals), "inherited": len(inherited),
            "rows": rows}


