+    /// Coalesce a small sequence of already-escaped markup pieces into one
+    /// Work charge and one fragment-buffer write. The pieces remain borrowed
+    /// and the scratch window is fixed on the stack. A Work or XML-byte
+    /// refusal is deliberately retried through the old individual writes so
+    /// the first failing piece and accepted prefix are unchanged.
+    fn write_markup_batch(&mut self, pieces: &[&[u8]]) -> litchi_core::Result<()> {
+        if pieces.is_empty() {
+            return Ok(());
+        }
+        let mut length = 0usize;
+        for piece in pieces {
+            let Some(next) = length.checked_add(piece.len()) else {
+                return self.write_markup_pieces(pieces);
+            };
+            if next > MAX_MARKUP_BATCH_BYTES {
+                return self.write_markup_pieces(pieces);
+            }
+            length = next;
+        }
+
+        let mut scratch = [0_u8; MAX_MARKUP_BATCH_BYTES];
+        let mut offset = 0usize;
+        for piece in pieces {
+            let end = offset + piece.len();
+            scratch[offset..end].copy_from_slice(piece);
+            offset = end;
+        }
+        debug_assert_eq!(offset, length);
+
+        match self.write_plain_span(&scratch[..length])? {
+            PlainSpanResult::Written => Ok(()),
+            PlainSpanResult::Fallback => self.write_markup_pieces(pieces),
+        }
+    }
