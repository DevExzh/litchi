+    fn commit_with(
+        worksheet: &str,
+        stage: impl FnOnce(&mut SourceEdit) -> crate::Result<()>,
+    ) -> crate::Result<Snapshot> {
+        let editor = source_backed_editor(worksheet);
+        let mut edit = editor.edit("Sheet1")?;
+        stage(&mut edit)?;
+        Ok(edit.commit()?.into_parts().0)
+    }
