+        let mut mce = proof_for_set(&source, "A1", 42);
+        assert!(!mce.omitted.is_empty());
+        let root_end = mce.bytes.iter().position(|byte| *byte == b'>').unwrap();
+        mce.bytes.splice(
+            root_end..root_end,
+            b" xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\""
+                .iter()
+                .copied(),
