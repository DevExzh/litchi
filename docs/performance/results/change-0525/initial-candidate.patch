+        && !plan
+            .cells
+            .values()
+            .any(|action| matches!(action.payload(), Some(Payload::SharedFormula { .. })))
+        && plan.cells.keys().all(|address| {
+            let Some(number) = address.row().get().checked_add(1) else {
+                return false;
+            };
