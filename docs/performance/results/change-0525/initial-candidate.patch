+fn entries_in_omitted_ranges(entries: &[Stored], ranges: &[Rect]) -> usize {
+    let mut range_index = 0usize;
+    let mut count = 0usize;
+    for entry in entries {
+        while let Some(range) = ranges.get(range_index) {
+            let address = entry.address;
+            let start = range.start();
+            let start = (start.row().get(), start.column().get());
+            let end = range.end();
+            let position = (address.row().get(), address.column().get());
+            if position < start {
+                break;
+            }
+            if position >= end {
+                range_index += 1;
+                continue;
+            }
+            count += 1;
+            break;
+        }
+    }
+    count
+}
