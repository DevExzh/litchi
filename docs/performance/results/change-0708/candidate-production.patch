+/// The validator needs an element's local name after the reader advances, so
+/// every open element keeps a representation of it until its closing event.
+/// Names in the modeled vocabulary are immutable constants; an unfamiliar
+/// copied element retains the event's bytes in the same owned form as before.
+/// Keeping that distinction here avoids allocating for the names that make up
+/// the ordinary worksheet and workbook paths while preserving arbitrary
+/// copied names exactly.
+enum ElementName {
+    Static(&'static [u8]),
+    Owned(Box<[u8]>),
+}
+
+impl ElementName {
+    fn from_local(local: &[u8]) -> Self {
+        match local {
+            b"worksheet" => Self::Static(b"worksheet"),
+            b"dimension" => Self::Static(b"dimension"),
+            b"sheetData" => Self::Static(b"sheetData"),
+            b"row" => Self::Static(b"row"),
+            b"c" => Self::Static(b"c"),
+            b"f" => Self::Static(b"f"),
+            b"v" => Self::Static(b"v"),
+            b"is" => Self::Static(b"is"),
+            b"t" => Self::Static(b"t"),
+            b"r" => Self::Static(b"r"),
+            b"workbook" => Self::Static(b"workbook"),
+            b"sheets" => Self::Static(b"sheets"),
+            b"sheet" => Self::Static(b"sheet"),
+            _ => Self::Owned(local.to_vec().into_boxed_slice()),
+        }
+    }
+}
+
+impl AsRef<[u8]> for ElementName {
+    fn as_ref(&self) -> &[u8] {
+        match self {
+            Self::Static(local) => local,
+            Self::Owned(local) => local,
+        }
+    }
+}
+
