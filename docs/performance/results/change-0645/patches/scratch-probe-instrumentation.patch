+/// SCRATCH (0645): how much of a commit's fingerprint the memo answers, on a
+/// deck shaped like the harness's eager corpus.
+#[test]
+fn commit_fingerprint_memo_hit_rate() -> Result<()> {
+    let mut package = opened_plain_slides_package(24)?;
+    // Eight incompressible media parts, as the eager corpus carries.
+    for index in 0..8_usize {
+        let name = PackURI::new(&format!("/ppt/media/image{index}.bin")).map_err(Error::Invalid)?;
+        let mut blob = vec![0_u8; 256 * 1024];
+        for (offset, byte) in blob.iter_mut().enumerate() {
+            *byte = ((offset.wrapping_mul(31).wrapping_add(index)) % 251) as u8;
+        }
+        package.opc.try_add_part(Box::new(BlobPart::new(
+            name,
+            "image/png".to_owned(),
+            blob,
+        )))?;
+    }
+    let source = package.opened_presentation()?;
+    let parts = package.opc.part_count();
+
+    let mut edit = source.edit();
+    edit.set_shape_text(0, crate::shape::Key::Index(0), "memoized")?;
+    super::model::memo_stats::reset();
+    let commit = edit.commit()?;
+    let (hits, misses, hit_bytes, miss_bytes) = super::model::memo_stats::read();
+    println!(
+        "0645-hitrate parts={parts} hits={hits} misses={misses} \
+         hit_bytes={hit_bytes} miss_bytes={miss_bytes}"
+    );
+    assert_eq!(hits + misses, parts as u64);
+    assert!(hits >= parts as u64 - 2, "only {hits} of {parts} parts hit");
+    drop(commit);
+    Ok(())
+}
