+
+/// Every pairwise verdict of the v2 revision equals the v1 verdict and the
+/// content oracle's verdict, over a corpus of single-input mutations.
+#[test]
+fn revision_v2_preserves_every_pairwise_verdict_of_v1() -> Result<()> {
+    let package = opened_two_slide_package()?;
+    let base = package.opc.clone();
+    let slide = package.opened_presentation()?.slides()[0]
+        .part_name()
+        .clone();
+    let second = package.opened_presentation()?.slides()[1]
+        .part_name()
+        .clone();
+    let main = PackURI::new("/ppt/presentation.xml").map_err(Error::Invalid)?;
+    let added = PackURI::new("/docProps/extra.bin").map_err(Error::Invalid)?;
+
+    let mut corpus: Vec<(String, litchi_opc::OpcPackage)> = Vec::new();
+    corpus.push(("base".to_owned(), base.clone()));
+
+    // A re-allocated but byte-identical package: equal content, no shared Arc.
+    let mut rewritten = base.clone();
+    let blob = rewritten.get_part(&main)?.blob().to_vec();
+    rewritten.get_part_mut(&main)?.set_blob(blob);
+    corpus.push(("rewritten in place".to_owned(), rewritten));
+
+    let mutations: Vec<(
+        &str,
+        fn(&mut litchi_opc::OpcPackage, &PackURI, &PackURI, &PackURI) -> Result<()>,
+    )> = vec![
+        ("payload grows", |opc, slide, _second, _added| {
+            let mut blob = opc.get_part(slide)?.blob().to_vec();
+            blob.extend_from_slice(b" ");
+            opc.get_part_mut(slide)?.set_blob(blob);
+            Ok(())
+        }),
+        ("payload shrinks", |opc, slide, _second, _added| {
+            let mut blob = opc.get_part(slide)?.blob().to_vec();
+            blob.pop();
+            opc.get_part_mut(slide)?.set_blob(blob);
+            Ok(())
+        }),
+        ("content type", |opc, slide, _second, _added| {
+            opc.get_part_mut(slide)?
+                .set_content_type("application/octet-stream".into())?;
+            Ok(())
+        }),
+        ("added part", |opc, _slide, _second, added| {
+            opc.try_add_part(Box::new(BlobPart::new(
+                added.clone(),
+                "application/octet-stream".into(),
+                b"extra".to_vec(),
+            )))?;
+            Ok(())
+        }),
+        ("removed part", |opc, slide, _second, _added| {
+            assert!(opc.remove_part(slide));
+            Ok(())
+        }),
+        ("part relationship", |opc, slide, _second, _added| {
+            opc.get_part_mut(slide)?.rels_mut().try_add_relationship(
+                "urn:producer:probe".into(),
+                "../media/probe.bin".into(),
+                "rIdProbe".into(),
+                TargetMode::Internal,
+            )?;
+            Ok(())
+        }),
+        ("root relationship", |opc, _slide, _second, _added| {
+            opc.rels_mut().try_add_relationship(
+                "urn:producer:probe".into(),
+                "docProps/probe.bin".into(),
+                "rIdRootProbe".into(),
+                TargetMode::Internal,
+            )?;
+            Ok(())
+        }),
+        ("external relationship", |opc, _slide, _second, _added| {
+            opc.rels_mut().try_add_relationship(
+                "urn:producer:probe".into(),
+                "https://example.invalid/probe".into(),
+                "rIdExternalProbe".into(),
+                TargetMode::External,
+            )?;
+            Ok(())
+        }),
+        // The transposition case: two parts swap payloads. The per-part
+        // digests are the same multiset; only their binding to names changes.
+        ("payload transposition", |opc, slide, second, _added| {
+            let first_blob = opc.get_part(slide)?.blob().to_vec();
+            let second_blob = opc.get_part(second)?.blob().to_vec();
+            opc.get_part_mut(slide)?.set_blob(second_blob);
+            opc.get_part_mut(second)?.set_blob(first_blob);
+            Ok(())
+        }),
+    ];
+
+    for (label, mutate) in mutations {
+        let mut mutated = base.clone();
+        mutate(&mut mutated, &slide, &second, &added)?;
+        corpus.push(((*label).to_owned(), mutated));
+    }
+
+    let mut compared = 0_usize;
+    for (left_label, left) in &corpus {
+        for (right_label, right) in &corpus {
+            let oracle = super::model::packages_equal(left, right);
+            let v1 = super::model::package_fingerprint_v1(left)?
+                == super::model::package_fingerprint_v1(right)?;
+            let v2 = super::model::package_fingerprint(left)?
+                == super::model::package_fingerprint(right)?;
+            assert_eq!(
+                oracle, v1,
+                "v1 disagreed with the content oracle on ({left_label}, {right_label})"
+            );
+            assert_eq!(
+                v1, v2,
+                "v2 changed the verdict on ({left_label}, {right_label})"
+            );
+            compared += 1;
+        }
+    }
+    assert_eq!(compared, corpus.len() * corpus.len());
+    assert_eq!(corpus.len(), 11);
