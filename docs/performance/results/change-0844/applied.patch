+    #[test]
+    fn shared_ancestors_retain_first_descendant_and_folded_identity() {
+        let mut index = PartNameIndex::try_with_capacity(1).unwrap();
+        index.insert(&uri("/Custom/First/item.bin")).unwrap();
+        index.insert(&uri("/custom/first/other.bin")).unwrap();
+        index.insert(&uri("/CUSTOM/second/item.bin")).unwrap();
+        assert_eq!(index.descendant_by_folded_ancestor.get("/custom"), Some(&0));
+        assert_eq!(
+            index.descendant_by_folded_ancestor.get("/custom/first"),
+            Some(&0)
+        );
+        assert_eq!(
+            index.descendant_by_folded_ancestor.get("/custom/second"),
+            Some(&2)
+        );
+        assert!(matches!(
+            index.insert(&uri("/CUSTOM")),
+            Err(OpcError::DerivedPartNames { existing, candidate })
+                if existing == "/Custom/First/item.bin" && candidate == "/CUSTOM"
+        ));
+    }
+
+    #[test]
+    fn deep_missing_suffixes_keep_the_ancestor_map_prefix_closed() {
+        let mut index = PartNameIndex::try_with_capacity(0).unwrap();
+        let names = [
+            "/root.bin",
+            "/a/b/c/d/e/f/g/h/first.bin",
+            "/a/b/c/d/e/f/g/h/second.bin",
+            "/a/b/c/new/e/f/g/h/third.bin",
+            "/u/b/c/d/e/f/g/h/fourth.bin",
+        ];
+        for (at, name) in names.iter().enumerate() {
+            index.insert(&uri(name)).unwrap();
+            for (boundary, _) in name.match_indices('/').skip(1) {
+                let ancestor = &name[..boundary];
+                let first = names[..=at]
+                    .iter()
+                    .position(|earlier| {
+                        earlier
+                            .strip_prefix(ancestor)
+                            .is_some_and(|suffix| suffix.starts_with('/'))
+                    })
+                    .unwrap();
+                assert_eq!(
+                    index.descendant_by_folded_ancestor.get(ancestor),
+                    Some(&first)
+                );
+            }
+        }
+        assert!(
+            !index
+                .descendant_by_folded_ancestor
+                .contains_key("/root.bin")
+        );
+        for candidate in ["/a/b/c", "/a/b/c/new", "/u/b/c/d/e/f/g/h"] {
+            assert!(matches!(
+                index.insert(&uri(candidate)),
+                Err(OpcError::DerivedPartNames { .. })
+            ));
+        }
+    }
+
+    #[test]
+    fn every_name_conflict_keeps_the_index_unchanged_and_usable() {
+        let mut index = PartNameIndex::try_with_capacity(1).unwrap();
+        index.insert(&uri("/a/b/item.bin")).unwrap();
+        for candidate in [
+            "/a/b/item.bin",
+            "/A/B/ITEM.BIN",
+            "/a/b",
+            "/a/b/item.bin/child.bin",
+        ] {
+            let names = index.names.clone();
+            let folded = index.by_folded.clone();
+            let ancestors = index.descendant_by_folded_ancestor.clone();
+            assert!(index.insert(&uri(candidate)).is_err());
+            assert_eq!(index.names, names);
+            assert_eq!(index.by_folded, folded);
+            assert_eq!(index.descendant_by_folded_ancestor, ancestors);
+        }
+        index.insert(&uri("/a/c/next.bin")).unwrap();
+        assert_eq!(index.names.len(), 2);
+        assert_eq!(index.descendant_by_folded_ancestor.get("/a"), Some(&0));
+        assert_eq!(index.descendant_by_folded_ancestor.get("/a/c"), Some(&1));
+    }
