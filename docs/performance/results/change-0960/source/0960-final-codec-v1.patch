+    #[test]
+    fn duplicate_sheet_data_does_not_trigger_a_second_hint_scan() {
+        let body = "<row r=\"1\"><c r=\"A1\"/></row>";
+        let content = format!(
+            "<worksheet xmlns=\"{SML}\"><sheetData>{body}</sheetData><sheetData>{body}</sheetData></worksheet>"
+        )
+        .into_bytes();
+        route::reset();
+        let attempt = shared(&content);
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::ProvisionalFailed
+        ));
+        assert_eq!(route::stats().attempts, 1);
+        assert_differential("duplicate sheetData", &content);
+    }
