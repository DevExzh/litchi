+    #[test]
+    fn event_cap_declines_hint_and_uses_authoritative_fallback() {
+        let rows = crate::raw::worksheet::MAX_SHARED_PROVISIONAL_EVENTS / 3 + 1;
+        let mut body = String::new();
+        for row in 1..=rows {
+            write!(body, "<row r=\"{row}\"><c r=\"A{row}\"/></row>")
+                .expect("write generated worksheet");
+        }
+        let content = worksheet(&body);
+        route::reset();
+        // Call the codec entry directly so the recognizer's cap decision is
+        // observable; the public wrapper may decline the same source earlier
+        // using its conservative event bound.
+        let attempt = parse_source_with_observer(
+            &content,
+            crate::raw::worksheet::SourceAdmission::Borrowed,
+            || Ok(None),
+            |_, _, _| true,
+            crate::raw::worksheet::Repairs::Refuse,
+        );
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::ProvisionalFailed
+        ));
+        let stats = route::stats();
+        assert_eq!(stats.attempts, 1);
+        assert_eq!(stats.admitted, 0);
+        assert_eq!(stats.cap_declines, 1);
+        assert_differential("event cap", &content);
+    }
