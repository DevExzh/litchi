+#[cfg(test)]
+mod strict_lane_hint_tests {
+    use super::strict_lane_hint_route as route;
+    use super::*;
+    use quick_xml::events::Event;
+    use std::fmt::Write as _;
+
+    const SML: &str = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+
+    fn worksheet(body: &str) -> Vec<u8> {
+        format!("<worksheet xmlns=\"{SML}\"><sheetData>{body}</sheetData></worksheet>").into_bytes()
+    }
+
+    fn authoritative(content: &[u8]) -> Result<Store> {
+        crate::raw::worksheet::parse_refusing_repairs(content, || Ok(None))
+    }
+
+    fn shared(content: &[u8]) -> crate::raw::worksheet::SourceParseAttempt {
+        crate::raw::worksheet::parse_source_with_observer(
+            content,
+            crate::raw::worksheet::SourceAdmission::Borrowed,
+            || Ok(None),
+            |_, _, _| true,
+        )
+    }
+
+    fn recovered(content: &[u8]) -> Result<Store> {
+        match shared(content) {
+            crate::raw::worksheet::SourceParseAttempt::Complete(parsed) => {
+                crate::raw::worksheet::complete_source_parse(content, parsed)
+            },
+            crate::raw::worksheet::SourceParseAttempt::ProvisionalFailed
+            | crate::raw::worksheet::SourceParseAttempt::ReaderFailed => authoritative(content),
+        }
+    }
+
+    fn assert_differential(name: &str, content: &[u8]) {
+        let expected = authoritative(content);
+        let actual = recovered(content);
+        match (&expected, &actual) {
+            (Ok(expected), Ok(actual)) => {
+                assert_eq!(format!("{expected:?}"), format!("{actual:?}"), "{name}");
+            },
+            (Err(expected), Err(actual)) => {
+                assert_eq!(expected.to_string(), actual.to_string(), "{name}");
+            },
+            _ => panic!("{name}: shared route differs: {expected:?} vs {actual:?}"),
+        }
+    }
+
+    #[test]
+    fn admitted_hint_runs_after_observer_and_matches_authority() {
+        let content = worksheet(
+            "<row r=\"1\"><c r=\"A1\"><v>1</v></c><c r=\"B1\"/></row>\n\
+             <row r=\"2\"><c r=\"A2\"><v>2</v></c></row>",
+        );
+        route::reset();
+        let mut saw_sheet_data = false;
+        let attempt = crate::raw::worksheet::parse_source_with_observer(
+            &content,
+            crate::raw::worksheet::SourceAdmission::Borrowed,
+            || Ok(None),
+            |_, event, _| {
+                if matches!(event, Event::Start(element) if element.local_name().as_ref() == b"sheetData")
+                {
+                    // The observer is the first consumer of the event. The
+                    // hint cannot run until this callback and transition have
+                    // both accepted it.
+                    assert_eq!(route::stats().attempts, 0);
+                    saw_sheet_data = true;
+                }
+                true
+            },
+        );
+        assert!(saw_sheet_data);
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::Complete(Ok(_))
+        ));
+        let stats = route::stats();
+        assert_eq!(stats.attempts, 1);
+        assert_eq!(stats.admitted, 1);
+        assert_eq!(stats.declined, 0);
+        assert_eq!(stats.cap_declines, 0);
+        assert_eq!(stats.reserved_cells, 3);
+        assert_eq!(stats.reserve_succeeded, 1);
+        assert_eq!(stats.reserve_failed, 0);
+        assert_differential("admitted strict body", &content);
+
+        // Entry::locate receives quick-xml's raw reader positions and applies
+        // the document's BOM offset itself. Keep this route covered because
+        // the observer's public spans intentionally use document offsets.
+        let mut marked = b"\xEF\xBB\xBF".to_vec();
+        marked.extend_from_slice(&content);
+        route::reset();
+        let attempt = shared(&marked);
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::Complete(Ok(_))
+        ));
+        let stats = route::stats();
+        assert_eq!(stats.attempts, 1);
+        assert_eq!(stats.admitted, 1);
+        assert_eq!(stats.reserved_cells, 3);
+        assert_eq!(stats.reserve_succeeded, 1);
+        assert_differential("BOM strict body", &marked);
+    }
+
+    #[test]
+    fn failed_hint_reservation_keeps_authoritative_growth_and_result() {
+        let content = worksheet("<row r=\"1\"><c r=\"A1\"/><c r=\"B1\"/></row>");
+        route::reset();
+        let expected = authoritative(&content);
+        route::force_reserve_failure();
+        let actual = recovered(&content);
+        let stats = route::stats();
+        assert_eq!(stats.attempts, 1);
+        assert_eq!(stats.admitted, 1);
+        assert_eq!(stats.reserved_cells, 2);
+        assert_eq!(stats.reserve_succeeded, 0);
+        assert_eq!(stats.reserve_failed, 1);
+        match (&expected, &actual) {
+            (Ok(expected), Ok(actual)) => {
+                assert_eq!(format!("{expected:?}"), format!("{actual:?}"));
+            },
+            (Err(expected), Err(actual)) => {
+                assert_eq!(expected.to_string(), actual.to_string());
+            },
+            _ => panic!("forced hint failure changed the parse result"),
+        }
+    }
+
+    #[test]
+    fn strict_lane_declines_non_strict_bodies_without_changing_results() {
+        let cases = [
+            (
+                "formula",
+                worksheet(
+                    "<row r=\"1\"><c r=\"A1\"><f>A1+1</f><v>2</v></c></row>",
+                ),
+            ),
+            (
+                "inline string",
+                worksheet(
+                    "<row r=\"1\"><c r=\"A1\" t=\"inlineStr\"><is><t>x</t></is></c></row>",
+                ),
+            ),
+            (
+                "entity value",
+                worksheet("<row r=\"1\"><c r=\"A1\"><v>&amp;</v></c></row>"),
+            ),
+            (
+                "comment",
+                worksheet("<!-- note --><row r=\"1\"><c r=\"A1\"/></row>"),
+            ),
+            (
+                "prefixed row",
+                format!(
+                    "<worksheet xmlns=\"{SML}\" xmlns:x=\"{SML}\"><sheetData><x:row r=\"1\"><x:c r=\"A1\"/></x:row></sheetData></worksheet>"
+                )
+                .into_bytes(),
+            ),
+        ];
+        for (name, content) in cases {
+            route::reset();
+            assert_differential(name, &content);
+            let stats = route::stats();
+            assert_eq!(stats.attempts, 1, "{name}");
+            assert_eq!(stats.admitted, 0, "{name}");
+            assert_eq!(stats.declined, 1, "{name}");
+            assert_eq!(stats.cap_declines, 0, "{name}");
+        }
+    }
+
+    #[test]
+    fn observer_refusal_precedes_parser_and_hint() {
+        let content = worksheet("<row r=\"1\"><c r=\"A1\"/></row>");
+        route::reset();
+        let attempt = crate::raw::worksheet::parse_source_with_observer(
+            &content,
+            crate::raw::worksheet::SourceAdmission::Borrowed,
+            || Ok(None),
+            |_, event, _| !matches!(event, Event::Start(element) if element.local_name().as_ref() == b"sheetData"),
+        );
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::ProvisionalFailed
+        ));
+        assert_eq!(route::stats(), route::Stats::default());
+        assert!(authoritative(&content).is_ok());
+    }
+
+    #[test]
+    fn malformed_tail_after_admission_falls_back_exactly_once() {
+        let content = format!(
+            "<worksheet xmlns=\"{SML}\"><sheetData><row r=\"1\"><c r=\"A1\"/></row></sheetData><bad>"
+        )
+        .into_bytes();
+        route::reset();
+        let attempt = shared(&content);
+        assert!(matches!(
+            attempt,
+            crate::raw::worksheet::SourceParseAttempt::ProvisionalFailed
+                | crate::raw::worksheet::SourceParseAttempt::ReaderFailed
+        ));
+        let stats = route::stats();
+        assert_eq!(stats.attempts, 1);
+        assert_eq!(stats.admitted, 1);
+        assert_differential("malformed tail", &content);
+    }
