+/// Opportunistically pre-size the ordinary parser's raw-cell vector from the
+/// exact count produced by the strict worksheet lane.
+///
+/// The shared observer route still owns validation, parser transitions and
+/// every cell's fallible reservation. This helper only supplies capacity: a
+/// declined recognition, an over-cap summary, or a failed hint reservation is
+/// ignored, and [`Parser::finish_cell`] remains authoritative.
+fn reserve_strict_lane_cells<'c>(content: &[u8], cells: &mut Vec<RawCell<'c>>, entry: lane::Entry) {
+    #[cfg(test)]
+    strict_lane_hint_route::note_attempt();
+
+    // Keep the extra recognizer work within the same source bound as the
+    // shared traversal. The caller normally checked this at admission, but
+    // the private codec entry is also exercised directly by differential
+    // tests.
+    if content.len() > super::MAX_SHARED_SOURCE_BYTES {
+        #[cfg(test)]
+        strict_lane_hint_route::note_cap_decline();
+        return;
+    }
+    let Ok(name) = entry.name(content) else {
+        #[cfg(test)]
+        strict_lane_hint_route::note_decline();
+        return;
+    };
+    let Some(summary) = lane::recognize(content, entry.position, name) else {
+        #[cfg(test)]
+        strict_lane_hint_route::note_decline();
+        return;
+    };
+    // The event cap is the resource bound for the shared provisional parser;
+    // do not reserve from a summary that the ordinary route would never
+    // finish provisionally. `cells` is bounded separately so the subtraction
+    // below cannot turn a malformed count into an unbounded request.
+    if summary.events > super::MAX_SHARED_PROVISIONAL_EVENTS
+        || summary.cells > super::MAX_SHARED_PROVISIONAL_EVENTS
+    {
+        #[cfg(test)]
+        strict_lane_hint_route::note_cap_decline();
+        return;
+    }
+    let Some(additional) = summary.cells.checked_sub(cells.len()) else {
+        #[cfg(test)]
+        strict_lane_hint_route::note_decline();
+        return;
+    };
+    #[cfg(test)]
+    strict_lane_hint_route::note_admitted(additional);
+    if additional == 0 {
+        return;
+    }
+    #[cfg(test)]
+    let forced_failure = strict_lane_hint_route::take_forced_reserve_failure();
+    #[cfg(not(test))]
+    let forced_failure = false;
+    if forced_failure {
+        #[cfg(test)]
+        strict_lane_hint_route::note_reserve_failed();
+    } else {
+        match cells.try_reserve_exact(additional) {
+            Ok(()) => {
+                #[cfg(test)]
+                strict_lane_hint_route::note_reserve_succeeded();
+            },
+            Err(_) => {
+                // This is only a hint. Keep the existing per-cell fallible
+                // reservation and its typed error as the allocation boundary.
+                #[cfg(test)]
+                strict_lane_hint_route::note_reserve_failed();
+            },
+        }
+    }
+}
