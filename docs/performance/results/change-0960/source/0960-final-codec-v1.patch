+#[cfg(test)]
+mod strict_lane_hint_route {
+    use std::cell::Cell;
+
+    #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+    pub(super) struct Stats {
+        pub(super) attempts: usize,
+        pub(super) admitted: usize,
+        pub(super) declined: usize,
+        pub(super) cap_declines: usize,
+        pub(super) reserved_cells: usize,
+        pub(super) reserve_succeeded: usize,
+        pub(super) reserve_failed: usize,
+    }
+
+    thread_local! {
+        static STATS: Cell<Stats> = const { Cell::new(Stats {
+            attempts: 0,
+            admitted: 0,
+            declined: 0,
+            cap_declines: 0,
+            reserved_cells: 0,
+            reserve_succeeded: 0,
+            reserve_failed: 0,
+        }) };
+        static FORCE_RESERVE_FAILURE: Cell<bool> = const { Cell::new(false) };
+    }
+
+    pub(super) fn reset() {
+        STATS.with(|stats| stats.set(Stats::default()));
+        FORCE_RESERVE_FAILURE.with(|failure| failure.set(false));
+    }
+
+    pub(super) fn stats() -> Stats {
+        STATS.with(Cell::get)
+    }
+
+    pub(super) fn note_attempt() {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.attempts += 1;
+            stats.set(value);
+        });
+    }
+
+    pub(super) fn note_admitted(additional: usize) {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.admitted += 1;
+            value.reserved_cells = value.reserved_cells.saturating_add(additional);
+            stats.set(value);
+        });
+    }
+
+    pub(super) fn force_reserve_failure() {
+        FORCE_RESERVE_FAILURE.with(|failure| failure.set(true));
+    }
+
+    pub(super) fn take_forced_reserve_failure() -> bool {
+        FORCE_RESERVE_FAILURE.with(|failure| failure.replace(false))
+    }
+
+    pub(super) fn note_decline() {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.declined += 1;
+            stats.set(value);
+        });
+    }
+
+    pub(super) fn note_cap_decline() {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.cap_declines += 1;
+            stats.set(value);
+        });
+    }
+
+    pub(super) fn note_reserve_succeeded() {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.reserve_succeeded += 1;
+            stats.set(value);
+        });
+    }
+
+    pub(super) fn note_reserve_failed() {
+        STATS.with(|stats| {
+            let mut value = stats.get();
+            value.reserve_failed += 1;
+            stats.set(value);
+        });
+    }
+}
