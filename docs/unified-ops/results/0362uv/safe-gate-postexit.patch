+def owned_processes(process_pid: int, info: dict[int, dict] | None = None) -> list[dict]:
+    """Return processes still in the child process group or subtree."""
+    info = process_table() if info is None else info
+    descendants = {process_pid}
+    changed = True
+    while changed:
+        changed = False
+        for pid, row in info.items():
+            if pid not in descendants and row["ppid"] in descendants:
+                descendants.add(pid)
+                changed = True
+    rows = []
+    for pid, row in info.items():
+        if pid in descendants or row["pgrp"] == process_pid:
+            rows.append({key: row[key] for key in ("pid", "ppid", "pgrp", "executable", "cwd", "command")})
+    return rows
+
+
+def owned_builders(process_pid: int, root: Path, target: Path, info: dict[int, dict] | None = None) -> list[dict]:
+    """Return builders still owned by a completed step or its source/target."""
+    info = process_table() if info is None else info
+    owned = {row["pid"]: row for row in owned_processes(process_pid, info)}
+    root_text = str(root)
+    target_text = str(target)
+    rows = []
+    for pid, row in info.items():
+        if row["executable"] not in BUILDER_EXECUTABLES:
+            continue
+        rooted = (
+            row["cwd"] == root_text
+            or row["cwd"].startswith(root_text + "/")
+            or root_text in row["command"]
+            or target_text in row["command"]
+        )
+        if pid in owned or rooted:
+            rows.append({key: row[key] for key in ("pid", "ppid", "pgrp", "executable", "cwd", "command")})
+    return rows
+
+
+def post_exit_guard(process_pid: int, root: Path, target: Path) -> dict:
+    """Require owned builders to exit and the selected target to stabilize."""
+    deadline = time.monotonic() + POST_EXIT_TIMEOUT_SECONDS
+    previous_size: int | None = None
+    stable_samples = 0
+    samples = []
+    while True:
+        info = process_table()
+        owned = owned_processes(process_pid, info)
+        leaked = owned_builders(process_pid, root, target, info)
+        size = target_bytes(target)
+        samples.append({"at": time.time(), "target_bytes": size, "owned": owned, "builders": leaked})
+        if leaked:
+            raise RuntimeError(f"owned builder remained after child exit: {leaked}")
+        if owned:
+            stable_samples = 0
+            if time.monotonic() >= deadline:
+                raise RuntimeError(f"owned child remained after child exit: {owned}")
+            time.sleep(POST_EXIT_POLL_SECONDS)
+            continue
+        if previous_size is not None and size == previous_size:
+            stable_samples += 1
+        else:
+            stable_samples = 0
+        if stable_samples >= POST_EXIT_STABLE_SAMPLES:
+            return {"target_bytes": size, "samples": samples}
+        if time.monotonic() >= deadline:
+            raise RuntimeError(f"target did not stabilize after child exit: {samples[-1]}")
+        previous_size = size
+        time.sleep(POST_EXIT_POLL_SECONDS)
+
