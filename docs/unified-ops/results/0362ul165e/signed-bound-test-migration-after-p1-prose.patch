+    def test_pending_policy_fixture_fails_closed(self) -> None:
+        # Keep the pre-install negative after P becomes bound by using an
+        # explicit temporary manifest and mocked None code binding.  The
+        # checked-in production manifest is never relabelled or rewritten.
+        with tempfile.TemporaryDirectory(prefix="signed-native-v2-pending-") as name:
+            manifest = Path(name) / "signed-native-v2.json"
+            manifest.write_text(json.dumps(self._pending_policy_document()), encoding="utf-8")
+            with mock.patch.object(policy, "POLICY_PATH", manifest), mock.patch.object(policy, "CANDIDATE_BINDING", None):
+                self.assertEqual(
+                    policy.validate_policy(),
+                    {
+                        "status": "pending_final_source_freeze",
+                        "execution": "refused_pending_source_freeze",
+                    },
+                )
+                with self.assertRaises(policy.IncompletePolicyError):
+                    policy.execute()

