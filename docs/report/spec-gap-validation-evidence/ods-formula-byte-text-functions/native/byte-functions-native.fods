<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sheet1">
        <table:table-row>
          <table:table-cell><text:p>case</text:p></table:table-cell>
          <table:table-cell><text:p>formula</text:p></table:table-cell>
          <table:table-cell><text:p>expected_utf8_profile</text:p></table:table-cell>
        </table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_findb</text:p></table:table-cell><table:table-cell table:formula="of:=FINDB(&quot;bc&quot;;&quot;abcdef&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>2</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_leftb</text:p></table:table-cell><table:table-cell table:formula="of:=LEFTB(&quot;abcdef&quot;;3)"><text:p></text:p></table:table-cell><table:table-cell><text:p>abc</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_lenb</text:p></table:table-cell><table:table-cell table:formula="of:=LENB(&quot;abcdef&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>6</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_midb</text:p></table:table-cell><table:table-cell table:formula="of:=MIDB(&quot;abcdef&quot;;2;3)"><text:p></text:p></table:table-cell><table:table-cell><text:p>bcd</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_replaceb</text:p></table:table-cell><table:table-cell table:formula="of:=REPLACEB(&quot;abcdef&quot;;2;3;&quot;XYZ&quot;)"><text:p></text:p></table:table-cell><table:table-cell><text:p>aXYZef</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_rightb</text:p></table:table-cell><table:table-cell table:formula="of:=RIGHTB(&quot;abcdef&quot;;3)"><text:p></text:p></table:table-cell><table:table-cell><text:p>def</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>ascii_searchb</text:p></table:table-cell><table:table-cell table:formula="of:=SEARCHB(&quot;CD&quot;;&quot;abcdef&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>3</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_lenb_e_acute</text:p></table:table-cell><table:table-cell table:formula="of:=LENB(&quot;é&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>2</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_lenb_cjk</text:p></table:table-cell><table:table-cell table:formula="of:=LENB(&quot;界&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>3</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_lenb_emoji</text:p></table:table-cell><table:table-cell table:formula="of:=LENB(&quot;🙂&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>4</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_leftb_e_acute</text:p></table:table-cell><table:table-cell table:formula="of:=LEFTB(&quot;Aé&quot;;2)"><text:p></text:p></table:table-cell><table:table-cell><text:p>A</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_midb_e_acute</text:p></table:table-cell><table:table-cell table:formula="of:=MIDB(&quot;Aé界&quot;;3;2)"><text:p></text:p></table:table-cell><table:table-cell><text:p>é</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_rightb_emoji</text:p></table:table-cell><table:table-cell table:formula="of:=RIGHTB(&quot;Aé界🙂&quot;;1)"><text:p></text:p></table:table-cell><table:table-cell><text:p></text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_findb_cjk</text:p></table:table-cell><table:table-cell table:formula="of:=FINDB(&quot;界&quot;;&quot;Aé界🙂&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>4</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_searchb_sharp_s</text:p></table:table-cell><table:table-cell table:formula="of:=SEARCHB(&quot;ss&quot;;&quot;aß&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>2</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_replaceb_e_acute</text:p></table:table-cell><table:table-cell table:formula="of:=REPLACEB(&quot;Aé界&quot;;3;2;&quot;X&quot;)"><text:p></text:p></table:table-cell><table:table-cell><text:p>AX界</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_rightb_cjk</text:p></table:table-cell><table:table-cell table:formula="of:=RIGHTB(&quot;Aé界&quot;;3)"><text:p></text:p></table:table-cell><table:table-cell><text:p>界</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_searchb_cjk</text:p></table:table-cell><table:table-cell table:formula="of:=SEARCHB(&quot;界&quot;;&quot;Aé界🙂&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>4</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell><text:p>utf8_searchb_emoji</text:p></table:table-cell><table:table-cell table:formula="of:=SEARCHB(&quot;🙂&quot;;&quot;Aé界🙂&quot;)"><text:p>0</text:p></table:table-cell><table:table-cell><text:p>7</text:p></table:table-cell></table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
