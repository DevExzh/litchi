+fn event_kind(event: &Event<'_>) -> RawEventKind {
+    match event {
+        Event::Start(_) => RawEventKind::Start,
+        Event::Empty(_) => RawEventKind::Empty,
+        Event::End(_) => RawEventKind::End,
+        _ => RawEventKind::Other,
+    }
+}
