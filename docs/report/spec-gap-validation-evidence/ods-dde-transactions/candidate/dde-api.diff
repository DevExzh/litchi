+            let package = self
+                .package
+                .replace_content_xml(commit.snapshot().source_xml())?;
+            let candidate = Self::from_package(package)?;
+            context.check().map_err(map_sheet_metadata_execution)?;
+            *self = candidate;
+        }
+        Ok(())
+    }
