    "policy": {
        "main_story_bounds": "Raw Selsf parsing remains context-free; strict DOC owner access and patch preflight validate active main-story CPs before table cloning.",
        "length_changes": "Main-story length-changing operations remap cpFirst, cpLim, cpAnchor, and active text-block cpAnchorShrink at exact splice boundaries; interior CPs and insertion-at-CP ambiguity return a typed PositionDependency refusal before candidate/table cloning.",
        "replay": "Durable text operations remain representable because replay invokes the same deterministic Selsf remap; explicit Selsf byte patches remain outside durable and semantic three-way merging.",
        "ignored_fields": "Semantic no-ops preserve undefined blktblSel and shape fInsEnd bytes; partial TableSel transitions normalize invalid previously ignored edges before parsing, and applicability checks do not depend on setter order.",
        "three_way": "Patches with explicit Selsf auxiliary changes are refused at the body three-way boundary to avoid dropping opaque effects."
    },
