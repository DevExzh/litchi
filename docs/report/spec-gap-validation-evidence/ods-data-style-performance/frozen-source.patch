+        Error::InvalidFormat("invalid XML source opening proof range".to_string())
+    })?;
+    if bytes != proof.expected.as_slice() {
+        return invalid("stale XML source opening proof");
+    }
+    let _ = read_opening_token(bytes, source.path())?;
+    Ok(range)
