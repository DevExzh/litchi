+        self.inner.clear_cell_range_source(selector)
+    }
+    /// Set an existing cell detective owner.
+    pub fn set_detective(&mut self, selector: CellSelector<'_>, value: Detective) -> Result<()> {
+        self.inner.set_detective(selector, value)
