+/// Source-backed exact content patch and accepted target snapshot.
+pub struct SourceMetadataCommit<'source> {
+    snapshot: SourceMetadataSnapshot<'source>,
+    patch: SourceMetadataPatch<'source>,
+    changed: bool,
+}
