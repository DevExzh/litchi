+/// The actual ODF cell parent that owns a direct detective child.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CellKind {
+    /// An ordinary physical `table:table-cell`.
+    TableCell,
+    /// An explicit physical `table:covered-table-cell`.
