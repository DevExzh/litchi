+#[derive(Clone, Copy)]
+struct CompactCellParts {
+    /// Offset range for an optional compact sheet name.
+    sheet: Option<(usize, usize)>,
+    /// Offset range for the column label.
+    column: (usize, usize),
+    /// Checked decimal row value.
