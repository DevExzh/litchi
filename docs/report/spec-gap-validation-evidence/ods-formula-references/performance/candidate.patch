+#[test]
+fn representative_functions_and_bare_cell_controls_remain_unchanged() {
+    for name in [
+        "SUM", "LOG10", "BIN2DEC", "BITAND", "COMPLEX", "DCOUNT", "DDE", "VLOOKUP",
+    ] {
+        assert!(
+            is_valid_function(name),
