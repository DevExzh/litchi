{
  "schema": "litchi.native-qualification.v1",
  "lane": "legacy-rtf",
  "output_dir": "$RTF_NATIVE_QUAL_OUTPUT",
  "path_prepend": ["$LITCHI_COORD_BIN"],
  "rounds": 31,
  "abba_blocks": 5,
  "abba_order": ["before", "after", "after", "before"],
  "environment": {
    "CARGO_PROFILE_RELEASE_DEBUG": "0",
    "TMPDIR": "$RTF_NATIVE_TMP"
  },
  "validators": [
    {
      "id": "legacy-native-contract",
      "script": "$LITCHI_NATIVE_QUAL_ROOT/tools/native_qualification/legacy_native_validator.py",
      "argv": [
        "python3",
        "$LITCHI_NATIVE_QUAL_ROOT/tools/native_qualification/legacy_native_validator.py",
        "{output_dir}",
        "legacy-rtf",
        "$RTF_BASELINE_REVISION",
        "$RTF_CANDIDATE_REVISION",
        "$RTF_TARGET_ROOT/before",
        "$RTF_TARGET_ROOT/after"
      ],
      "cwd": "{output_dir}",
      "outputs": ["{output_dir}/summary.json"],
      "require_stdout": true
    }
  ],
  "shared": {
    "probe_paths": ["crates/litchi-rtf/examples/refusal_contract_bench.rs"],
    "fixture_paths": []
  },
  "legs": {
    "before": {
      "source_root": "$RTF_BEFORE_SOURCE",
      "target_dir": "$RTF_TARGET_ROOT/before",
      "allow_dirty": true,
      "lock_paths": ["Cargo.lock"],
      "build": [
        {
          "id": "rtf_refusal_contract",
          "argv": [
            "cargo",
            "build",
            "--release",
            "--manifest-path",
            "Cargo.toml",
            "-p",
            "litchi-rtf",
            "--example",
            "refusal_contract_bench"
          ],
          "artifacts": ["{target_dir}/release/examples/refusal_contract_bench"]
        }
      ],
      "programs": [
        {
          "id": "routes",
          "binary": "{target_dir}/release/examples/refusal_contract_bench",
          "argv": [],
          "outputs": [],
          "stdout": "{output_dir}/rtf-routes-block-{block}-{leg}-{index}.jsonl",
          "stderr": "{output_dir}/rtf-routes-block-{block}-{leg}-{index}.stderr",
          "require_stdout": true
        }
      ]
    },
    "after": {
      "source_root": "$RTF_AFTER_SOURCE",
      "target_dir": "$RTF_TARGET_ROOT/after",
      "allow_dirty": true,
      "lock_paths": ["Cargo.lock"],
      "build": [
        {
          "id": "rtf_refusal_contract",
          "argv": [
            "cargo",
            "build",
            "--release",
            "--manifest-path",
            "Cargo.toml",
            "-p",
            "litchi-rtf",
            "--example",
            "refusal_contract_bench"
          ],
          "artifacts": ["{target_dir}/release/examples/refusal_contract_bench"]
        }
      ],
      "programs": [
        {
          "id": "routes",
          "binary": "{target_dir}/release/examples/refusal_contract_bench",
          "argv": [],
          "outputs": [],
          "stdout": "{output_dir}/rtf-routes-block-{block}-{leg}-{index}.jsonl",
          "stderr": "{output_dir}/rtf-routes-block-{block}-{leg}-{index}.stderr",
          "require_stdout": true
        }
      ]
    }
  }
}
